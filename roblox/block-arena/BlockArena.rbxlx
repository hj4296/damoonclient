})

-- 특수
add("tnt", { name = "TNT", color = rgb(204, 56, 44), hardness = 0.05, tnt = true, tex = { top = "tnt_top", side = "tnt_side", bottom = "tnt_bottom" } })
add("chest", {
	name = "상자",
	color = rgb(158, 110, 52),
	shape = "chest",
	unbreakable = true,
