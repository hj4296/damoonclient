local function ore(rng, color: Color)
	local px = G.stone(rng)
	for _ = 1, 4 do
		local x, y = rng:int(1, N - 3), rng:int(1, N - 3)
		put(px, x, y, color)
		put(px, x + 1, y, mul(color, 0.85))
		put(px, x, y + 1, mul(color, 0.9))
		if rng:next() < 0.6 then
			put(px, x + 1, y + 1, mul(color, 1.1))
		end
	end
	return px
end
