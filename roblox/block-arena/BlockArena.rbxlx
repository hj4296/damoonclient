      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Items</string>
          <string name="Source"><![CDATA[-- 아이템 정의. 블록은 Blocks 에서 자동으로 아이템이 만들어집니다.
local Blocks = require(script.Parent.Blocks)

local Items = {}

export type ItemDef = {
	id: string,
	name: string,
	kind: string, -- block, sword, pickaxe, axe, shears, armor, bow, arrow, food, throwable, currency, menu
	stack: number,
	icon: string,
	color: Color3,
	damage: number?,
	speed: number?, -- 도구 채굴 속도 배율
	tier: number?,
	knockback: number?,
	power: number?,
	punch: number?,
	effect: string?,
	duration: number?,
	liquid: string?,
	deploy: string?,
	enchanted: boolean?,
	armorSlot: string?,
	armorPoints: number?,
	armorTier: string?,
	block: string?,
	projectile: string?,
	action: string?,
	lore: { string }?,
}

local defs: { [string]: ItemDef } = {}
Items.defs = defs

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local TIER = {
	wood = rgb(160, 118, 64),
	stone = rgb(140, 140, 140),
	iron = rgb(226, 226, 230),
	gold = rgb(250, 210, 70),
	diamond = rgb(90, 232, 222),
	leather = rgb(156, 96, 56),
	chain = rgb(160, 162, 172),
}
Items.TierColors = TIER

local function add(id: string, data: { [string]: any })
	data.id = id
	data.stack = data.stack or 1
	data.color = data.color or rgb(200, 200, 200)
	defs[id] = data :: any
end

-- 무기
add("wood_sword", { name = "나무 검", kind = "sword", damage = 4, tier = 1, icon = "sword", color = TIER.wood })
add("stone_sword", { name = "돌 검", kind = "sword", damage = 5, tier = 2, icon = "sword", color = TIER.stone })
add("iron_sword", { name = "철 검", kind = "sword", damage = 6, tier = 3, icon = "sword", color = TIER.iron })
add("diamond_sword", {
	name = "다이아몬드 검",
	kind = "sword",
	damage = 7,
	tier = 4,
	icon = "sword",
	color = TIER.diamond,
})

-- 도구
add("wood_pickaxe", { name = "나무 곡괭이", kind = "pickaxe", speed = 2, damage = 2, tier = 1, icon = "pickaxe", color = TIER.wood })
add("iron_pickaxe", { name = "철 곡괭이", kind = "pickaxe", speed = 4, damage = 3, tier = 2, icon = "pickaxe", color = TIER.iron })
add("diamond_pickaxe", {
	name = "다이아몬드 곡괭이",
	kind = "pickaxe",
	speed = 7,
	damage = 4,
	tier = 3,
	icon = "pickaxe",
	color = TIER.diamond,
})
add("wood_axe", { name = "나무 도끼", kind = "axe", speed = 2, damage = 3, tier = 1, icon = "axe", color = TIER.wood })
add("iron_axe", { name = "철 도끼", kind = "axe", speed = 4, damage = 4, tier = 2, icon = "axe", color = TIER.iron })
add("diamond_axe", { name = "다이아몬드 도끼", kind = "axe", speed = 7, damage = 5, tier = 3, icon = "axe", color = TIER.diamond })
add("shears", { name = "가위", kind = "shears", speed = 5, damage = 1, icon = "shears", color = TIER.iron })

-- 갑옷 (마인크래프트처럼 부위마다 방어 점수가 있고, 점수 1당 피해 4% 감소)
local ARMOR_POINTS = {
	leather = { helmet = 1, chestplate = 3, leggings = 2, boots = 1 },
	chain = { helmet = 2, chestplate = 5, leggings = 4, boots = 1 },
	iron = { helmet = 2, chestplate = 6, leggings = 5, boots = 2 },
	diamond = { helmet = 3, chestplate = 8, leggings = 6, boots = 3 },
}
local ARMOR_NAMES = { leather = "가죽", chain = "사슬", iron = "철", diamond = "다이아몬드" }
local PIECE_NAMES = { helmet = "투구", chestplate = "흉갑", leggings = "레깅스", boots = "부츠" }
Items.ArmorSlots = { "helmet", "chestplate", "leggings", "boots" }
Items.ArmorTiers = { "leather", "chain", "iron", "diamond" }
for tier, points in ARMOR_POINTS do
	for piece, value in points do
		add(tier .. "_" .. piece, {
			name = ARMOR_NAMES[tier] .. " " .. PIECE_NAMES[piece],
			kind = "armor",
			armorSlot = piece,
			armorPoints = value,
			armorTier = tier,
			icon = piece,
			color = TIER[tier],
		})
	end
end

-- 원거리/소모품
add("bow", { name = "활", kind = "bow", icon = "bow", color = TIER.wood, lore = { "꾹 눌렀다 떼면 발사" } })
add("arrow", { name = "화살", kind = "arrow", stack = 64, icon = "arrow", color = TIER.stone })
add("golden_apple", {
	name = "황금 사과",
	kind = "food",
	stack = 64,
	icon = "apple",
	color = TIER.gold,
	lore = { "체력 회복 + 보호막 2칸" },
})
add("pearl", {
	name = "순간이동 진주",
	kind = "throwable",
	projectile = "pearl",
	stack = 16,
	icon = "pearl",
	color = rgb(40, 150, 130),
	lore = { "떨어진 곳으로 순간이동" },
})
add("fireball", {
	name = "화염구",
	kind = "throwable",
	projectile = "fireball",
	stack = 64,
	icon = "fireball",
	color = rgb(255, 120, 30),
	lore = { "부딪히면 폭발" },
})
add("snowball", {
	name = "눈덩이",
	kind = "throwable",
	projectile = "snowball",
	stack = 16,
	icon = "snowball",
	color = rgb(245, 250, 255),
	lore = { "맞은 사람을 밀어냄" },
})

-- 마법이 붙은 무기와 갑옷 (스카이워즈 상자)
add("iron_sword_sharp", { name = "철 검 (날카로움 I)", kind = "sword", damage = 7, tier = 3, icon = "sword", color = TIER.iron:Lerp(rgb(190, 120, 255), 0.25), enchanted = true, lore = { "날카로움 I" } })
add("diamond_sword_sharp", { name = "다이아몬드 검 (날카로움 I)", kind = "sword", damage = 8, tier = 4, icon = "sword", color = TIER.diamond:Lerp(rgb(190, 120, 255), 0.25), enchanted = true, lore = { "날카로움 I" } })
for _, tier in { "iron", "diamond" } do
	for piece, value in ARMOR_POINTS[tier] do
		add(tier .. "_" .. piece .. "_prot", {
			name = ARMOR_NAMES[tier] .. " " .. PIECE_NAMES[piece] .. " (보호 I)",
			kind = "armor",
			armorSlot = piece,
			armorPoints = value + 1,
			armorTier = tier,
			enchanted = true,
			icon = piece,
			color = TIER[tier]:Lerp(rgb(190, 120, 255), 0.25),
			lore = { "보호 I" },
		})
	end
end

-- 특수 무기
add("kb_stick", { name = "넉백 막대기", kind = "stick", damage = 1, knockback = 1.8, icon = "stick", color = rgb(150, 110, 60), enchanted = true, lore = { "밀치기: 맞은 사람을 멀리 날림" } })
add("bow_power", { name = "활 (힘 I)", kind = "bow", power = 1.5, icon = "bow", color = TIER.wood:Lerp(rgb(190, 120, 255), 0.3), enchanted = true, lore = { "화살 피해 1.5배" } })
add("bow_punch", {
	name = "활 (힘 I, 밀치기 I)",
	kind = "bow",
	power = 1.5,
	punch = 2.2,
	icon = "bow",
	color = TIER.wood:Lerp(rgb(190, 120, 255), 0.5),
	enchanted = true,
	lore = { "화살 피해 1.5배", "맞은 사람을 멀리 밀어냄" },
})
add("fishing_rod", { name = "낚싯대", kind = "rod", icon = "rod", color = TIER.wood, lore = { "맞힌 사람을 끌어당김" } })

-- 물약 (마시면 효과)
add("speed_potion", { name = "신속 물약", kind = "potion", effect = "speed", duration = 45, stack = 16, icon = "potion", color = rgb(110, 190, 255), lore = { "45초 동안 빨라짐" } })
add("jump_potion", { name = "도약 물약", kind = "potion", effect = "jump", duration = 45, stack = 16, icon = "potion", color = rgb(110, 240, 110), lore = { "45초 동안 높이 뜀" } })
add("invis_potion", { name = "투명화 물약", kind = "potion", effect = "invis", duration = 30, stack = 16, icon = "potion", color = rgb(190, 190, 215), lore = { "30초 동안 투명 (공격하면 풀림)" } })
add("heal_potion", { name = "치유 물약", kind = "potion", effect = "heal", duration = 0, stack = 16, icon = "potion", color = rgb(250, 70, 90), lore = { "체력 4칸 회복" } })
add("regen_potion", { name = "재생 물약", kind = "potion", effect = "regen", duration = 20, stack = 16, icon = "potion", color = rgb(240, 120, 210), lore = { "20초 동안 체력 회복" } })
add("magic_milk", { name = "마법 우유", kind = "potion", effect = "milk", duration = 30, stack = 16, icon = "potion", color = rgb(245, 245, 240), lore = { "30초 동안 함정에 안 걸림" } })

-- 양동이 (블록 놓듯이 우클릭)
add("water_bucket", { name = "물 양동이", kind = "bucket", liquid = "water_source", icon = "bucket", color = rgb(60, 110, 220), lore = { "물: 떨어져도 안 다치고 TNT 를 막음" } })
add("lava_bucket", { name = "용암 양동이", kind = "bucket", liquid = "lava_flow", icon = "bucket", color = rgb(255, 120, 24), lore = { "닿으면 불에 탐" } })

-- 설치/소환 (블록 놓듯이 우클릭)
add("bridge_egg", { name = "다리 알", kind = "throwable", projectile = "bridge_egg", stack = 16, icon = "egg", color = rgb(236, 226, 196), lore = { "날아간 길에 양털 다리가 생김" } })
add("popup_tower", { name = "팝업 타워", kind = "deploy", deploy = "tower", stack = 16, icon = "tower", color = rgb(200, 60, 50), lore = { "그 자리에 사다리 달린 탑이 세워짐" } })
add("golem_egg", { name = "드림 디펜더", kind = "deploy", deploy = "golem", stack = 16, icon = "golem", color = rgb(214, 214, 204), lore = { "우리 팀을 지키는 철 골렘 (4분)" } })
add("bed_bug", { name = "베드 버그", kind = "throwable", projectile = "bed_bug", stack = 16, icon = "bug", color = rgb(150, 150, 156), lore = { "떨어진 곳에 좀벌레가 나타남 (15초)" } })

-- 자원
add("iron", { name = "철 주괴", kind = "currency", stack = 64, icon = "ingot", color = TIER.iron })
add("gold", { name = "금 주괴", kind = "currency", stack = 64, icon = "ingot", color = TIER.gold })
add("diamond", { name = "다이아몬드", kind = "currency", stack = 64, icon = "gem", color = TIER.diamond })
add("emerald", { name = "에메랄드", kind = "currency", stack = 64, icon = "gem", color = rgb(40, 210, 90) })

-- 메뉴 아이템(로비/대기실)
add("compass", {
	name = "게임 선택",
	kind = "menu",
	action = "games",
	icon = "compass",
	color = rgb(200, 200, 210),
	lore = { "우클릭으로 미니게임 고르기" },
})
add("vote_paper", {
	name = "맵 선택 (VIP)",
	kind = "menu",
	action = "vote",
	icon = "paper",
	color = rgb(240, 240, 230),
	lore = { "우클릭으로 맵 고르기", "VIP 가 없으면 맵은 무작위" },
})
add("kit_selector", {
	name = "키트 고르기",
	kind = "menu",
	action = "kits",
	icon = "kit",
	color = rgb(160, 112, 54),
	lore = { "우클릭으로 키트와 능력 고르기" },
})
add("leave_bed", {
	name = "로비로 돌아가기",
	kind = "menu",
	action = "leave",
	icon = "bed",
	color = rgb(220, 50, 50),
	lore = { "우클릭으로 나가기" },
})

-- 블록 아이템 자동 생성
for id, block in Blocks.defs do
	if not block.noItem then
		add(id, {
			name = block.name,
			kind = "block",
			stack = 64,
			icon = if block.tnt then "tnt" else "block",
			color = block.color,
			block = id,
		})
	end
end

function Items.get(id: string): ItemDef?
	return defs[id]
end

function Items.maxStack(id: string): number
	local def = defs[id]
	return if def then def.stack else 64
end

function Items.isBlock(id: string): boolean
	local def = defs[id]
	return def ~= nil and def.kind == "block"
end

return Items
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Kits</string>
          <string name="Source"><![CDATA[-- 스카이워즈 키트(시작 장비)와 능력(경기 내내 붙는 효과). 대기실에서 고르고, 유리관이 열릴 때 받습니다.
local Kits = {}

export type Kit = {
	id: string,
	name: string,
	icon: string, -- 아이콘으로 보여 줄 아이템 id
	items: { { id: string, count: number } },
	lore: { string },
}

export type Perk = {
	id: string,
	name: string,
	icon: string,
	lore: { string },
}

local function stack(id: string, count: number?)
	return { id = id, count = count or 1 }
end

Kits.List = {
	{
		id = "explorer",
		name = "탐험가",
		icon = "wood_pickaxe",
		items = { stack("wood_pickaxe"), stack("wood_axe"), stack("planks", 16) },
		lore = { "나무 곡괭이, 나무 도끼", "판자 16개" },
	},
	{
		id = "knight",
		name = "기사",
		icon = "stone_sword",
		items = { stack("stone_sword"), stack("chain_chestplate") },
		lore = { "돌 검, 사슬 흉갑" },
	},
	{
		id = "archer",
		name = "궁수",
		icon = "bow",
		items = { stack("bow"), stack("arrow", 10), stack("leather_helmet") },
		lore = { "활, 화살 10개", "가죽 투구" },
	},
	{
		id = "builder",
		name = "건축가",
		icon = "planks",
		items = { stack("planks", 48), stack("stone", 24), stack("wood_axe") },
		lore = { "판자 48개, 돌 24개", "나무 도끼" },
	},
	{
		id = "miner",
		name = "광부",
		icon = "iron_pickaxe",
		items = { stack("iron_pickaxe"), stack("cobble", 32) },
		lore = { "철 곡괭이, 조약돌 32개" },
	},
	{
		id = "healer",
		name = "치유사",
		icon = "regen_potion",
		items = { stack("regen_potion"), stack("heal_potion", 2), stack("golden_apple") },
		lore = { "재생 물약, 치유 물약 2개", "황금 사과" },
	},
	{
		id = "fisher",
		name = "낚시꾼",
		icon = "fishing_rod",
		items = { stack("fishing_rod"), stack("snowball", 8) },
		lore = { "낚싯대, 눈덩이 8개" },
	},
	{
		id = "demolisher",
		name = "폭파병",
		icon = "tnt",
		items = { stack("tnt", 3), stack("fireball", 1) },
		lore = { "TNT 3개, 화염구 1개" },
	},
	{
		id = "lavaman",
		name = "용암술사",
		icon = "lava_bucket",
		items = { stack("lava_bucket"), stack("water_bucket") },
		lore = { "용암 양동이, 물 양동이" },
	},
	{
		id = "jumper",
		name = "점프왕",
		icon = "jump_potion",
		items = { stack("jump_potion", 2), stack("pearl") },
		lore = { "도약 물약 2개", "순간이동 진주" },
	},
} :: { Kit }

Kits.Perks = {
	{ id = "lifesteal", name = "처치 회복", icon = "golden_apple", lore = { "상대를 처치하면", "체력 4칸 회복" } },
	{ id = "arrow_return", name = "화살 회수", icon = "arrow", lore = { "화살을 맞히면 30% 확률로", "화살을 돌려받음" } },
	{ id = "feather", name = "깃털 낙하", icon = "snowball", lore = { "떨어질 때 받는 피해 절반" } },
	{ id = "sturdy", name = "단단한 몸", icon = "iron_chestplate", lore = { "밀려나는 거리 35% 감소" } },
	{ id = "lucky_miner", name = "행운의 곡괭이", icon = "iron_pickaxe", lore = { "블록을 부수면 25% 확률로", "하나 더 얻음" } },
	{ id = "bulwark", name = "보호막", icon = "golden_apple", lore = { "시작할 때와 처치할 때", "보호막 2칸" } },
} :: { Perk }

Kits.DefaultKit = "explorer"
Kits.DefaultPerk = "lifesteal"

local kitIndex: { [string]: Kit } = {}
for _, kit in Kits.List do
	kitIndex[kit.id] = kit
end
local perkIndex: { [string]: Perk } = {}
for _, perk in Kits.Perks do
	perkIndex[perk.id] = perk
end

function Kits.get(id: string?): Kit?
	return if id then kitIndex[id] else nil
end

function Kits.getPerk(id: string?): Perk?
	return if id then perkIndex[id] else nil
end

return Kits
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Preferences</string>
          <string name="Source"><![CDATA[-- 설정 탭 항목 (서버 저장과 클라이언트 적용이 같이 씀)
local Preferences = {}

Preferences.Items = {
	{ key = "camera", name = "시점", choices = { "first", "third" }, labels = { first = "1인칭", third = "3인칭" }, default = "first" },
	{ key = "textures", name = "블록 텍스처", choices = { true, false }, labels = { [true] = "켜기", [false] = "끄기" }, default = true },
	{
		key = "textureDistance",
		name = "텍스처 거리",
		choices = { 1, 2, 3 },
		labels = { [1] = "가까이", [2] = "보통", [3] = "멀리" },
		default = 2,
	},
	{ key = "sounds", name = "효과음", choices = { true, false }, labels = { [true] = "켜기", [false] = "끄기" }, default = true },
	{ key = "nametags", name = "다른 사람 이름표", choices = { true, false }, labels = { [true] = "보기", [false] = "숨기기" }, default = true },
	{ key = "chatFeed", name = "게임 알림 채팅", choices = { true, false }, labels = { [true] = "보기", [false] = "숨기기" }, default = true },
	{ key = "fly", name = "VIP 날기 (로비)", choices = { true, false }, labels = { [true] = "쓰기", [false] = "안 쓰기" }, default = true, vip = true },
}

Preferences.TextureRadius = { [1] = 90, [2] = 130, [3] = 190 }

function Preferences.defaults(): { [string]: any }
	local out = {}
	for _, item in Preferences.Items do
		out[item.key] = item.default
	end
	return out
end

-- 모르는 키나 잘못된 값은 기본값으로
function Preferences.sanitize(input: any): { [string]: any }
	local out = Preferences.defaults()
	if type(input) ~= "table" then
		return out
	end
	for _, item in Preferences.Items do
		local value = input[item.key]
		if table.find(item.choices, value) then
			out[item.key] = value
		end
	end
	return out
end

return Preferences
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Rules</string>
          <string name="Source"><![CDATA[-- 서버와 클라이언트가 같이 쓰는 계산식 (채굴 시간, 공격력, 방어력)
local Blocks = require(script.Parent.Blocks)
local Items = require(script.Parent.Items)

local Rules = {}

Rules.ProtectionPerLevel = 0.06
Rules.MaxReduction = 0.8

function Rules.toolMultiplier(blockId: string, itemId: string?): number
	local block = Blocks.get(blockId)
	if not block or not block.tool or not itemId then
		return 1
	end
	local item = Items.get(itemId)
	if item and item.kind == block.tool then
		return item.speed or 1
	end
	return 1
end

-- 블록을 부수는 데 걸리는 시간(초). 부술 수 없으면 nil.
-- speed 는 효과 배율 (광부의 손 강화 1.25/1.5, 피로 함정 0.3)
function Rules.breakTime(blockId: string, itemId: string?, speed: number?): number?
	local block = Blocks.get(blockId)
	if not block or block.unbreakable then
		return nil
	end
	local mult = Rules.toolMultiplier(blockId, itemId)
	local t = block.hardness / mult
	if block.tool == "pickaxe" and mult == 1 then
		-- 돌 같은 블록은 맨손이면 훨씬 오래 걸림
		t *= 2.5
	end
	return math.max(0.05, t / math.max(0.05, speed or 1))
end

-- 광부의 손 단계와 피로 효과로 정해지는 부수기 속도 배율
function Rules.breakSpeed(haste: number, fatigued: boolean): number
	local speed = 1 + 0.25 * haste
	if fatigued then
		speed *= 0.3
	end
	return speed
end

-- 근접 공격 넉백 배율 (넉백 막대기는 훨씬 멀리)
function Rules.knockbackMultiplier(itemId: string?): number
	local item = if itemId then Items.get(itemId) else nil
	return if item and item.knockback then item.knockback else 1
end

-- 화살 피해: 당긴 정도(0~1)와 활의 힘 마법
function Rules.arrowDamage(charge: number, bowId: string?): number
	local damage = 1 + 5 * charge
	if charge >= 0.99 then
		damage += 1
	end
	local bow = if bowId then Items.get(bowId) else nil
	if bow and bow.power then
		damage *= bow.power
	end
	return damage
end

function Rules.meleeDamage(itemId: string?, sharpness: number): number
	local item = if itemId then Items.get(itemId) else nil
	if not item or not item.damage then
		return 1
	end
	local damage = item.damage
	if item.kind == "sword" then
		damage += sharpness
	end
	return damage
end

function Rules.armorPoints(armor: { [string]: string? }): number
	local total = 0
	for _, slot in Items.ArmorSlots do
		local id = armor[slot]
		local item = if id then Items.get(id) else nil
		if item and item.armorPoints then
			total += item.armorPoints
		end
	end
	return total
end

function Rules.reduction(points: number, protection: number): number
	return math.clamp(points * 0.04 + protection * Rules.ProtectionPerLevel, 0, Rules.MaxReduction)
end

-- 순수 피해 계산: 갑옷/보호 단계/보호막(흡수)을 적용한 결과
function Rules.applyDamage(
	amount: number,
	health: number,
	absorption: number,
	points: number,
	protection: number,
	ignoreArmor: boolean?
): (number, number, number)
	local dealt = amount
	if not ignoreArmor then
		dealt = amount * (1 - Rules.reduction(points, protection))
	end
	local fromAbsorption = math.min(absorption, dealt)
	absorption -= fromAbsorption
	dealt -= fromAbsorption
	health -= dealt
	return health, absorption, dealt + fromAbsorption
end

return Rules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Shop</string>
          <string name="Source"><![CDATA[-- 베드워즈 상점(빠른 구매 포함), 팀 강화, 함정 목록. "$team" 은 구매한 사람의 팀 색으로 바뀝니다.
local Shop = {}

export type Cost = { item: string, amount: number }
export type ShopItem = {
	key: string,
	name: string?,
	give: string?,
	count: number?,
	cost: Cost?,
	icon: string?, -- 아이콘으로 보여 줄 아이템 id
	sword: boolean?,
	armor: string?, -- 영구 갑옷 단계
	tiers: { { give: string, cost: Cost } }?, -- 단계가 오르는 도구
	toolKind: string?,
	permanent: boolean?,
	lore: { string }?,
}

local function cost(item: string, amount: number): Cost
	return { item = item, amount = amount }
end

-- 빠른 구매: 자주 사는 물건을 한 화면에 모아 둔 탭 (다른 탭의 물건을 key 로 가리킴)
Shop.QuickBuy = {
	"wool",
	"stone_sword",
	"chain_armor",
	"pickaxe",
	"bow",
	"speed_potion",
	"tnt",
	"popup_tower",
	"golden_apple",
	"clay",
	"iron_sword",
	"iron_armor",
	"shears",
	"arrows",
	"jump_potion",
	"water_bucket",
	"fireball",
	"pearl",
}

Shop.Categories = {
	{
		id = "quick",
		name = "빠른 구매",
		icon = "compass",
		quick = true,
		items = {},
	},
	{
		id = "blocks",
		name = "블록",
		icon = "wool_$team",
		items = {
			{ key = "wool", give = "wool_$team", count = 16, cost = cost("iron", 4), lore = { "빨리 쌓고 빨리 부서짐" } },
			{ key = "clay", give = "clay_$team", count = 16, cost = cost("iron", 12), lore = { "단단한 방어용 블록" } },
			{ key = "blast_glass", give = "blast_glass", count = 4, cost = cost("iron", 12), lore = { "폭발에 부서지지 않음" } },
			{ key = "hardstone", give = "hardstone", count = 12, cost = cost("iron", 24), lore = { "폭발에 강하고 곡괭이로만 잘 부서짐" } },
			{ key = "ladder", give = "ladder", count = 8, cost = cost("iron", 4), lore = { "벽에 붙여 놓고 타고 올라감" } },
			{ key = "planks", give = "planks", count = 16, cost = cost("gold", 4), lore = { "도끼로 빨리 부서짐" } },
			{ key = "obsidian", give = "obsidian", count = 4, cost = cost("emerald", 4), lore = { "가장 단단한 블록" } },
		},
	},
	{
		id = "melee",
		name = "근접 무기",
		icon = "iron_sword",
		items = {
			{ key = "stone_sword", give = "stone_sword", cost = cost("iron", 10), sword = true },
			{ key = "iron_sword", give = "iron_sword", cost = cost("gold", 7), sword = true },
			{ key = "diamond_sword", give = "diamond_sword", cost = cost("emerald", 4), sword = true },
			{ key = "kb_stick", give = "kb_stick", cost = cost("gold", 5) },
		},
	},
	{
		id = "armor",
		name = "갑옷",
		icon = "iron_chestplate",
		items = {
			{
				key = "chain_armor",
				name = "사슬 갑옷 (영구)",
				armor = "chain",
				icon = "chain_leggings",
				cost = cost("iron", 30),
				lore = { "레깅스와 부츠가 바뀜", "죽어도 유지" },
			},
			{
				key = "iron_armor",
				name = "철 갑옷 (영구)",
				armor = "iron",
				icon = "iron_leggings",
				cost = cost("gold", 12),
				lore = { "레깅스와 부츠가 바뀜", "죽어도 유지" },
			},
			{
				key = "diamond_armor",
				name = "다이아몬드 갑옷 (영구)",
				armor = "diamond",
				icon = "diamond_leggings",
				cost = cost("emerald", 6),
				lore = { "레깅스와 부츠가 바뀜", "죽어도 유지" },
			},
		},
	},
	{
		id = "tools",
		name = "도구",
		icon = "iron_pickaxe",
		items = {
			{ key = "shears", give = "shears", cost = cost("iron", 20), permanent = true, lore = { "양털을 빨리 부숨", "죽어도 유지" } },
			{
				key = "pickaxe",
				name = "곡괭이",
				toolKind = "pickaxe",
				tiers = {
					{ give = "wood_pickaxe", cost = cost("iron", 10) },
					{ give = "iron_pickaxe", cost = cost("gold", 3) },
					{ give = "diamond_pickaxe", cost = cost("gold", 6) },
				},
				lore = { "살 때마다 한 단계 올라감", "죽으면 한 단계 내려감" },
			},
			{
				key = "axe",
				name = "도끼",
				toolKind = "axe",
				tiers = {
					{ give = "wood_axe", cost = cost("iron", 10) },
					{ give = "iron_axe", cost = cost("gold", 3) },
					{ give = "diamond_axe", cost = cost("gold", 6) },
				},
				lore = { "살 때마다 한 단계 올라감", "죽으면 한 단계 내려감" },
			},
		},
	},
	{
		id = "ranged",
		name = "원거리",
		icon = "bow",
		items = {
			{ key = "arrows", give = "arrow", count = 8, cost = cost("gold", 2) },
			{ key = "bow", give = "bow", cost = cost("gold", 12) },
			{ key = "bow_power", give = "bow_power", cost = cost("gold", 20) },
			{ key = "bow_punch", give = "bow_punch", cost = cost("emerald", 6) },
			{ key = "snowball", give = "snowball", count = 4, cost = cost("iron", 16) },
		},
	},
	{
		id = "potions",
		name = "물약",
		icon = "speed_potion",
		items = {
			{ key = "speed_potion", give = "speed_potion", cost = cost("emerald", 1) },
			{ key = "jump_potion", give = "jump_potion", cost = cost("emerald", 1) },
			{ key = "invis_potion", give = "invis_potion", cost = cost("emerald", 2) },
		},
	},
	{
		id = "utility",
		name = "유틸리티",
		icon = "tnt",
		items = {
			{ key = "golden_apple", give = "golden_apple", cost = cost("gold", 3) },
			{ key = "bed_bug", give = "bed_bug", cost = cost("iron", 24) },
			{ key = "golem_egg", give = "golem_egg", cost = cost("iron", 120) },
			{ key = "fireball", give = "fireball", cost = cost("iron", 40) },
			{ key = "tnt", give = "tnt", cost = cost("gold", 4), lore = { "설치하면 3초 뒤 폭발" } },
			{ key = "pearl", give = "pearl", cost = cost("emerald", 4) },
			{ key = "water_bucket", give = "water_bucket", cost = cost("gold", 3) },
			{ key = "bridge_egg", give = "bridge_egg", cost = cost("emerald", 1) },
			{ key = "magic_milk", give = "magic_milk", cost = cost("gold", 4) },
			{ key = "sponge", give = "sponge", count = 4, cost = cost("gold", 3), lore = { "주변의 물을 빨아들임" } },
			{ key = "popup_tower", give = "popup_tower", cost = cost("iron", 24) },
		},
	},
}

-- 다이아몬드로 사는 팀 강화. costs 의 개수가 최대 단계, levels 는 단계별 설명
Shop.Upgrades = {
	{
		key = "sharpness",
		name = "날카로운 검",
		icon = "iron_sword",
		costs = { 4 },
		levels = { "팀 전체의 검 공격력 +1" },
	},
	{
		key = "protection",
		name = "강화 갑옷",
		icon = "iron_chestplate",
		costs = { 2, 4, 8, 16 },
		levels = { "받는 피해 6% 감소", "받는 피해 12% 감소", "받는 피해 18% 감소", "받는 피해 24% 감소" },
	},
	{
		key = "haste",
		name = "광부의 손",
		icon = "iron_pickaxe",
		costs = { 2, 4 },
		levels = { "팀 전체 블록 부수는 속도 +25%", "팀 전체 블록 부수는 속도 +50%" },
	},
	{
		key = "forge",
		name = "강화 용광로",
		icon = "gold",
		costs = { 2, 4, 6, 8 },
		levels = { "철·금 생성 +50%", "철·금 생성 +100%", "섬 생성기에서 에메랄드 생성", "철·금 생성 +200%" },
	},
	{
		key = "healpool",
		name = "치유의 샘",
		icon = "golden_apple",
		costs = { 1 },
		levels = { "기지 근처에서 체력이 빨리 참" },
	},
	{
		key = "dragon",
		name = "용의 가호",
		icon = "fireball",
		costs = { 5 },
		levels = { "서든데스 때 우리 팀 용이 한 마리 더 나옴" },
	},
}

-- 함정: 산 순서대로 줄을 서고, 적이 기지에 들어오면 맨 앞의 함정이 발동합니다.
-- 가격은 줄에 이미 있는 함정 수에 따라 1, 2, 4 다이아몬드
Shop.Traps = {
	{ key = "alarm", name = "경보 함정", icon = "compass", lore = { "들어온 적의 투명화를 풀고", "팀에게 알림" } },
	{ key = "fatigue", name = "피로 함정", icon = "wood_pickaxe", lore = { "들어온 적이 10초 동안", "블록을 아주 느리게 부숨" } },
	{ key = "blind", name = "어둠 함정", icon = "invis_potion", lore = { "들어온 적이 8초 동안", "앞이 안 보이고 느려짐" } },
	{ key = "counter", name = "반격 함정", icon = "speed_potion", lore = { "기지에 있는 우리 팀이 15초 동안", "빨라지고 높이 뜀" } },
}
Shop.TrapCosts = { 1, 2, 4 }
Shop.MaxTraps = 3

local itemIndex: { [string]: ShopItem } = {}
for _, category in Shop.Categories do
	for _, item in category.items do
		itemIndex[item.key] = item :: any
	end
end
-- 빠른 구매 탭은 다른 탭의 물건을 그대로 보여 줌
for _, category in Shop.Categories do
	if category.quick then
		for _, key in Shop.QuickBuy do
			local item = itemIndex[key]
			assert(item, "빠른 구매에 없는 물건: " .. key)
			table.insert(category.items, item)
		end
	end
end
local upgradeIndex = {}
for _, upgrade in Shop.Upgrades do
	upgradeIndex[upgrade.key] = upgrade
end
local trapIndex = {}
for _, trap in Shop.Traps do
	trapIndex[trap.key] = trap
end

function Shop.getItem(key: string): ShopItem?
	return itemIndex[key]
end

function Shop.getUpgrade(key: string)
	return upgradeIndex[key]
end

function Shop.getTrap(key: string)
	return trapIndex[key]
end

function Shop.trapCost(queued: number): number?
	return Shop.TrapCosts[queued + 1]
end

function Shop.resolve(id: string, team: string?): string
	return (string.gsub(id, "%$team", team or "red"))
end

return Shop
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Skins</string>
          <string name="Source"><![CDATA[-- 캐릭터 스킨: 색 6가지 + 머리 모양 + 옷 모양. 문자열 하나로 저장/전송합니다.
-- 스킨 픽셀(머리 8x8x8, 몸 8x12x4, 팔/다리 4x12x4)을 면마다 그려 줍니다. 기본 스킨은 이 게임의 오리지널 디자인입니다.
local Skins = {}

export type Skin = {
	skin: string,
	hair: string,
	eyes: string,
	shirt: string,
	pants: string,
	shoes: string,
	hairStyle: string,
	shirtStyle: string,
}

Skins.Palettes = {
	skin = { "FFE0C8", "F5D0B0", "EBBE96", "D8A57C", "B9825A", "8D5A3C", "63402A", "A8C8A0" },
	hair = { "1E1E1E", "2B1E16", "4A2F1D", "7A4A26", "C68A3A", "E8C870", "D9D9D9", "B03A2E", "3E64C8", "8E44AD" },
	eyes = { "3A5BA0", "3D7A3A", "5A3A22", "222222", "7B4AA8", "1E9AA0", "B03A2E" },
	shirt = { "C83C32", "3C6EC8", "3CA050", "E0B020", "8E44AD", "E67E22", "ECECEC", "2B2B2B", "1ABC9C", "F06292", "8A8F98", "6B4226" },
	pants = { "3C3C46", "2E3F6E", "5A4632", "1E1E1E", "6E6E6E", "2E5E3E", "8B5A2B", "ECECEC", "7A1F1F" },
	shoes = { "2A2A2A", "5A3A22", "ECECEC", "8B1E1E", "2E3F6E", "C68A3A" },
}
Skins.ColorOrder = { "skin", "hair", "eyes", "shirt", "pants", "shoes" }
Skins.ColorNames = { skin = "피부", hair = "머리카락", eyes = "눈", shirt = "옷", pants = "바지", shoes = "신발" }

Skins.HairStyles = { "short", "long", "cap", "bald" }
Skins.HairStyleNames = { short = "짧은 머리", long = "긴 머리", cap = "모자", bald = "민머리" }
Skins.ShirtStyles = { "hoodie", "plain", "stripe", "vest" }
Skins.ShirtStyleNames = { hoodie = "후드", plain = "기본", stripe = "줄무늬", vest = "조끼" }

Skins.Default = {
	skin = "EBBE96",
	hair = "2B1E16",
	eyes = "3A5BA0",
	shirt = "C83C32",
	pants = "3C3C46",
	shoes = "2A2A2A",
	hairStyle = "short",
	shirtStyle = "hoodie",
} :: Skin

Skins.Presets = {
	{ name = "기본", skin = Skins.Default },
	{
		name = "기사",
		skin = { skin = "F5D0B0", hair = "C68A3A", eyes = "3D7A3A", shirt = "8A8F98", pants = "2E3F6E", shoes = "5A3A22", hairStyle = "short", shirtStyle = "vest" },
	},
	{
		name = "해적",
		skin = { skin = "D8A57C", hair = "1E1E1E", eyes = "5A3A22", shirt = "C83C32", pants = "5A4632", shoes = "2A2A2A", hairStyle = "cap", shirtStyle = "stripe" },
	},
	{
		name = "요리사",
		skin = { skin = "F5D0B0", hair = "4A2F1D", eyes = "3A5BA0", shirt = "ECECEC", pants = "1E1E1E", shoes = "2A2A2A", hairStyle = "cap", shirtStyle = "plain" },
	},
	{
		name = "숲 탐험가",
		skin = { skin = "B9825A", hair = "7A4A26", eyes = "3D7A3A", shirt = "3CA050", pants = "5A4632", shoes = "5A3A22", hairStyle = "long", shirtStyle = "vest" },
	},
}

local function contains(list: { string }, value: any): boolean
	return type(value) == "string" and table.find(list, value) ~= nil
end

-- 잘못된 값은 기본값으로 바꿔서 항상 올바른 스킨을 돌려줍니다.
function Skins.sanitize(input: { [string]: any }?): Skin
	local src = input or {}
	local out = {}
	for _, key in Skins.ColorOrder do
		local value = src[key]
		out[key] = if contains(Skins.Palettes[key], value) then value else (Skins.Default :: any)[key]
	end
	out.hairStyle = if contains(Skins.HairStyles, src.hairStyle) then src.hairStyle else Skins.Default.hairStyle
	out.shirtStyle = if contains(Skins.ShirtStyles, src.shirtStyle) then src.shirtStyle else Skins.Default.shirtStyle
	return out :: any
end

function Skins.encode(skin: Skin): string
	local s = Skins.sanitize(skin :: any)
	return table.concat({ "v1", s.skin, s.hair, s.eyes, s.shirt, s.pants, s.shoes, s.hairStyle, s.shirtStyle }, "|")
end

function Skins.decode(text: any): Skin
	if type(text) ~= "string" then
		return Skins.sanitize(nil)
	end
	local p = string.split(text, "|")
	if p[1] ~= "v1" then
		return Skins.sanitize(nil)
	end
	return Skins.sanitize({ skin = p[2], hair = p[3], eyes = p[4], shirt = p[5], pants = p[6], shoes = p[7], hairStyle = p[8], shirtStyle = p[9] })
end

Skins.DefaultCode = Skins.encode(Skins.Default)

function Skins.isDefault(text: string): boolean
	return Skins.encode(Skins.decode(text)) == Skins.DefaultCode
end

function Skins.color(hex: string): Color3
	return Color3.fromHex(hex)
end

----------------------------------------------------------------------------
-- 픽셀 그리기
----------------------------------------------------------------------------

-- 몸 부위 크기 (픽셀). 1픽셀 = 1/6 스터드
Skins.PixelStuds = 1 / 6
Skins.Parts = {
	Head = { 8, 8, 8 },
	Torso = { 8, 12, 4 },
	["Left Arm"] = { 4, 12, 4 },
	["Right Arm"] = { 4, 12, 4 },
	["Left Leg"] = { 4, 12, 4 },
	["Right Leg"] = { 4, 12, 4 },
}

type Pixels = { number }
type RGB = { number }

local function rgb(hex: string): RGB
	local c = Color3.fromHex(hex)
	return { c.R * 255, c.G * 255, c.B * 255 }
end

local function mul(c: RGB, f: number): RGB
	return { c[1] * f, c[2] * f, c[3] * f }
end

local function canvas(w: number, h: number, c: RGB, seed: number): Pixels
	local px = table.create(w * h * 4, 255)
	for y = 0, h - 1 do
		for x = 0, w - 1 do
			local n = ((x * 7349 + y * 1597 + seed * 31) % 97) / 97 -- 0~1 고정된 얼룩
			local f = 0.95 + n * 0.08
			local i = (y * w + x) * 4
			px[i + 1] = math.clamp(math.floor(c[1] * f + 0.5), 0, 255)
			px[i + 2] = math.clamp(math.floor(c[2] * f + 0.5), 0, 255)
			px[i + 3] = math.clamp(math.floor(c[3] * f + 0.5), 0, 255)
		end
	end
	return px
end

local function put(px: Pixels, w: number, x: number, y: number, c: RGB)
	local i = (y * w + x) * 4
	px[i + 1] = math.clamp(math.floor(c[1] + 0.5), 0, 255)
	px[i + 2] = math.clamp(math.floor(c[2] + 0.5), 0, 255)
	px[i + 3] = math.clamp(math.floor(c[3] + 0.5), 0, 255)
	px[i + 4] = 255
end

local function rows(px: Pixels, w: number, y1: number, y2: number, c: RGB)
	for y = y1, y2 do
		for x = 0, w - 1 do
			put(px, w, x, y, mul(c, 0.96 + ((x * 3 + y * 5) % 4) * 0.025))
		end
	end
end

-- 면 크기: Front/Back = 가로 x 세로, Left/Right = 깊이 x 세로, Top/Bottom = 가로 x 깊이
function Skins.faceSize(partName: string, face: string): (number, number)
	local dims = Skins.Parts[partName]
	local w, h, d = dims[1], dims[2], dims[3]
	if face == "Front" or face == "Back" then
		return w, h
	elseif face == "Left" or face == "Right" then
		return d, h
	end
	return w, d
end

local function head(s: Skin, face: string): Pixels
	local w, h = Skins.faceSize("Head", face)
	local skin, hair = rgb(s.skin), rgb(s.hair)
	local hat = mul(rgb(s.shirt), 0.9)
	local style = s.hairStyle
	local px = canvas(w, h, skin, 1)
	if face == "Top" then
		return canvas(w, h, if style == "cap" then hat elseif style == "bald" then skin else hair, 2)
	elseif face == "Bottom" then
		return px
	end
	if style == "cap" then
		rows(px, w, 0, 2, hat)
		if face == "Front" then
			rows(px, w, 3, 3, mul(hat, 0.75))
		end
	end
	if face == "Front" then
		if style == "short" then
			rows(px, w, 0, 1, hair)
			put(px, w, 0, 2, hair)
			put(px, w, 7, 2, hair)
		elseif style == "long" then
			rows(px, w, 0, 1, hair)
			for y = 2, 7 do
				put(px, w, 0, y, hair)
				put(px, w, 7, y, hair)
			end
		end
		local eye = rgb(s.eyes)
		local white = { 245, 245, 245 }
		put(px, w, 1, 4, white)
		put(px, w, 2, 4, eye)
		put(px, w, 5, 4, eye)
		put(px, w, 6, 4, white)
		put(px, w, 3, 5, mul(skin, 0.9))
		put(px, w, 4, 5, mul(skin, 0.9))
		put(px, w, 3, 6, mul(skin, 0.72))
		put(px, w, 4, 6, mul(skin, 0.72))
	elseif face == "Back" then
		local last = if style == "long" then 7 elseif style == "short" then 5 elseif style == "cap" then 4 else -1
		if last >= 0 then
			rows(px, w, if style == "cap" then 3 else 0, last, hair)
		end
	else
		-- 옆면: 뒤쪽 절반에 머리카락, 앞쪽 아래는 귀
		local backOnLeft = face == "Right"
		for y = 0, h - 1 do
			for x = 0, w - 1 do
				local fromBack = if backOnLeft then x else w - 1 - x
				local isHair = false
				if style == "short" then
					isHair = y <= 1 or (y <= 4 and fromBack <= 3)
				elseif style == "long" then
					isHair = y <= 1 or fromBack <= 4
				elseif style == "cap" then
					isHair = y == 3 and fromBack <= 4
				end
				if isHair then
					put(px, w, x, y, mul(hair, 0.96 + ((x + y) % 3) * 0.03))
				end
			end
		end
		local earX = if backOnLeft then 4 else 3
		if style ~= "long" then
			put(px, w, earX, 4, mul(skin, 0.85))
		end
	end
	return px
end

local function torso(s: Skin, face: string): Pixels
	local w, h = Skins.faceSize("Torso", face)
	local shirt, pants, skin = rgb(s.shirt), rgb(s.pants), rgb(s.skin)
	local style = s.shirtStyle
	local px = canvas(w, h, shirt, 3)
	if face == "Top" then
		if style == "vest" or style == "plain" then
			put(px, w, 3, 1, skin)
			put(px, w, 4, 1, skin)
		end
		return px
	elseif face == "Bottom" then
		return canvas(w, h, pants, 4)
	end
	if style == "stripe" then
		for _, y in { 2, 5, 8 } do
			rows(px, w, y, y, mul(shirt, 0.7))
		end
	end
	if face == "Front" then
		if style == "hoodie" then
			for y = 1, 3 do
				put(px, w, 3, y, { 236, 236, 236 })
				put(px, w, 4, y, { 236, 236, 236 })
			end
			for y = 7, 9 do
				for x = 2, 5 do
					put(px, w, x, y, mul(shirt, 0.8))
				end
			end
		elseif style == "vest" then
			for y = 0, 9 do
				put(px, w, 3, y, { 236, 236, 236 })
				put(px, w, 4, y, { 236, 236, 236 })
			end
		elseif style == "plain" then
			put(px, w, 3, 0, skin)
			put(px, w, 4, 0, skin)
		end
	elseif face == "Back" and style == "hoodie" then
		rows(px, w, 0, 2, mul(shirt, 0.82))
	end
	rows(px, w, h - 2, h - 1, pants)
	rows(px, w, h - 2, h - 2, mul(pants, 0.75))
	return px
end

local function arm(s: Skin, face: string): Pixels
	local w, h = Skins.faceSize("Left Arm", face)
	local shirt, skin = rgb(s.shirt), rgb(s.skin)
	local style = s.shirtStyle
	local sleeveEnd = if style == "hoodie" then 10 elseif style == "vest" then -1 else 3
	if face == "Top" then
		return canvas(w, h, if sleeveEnd >= 0 then shirt else skin, 5)
	elseif face == "Bottom" then
		return canvas(w, h, skin, 6)
	end
	local px = canvas(w, h, skin, 7)
	if sleeveEnd >= 0 then
		rows(px, w, 0, sleeveEnd, shirt)
		if style == "stripe" then
			rows(px, w, 2, 2, mul(shirt, 0.7))
		end
	end
	return px
end

local function leg(s: Skin, face: string): Pixels
	local w, h = Skins.faceSize("Left Leg", face)
	local pants, shoes = rgb(s.pants), rgb(s.shoes)
	if face == "Top" then
		return canvas(w, h, pants, 8)
	elseif face == "Bottom" then
		return canvas(w, h, shoes, 9)
	end
	local px = canvas(w, h, pants, 10)
	rows(px, w, h - 2, h - 1, shoes)
	return px
end

-- 몸 부위 한 면의 픽셀
function Skins.face(skin: Skin, partName: string, face: string): (Pixels, number, number)
	local w, h = Skins.faceSize(partName, face)
	local px
	if partName == "Head" then
		px = head(skin, face)
	elseif partName == "Torso" then
		px = torso(skin, face)
	elseif string.find(partName, "Arm") then
		px = arm(skin, face)
	else
		px = leg(skin, face)
	end
	return px, w, h
end

-- 텍스처가 없을 때 쓰는 부위별 대표 색
function Skins.partColor(skin: Skin, partName: string): Color3
	if partName == "Head" then
		return Skins.color(skin.skin)
	elseif partName == "Torso" then
		return Skins.color(skin.shirt)
	elseif string.find(partName, "Arm") then
		return if skin.shirtStyle == "vest" then Skins.color(skin.skin) else Skins.color(skin.shirt)
	end
	return Skins.color(skin.pants)
end

return Skins
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">TextureIds</string>
          <string name="Source"><![CDATA[-- (선택) 직접 올린 텍스처 이미지 ID.
-- 게임은 텍스처를 코드로 직접 그려서 붙이므로 보통은 비워 둬도 됩니다.
-- 만약 텍스처가 안 보이면 textures/ 폴더의 PNG 를 로블록스에 올리고(에셋 관리자 → 일괄 가져오기),
-- 아래처럼 "텍스처 이름" = "rbxassetid://숫자" 로 적어 주세요. 여기 적힌 것이 먼저 쓰입니다.
--
-- 예)
--   grass_top = "rbxassetid://1234567890",
--   grass_side = "rbxassetid://1234567891",
return {}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Textures</string>
          <string name="Source"><![CDATA[-- 블록 픽셀 텍스처 (16x16). 이미지 파일 없이 코드로 직접 그린 이 게임만의 텍스처입니다.
-- Textures.get(이름) 은 {r, g, b, a, r, g, b, a, ...} (0~255, 1024개) 배열을 돌려줍니다.
local Blocks = require(script.Parent.Blocks)
local Util = require(script.Parent.Util)

local Textures = {}

local N = 16
Textures.Size = N

type Color = { number }
type Pixels = { number }

local function clamp8(v: number): number
	return math.clamp(math.floor(v + 0.5), 0, 255)
end

local function c3(color: Color3): Color
	return { color.R * 255, color.G * 255, color.B * 255 }
end

local function mul(c: Color, f: number): Color
	return { c[1] * f, c[2] * f, c[3] * f }
end

local function put(px: Pixels, x: number, y: number, c: Color, a: number?)
	local i = ((y % N) * N + (x % N)) * 4
	px[i + 1] = clamp8(c[1])
	px[i + 2] = clamp8(c[2])
	px[i + 3] = clamp8(c[3])
	px[i + 4] = a or 255
end

local function get(px: Pixels, x: number, y: number): Color
	local i = ((y % N) * N + (x % N)) * 4
	return { px[i + 1], px[i + 2], px[i + 3] }
end

local function alpha(px: Pixels, x: number, y: number, a: number)
	px[((y % N) * N + (x % N)) * 4 + 4] = a
end

-- 기본 색에 픽셀마다 밝기 흔들림을 준 바탕
local function base(c: Color, rng, amount: number): Pixels
	local px = table.create(N * N * 4, 255)
	for y = 0, N - 1 do
		for x = 0, N - 1 do
			local f = 1 + (rng:next() - 0.5) * 2 * amount
			put(px, x, y, mul(c, f))
		end
	end
	return px
end

local function shadeAt(px: Pixels, x: number, y: number, f: number)
	put(px, x, y, mul(get(px, x, y), f))
end

-- 작은 얼룩 여러 개
local function blobs(px: Pixels, rng, count: number, color: Color, minSize: number, maxSize: number)
	for _ = 1, count do
		local cx, cy = rng:int(0, N - 1), rng:int(0, N - 1)
		local size = rng:int(minSize, maxSize)
		for dy = 0, size - 1 do
			for dx = 0, size - 1 do
				if rng:next() < 0.8 then
					put(px, cx + dx, cy + dy, mul(color, 0.92 + rng:next() * 0.16))
				end
			end
		end
	end
end

local function specks(px: Pixels, rng, chance: number, color: Color)
	for y = 0, N - 1 do
		for x = 0, N - 1 do
			if rng:next() < chance then
				put(px, x, y, mul(color, 0.9 + rng:next() * 0.2))
			end
		end
	end
end

-- 바둑판처럼 이어지는 보로노이 조각 (조약돌, 마그마 금)
local function cells(rng, count: number): (number, number) -> (number, boolean)
	local seeds = {}
	for i = 1, count do
		seeds[i] = { rng:next() * N, rng:next() * N }
	end
	local function nearest(x: number, y: number): number
		local best, bestD = 1, math.huge
		for i, s in seeds do
			local dx = math.abs(x + 0.5 - s[1])
			local dy = math.abs(y + 0.5 - s[2])
			dx = math.min(dx, N - dx)
			dy = math.min(dy, N - dy)
			local d = dx * dx + dy * dy
			if d < bestD then
				best, bestD = i, d
			end
		end
		return best
	end
	return function(x: number, y: number): (number, boolean)
		local id = nearest(x, y)
		local edge = nearest(x + 1, y) ~= id or nearest(x, y + 1) ~= id
		return id, edge
	end
end

local function bevel(px: Pixels, light: Color, dark: Color)
	for i = 0, N - 1 do
		put(px, i, 0, light)
		put(px, 0, i, light)
		put(px, i, N - 1, dark)
		put(px, N - 1, i, dark)
	end
end

local function fringe(px: Pixels, rng, color: Color, minDepth: number, maxDepth: number, amount: number)
	for x = 0, N - 1 do
		local depth = rng:int(minDepth, maxDepth)
		for y = 0, depth - 1 do
			put(px, x, y, mul(color, 1 + (rng:next() - 0.5) * 2 * amount))
		end
	end
end

-- 3x5 픽셀 글자
local FONT = {
	T = { "###", ".#.", ".#.", ".#.", ".#." },
	N = { "#..#", "##.#", "#.##", "#..#", "#..#" },
}
local function text(px: Pixels, word: string, x0: number, y0: number, c: Color)
	local x = x0
	for i = 1, #word do
		local glyph = FONT[string.sub(word, i, i)]
		if glyph then
			for row, line in glyph do
				for col = 1, #line do
					if string.sub(line, col, col) == "#" then
						put(px, x + col - 1, y0 + row - 1, c)
					end
				end
			end
			x += #glyph[1] + 1
		end
	end
end

