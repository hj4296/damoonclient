      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Blocks</string>
          <string name="Source"><![CDATA[-- 블록 종류 정의. 색, 재질, 부수는 데 걸리는 시간(초, 맨손 기준), 알맞은 도구를 정합니다.
-- textureId 를 넣으면 블록 여섯 면에 그 이미지를 붙입니다(직접 만든 픽셀 텍스처를 올려 쓰세요).
local Config = require(script.Parent.Config)

local Blocks = {}

export type BlockDef = {
	id: string,
	name: string,
	color: Color3,
	material: Enum.Material,
	hardness: number,
	tool: string?,
	transparency: number?,
	canCollide: boolean?,
	unbreakable: boolean?,
	blastProof: boolean?,
	kill: boolean?,
	light: number?,
	size: Vector3?, -- 블록 단위 크기(기본 1,1,1)
	team: string?,
	bed: boolean?,
	tnt: boolean?,
	chest: boolean?,
	noItem: boolean?, -- 아이템으로 존재하지 않는 블록
	textureId: string?,
}

local defs: { [string]: BlockDef } = {}
Blocks.defs = defs

local M = Enum.Material
local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local function add(id: string, data: { [string]: any })
	data.id = id
	data.hardness = data.hardness or 1
	data.material = data.material or M.SmoothPlastic
	defs[id] = data :: any
end

-- 자연 블록
add("grass", { name = "잔디 블록", color = rgb(95, 159, 53), hardness = 0.6 })
add("dirt", { name = "흙", color = rgb(134, 96, 67), hardness = 0.5 })
add("stone", { name = "돌", color = rgb(128, 128, 128), hardness = 2.2, tool = "pickaxe" })
add("cobble", { name = "조약돌", color = rgb(108, 108, 110), hardness = 2.2, tool = "pickaxe" })
add("stone_bricks", { name = "석재 벽돌", color = rgb(120, 120, 122), hardness = 2.2, tool = "pickaxe" })
add("bricks", { name = "벽돌", color = rgb(150, 76, 60), hardness = 2.2, tool = "pickaxe", material = M.Brick })
add("planks", { name = "나무 판자", color = rgb(168, 135, 84), hardness = 1.4, tool = "axe", material = M.WoodPlanks })
add("dark_planks", { name = "짙은 나무 판자", color = rgb(92, 66, 40), hardness = 1.4, tool = "axe", material = M.WoodPlanks })
add("log", { name = "원목", color = rgb(104, 82, 50), hardness = 1.8, tool = "axe", material = M.Wood })
add("leaves", { name = "나뭇잎", color = rgb(58, 130, 42), hardness = 0.25, tool = "shears" })
add("sakura_leaves", { name = "벚꽃잎", color = rgb(244, 172, 206), hardness = 0.25, tool = "shears" })
add("sand", { name = "모래", color = rgb(222, 210, 160), hardness = 0.5 })
add("sandstone", { name = "사암", color = rgb(214, 196, 140), hardness = 1.2, tool = "pickaxe" })
add("red_sandstone", { name = "붉은 사암", color = rgb(190, 110, 60), hardness = 1.2, tool = "pickaxe" })
add("cactus", { name = "선인장", color = rgb(76, 140, 52), hardness = 0.4 })
add("gravel", { name = "자갈", color = rgb(140, 130, 128), hardness = 0.6 })
add("snow", { name = "눈 블록", color = rgb(242, 248, 252), hardness = 0.3 })
add("ice", { name = "얼음", color = rgb(150, 190, 245), hardness = 0.5, transparency = 0.2, material = M.Ice })
add("packed_ice", { name = "단단한 얼음", color = rgb(125, 165, 230), hardness = 0.8, tool = "pickaxe" })
add("quartz", { name = "석영 블록", color = rgb(236, 230, 222), hardness = 1.6, tool = "pickaxe" })
add("basalt", { name = "현무암", color = rgb(66, 64, 70), hardness = 2.2, tool = "pickaxe" })
add("magma", { name = "마그마 블록", color = rgb(160, 62, 28), hardness = 1, tool = "pickaxe", material = M.CrackedLava })
add("mushroom_red", { name = "붉은 버섯 블록", color = rgb(196, 44, 40), hardness = 0.4, tool = "axe" })
add("mushroom_stem", { name = "버섯 줄기", color = rgb(224, 214, 196), hardness = 0.4, tool = "axe" })
add("hay", { name = "건초 더미", color = rgb(204, 172, 52), hardness = 0.5 })
add("lamp", { name = "조명 블록", color = rgb(255, 222, 140), hardness = 0.5, material = M.Neon, light = 16 })
add("iron_block", { name = "철 블록", color = rgb(218, 218, 222), hardness = 3, tool = "pickaxe", material = M.Metal })
add("gold_block", { name = "금 블록", color = rgb(250, 208, 60), hardness = 3, tool = "pickaxe", material = M.Metal })
add("diamond_block", { name = "다이아몬드 블록", color = rgb(98, 225, 215), hardness = 3, tool = "pickaxe" })
add("emerald_block", { name = "에메랄드 블록", color = rgb(40, 200, 90), hardness = 3, tool = "pickaxe" })

-- 장애물/특수 블록
add("glass", { name = "유리", color = rgb(210, 235, 250), hardness = 0.3, transparency = 0.6, material = M.Glass })
add("blast_glass", {
	name = "방폭 유리",
	color = rgb(185, 215, 240),
	hardness = 0.6,
	transparency = 0.45,
	material = M.Glass,
	blastProof = true,
})
add("cage_glass", {
	name = "출발 유리관",
	color = rgb(200, 230, 255),
	transparency = 0.55,
	material = M.Glass,
	unbreakable = true,
	noItem = true,
})
add("obsidian", { name = "흑요석", color = rgb(34, 24, 48), hardness = 25, tool = "pickaxe", blastProof = true })
add("bedrock", { name = "기반암", color = rgb(52, 52, 56), unbreakable = true, blastProof = true, noItem = true })
add("lava", {
	name = "용암",
	color = rgb(255, 112, 20),
	material = M.Neon,
	transparency = 0.05,
	canCollide = false,
	unbreakable = true,
	blastProof = true,
	kill = true,
	noItem = true,
})
add("water", {
	name = "물",
	color = rgb(55, 110, 220),
	material = M.Glass,
	transparency = 0.45,
	canCollide = false,
	unbreakable = true,
	blastProof = true,
	noItem = true,
})
add("tnt", { name = "TNT", color = rgb(214, 52, 40), hardness = 0.05, tnt = true })
add("chest", {
	name = "상자",
	color = rgb(160, 110, 50),
	material = M.WoodPlanks,
	unbreakable = true,
	blastProof = true,
	chest = true,
	noItem = true,
	size = Vector3.new(0.86, 0.86, 0.86),
})

-- 팀 색 블록(양털, 단단한 점토)과 침대
for _, team in Config.Teams do
	add("wool_" .. team.id, {
		name = team.name .. " 양털",
		color = team.color,
		hardness = 0.7,
		tool = "shears",
		material = M.Fabric,
		team = team.id,
	})
	add("clay_" .. team.id, {
		name = team.name .. " 단단한 점토",
		color = team.color:Lerp(Color3.new(0.35, 0.3, 0.3), 0.35),
		hardness = 1.6,
		tool = "pickaxe",
		team = team.id,
	})
	add("bed_" .. team.id, {
		name = team.name .. " 침대",
		color = team.color,
		hardness = 0.4,
		bed = true,
		team = team.id,
		noItem = true,
		blastProof = true,
		size = Vector3.new(1, 0.56, 1),
	})
end
add("wool_white", { name = "흰 양털", color = rgb(234, 236, 236), hardness = 0.7, tool = "shears", material = M.Fabric })

-- TNT 런 바닥에 쓰는 색 블록
local COLORS: { { string } } = {
	{ "white", "흰색" },
	{ "black", "검은색" },
	{ "red", "빨간색" },
	{ "orange", "주황색" },
	{ "yellow", "노란색" },
	{ "lime", "연두색" },
	{ "cyan", "청록색" },
	{ "blue", "파란색" },
	{ "purple", "보라색" },
	{ "pink", "분홍색" },
}
local COLOR_VALUES: { [string]: Color3 } = {
	white = rgb(232, 234, 235),
	black = rgb(32, 34, 40),
	red = rgb(220, 50, 48),
	orange = rgb(240, 130, 30),
	yellow = rgb(245, 205, 40),
	lime = rgb(120, 205, 40),
	cyan = rgb(30, 160, 170),
	blue = rgb(50, 70, 190),
	purple = rgb(130, 50, 180),
	pink = rgb(235, 130, 170),
}
Blocks.ColorNames = {}
for _, entry in COLORS do
	local id = "color_" .. entry[1]
	add(id, { name = entry[2] .. " 블록", color = COLOR_VALUES[entry[1]], hardness = 0.6 })
	table.insert(Blocks.ColorNames, entry[1])
end

function Blocks.get(id: string): BlockDef?
	return defs[id]
end

function Blocks.exists(id: string): boolean
	return defs[id] ~= nil
end

-- 블록 위치마다 색을 살짝 다르게 해서 픽셀 블록 느낌을 냅니다.
function Blocks.shade(def: BlockDef, x: number, y: number, z: number): Color3
	local h = (x * 73856093 + y * 19349663 + z * 83492791) % 1000
	if h < 0 then
		h += 1000
	end
	local t = h / 1000 -- 0..1
	local color = def.color
	if t < 0.5 then
		return color:Lerp(Color3.new(0, 0, 0), (0.5 - t) * 0.16)
	end
	return color:Lerp(Color3.new(1, 1, 1), (t - 0.5) * 0.12)
end

return Blocks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- 게임 전체 설정. 숫자를 바꾸면 바로 게임 밸런스가 바뀝니다.
local Config = {}

Config.GameName = "블록 아레나"
Config.Version = "1.0.0"

-- 블록 한 칸의 크기(스터드). 캐릭터 키(약 5스터드)와 비교해 마인크래프트 비율에 맞춘 값입니다.
Config.BlockSize = 3

-- 로비와 경기장 위치. 경기장은 동시에 여러 개가 열릴 수 있어서 X축으로 띄워 놓습니다.
Config.LobbyOrigin = Vector3.new(0, 60, 0)
Config.ArenaBase = Vector3.new(2400, 160, 0)
Config.ArenaSpacing = 1200
Config.MaxArenas = 10

Config.DataStoreName = "BlockArena_v1"

Config.Movement = {
	Walk = 16,
	Sprint = 21,
	Sneak = 5,
	JumpHeight = 4.4, -- 1칸은 올라가고 2칸은 못 올라가는 높이
	Gravity = 130,
}

Config.Reach = {
	Attack = 10.5, -- 클라이언트가 공격을 시도하는 거리
	AttackServer = 14, -- 서버가 허용하는 거리(지연 보정 포함)
	Block = 15,
	BlockServer = 20,
}

Config.Combat = {
	HurtTime = 0.45, -- 맞은 뒤 무적 시간
	KnockbackH = 28,
	KnockbackV = 20,
	CritMultiplier = 1.5,
	RegenInterval = 2.5,
	RegenDelay = 4,
	KillCredit = 10, -- 이 시간 안에 때린 사람이 처치 기록을 가져감
	FallSafeBlocks = 3.5,
}

Config.Teams = {
	{ id = "red", name = "빨강", letter = "R", color = Color3.fromRGB(235, 64, 52), hex = "#FF5555" },
	{ id = "blue", name = "파랑", letter = "B", color = Color3.fromRGB(52, 101, 235), hex = "#5577FF" },
	{ id = "green", name = "초록", letter = "G", color = Color3.fromRGB(70, 200, 60), hex = "#55FF55" },
	{ id = "yellow", name = "노랑", letter = "Y", color = Color3.fromRGB(245, 210, 50), hex = "#FFFF55" },
}

Config.Modes = {
	bedwars = {
		id = "bedwars",
		name = "베드워즈",
		icon = "bed",
		color = Color3.fromRGB(235, 64, 52),
		description = "침대를 지키고 상대 침대를 부수세요. 침대가 남아 있으면 다시 살아납니다.",
		minPlayers = 2,
		maxPlayers = 8,
		teamCount = 4,
		teamSize = 2,
	},
	skywars = {
		id = "skywars",
		name = "스카이워즈",
		icon = "sword",
		color = Color3.fromRGB(90, 200, 255),
		description = "하늘섬의 상자에서 장비를 모아 마지막까지 살아남으세요.",
		minPlayers = 2,
		maxPlayers = 8,
	},
	tntrun = {
		id = "tntrun",
		name = "TNT 런",
		icon = "tnt",
		color = Color3.fromRGB(250, 170, 40),
		description = "밟은 블록은 곧 사라집니다. 멈추지 말고 끝까지 버티세요.",
		minPlayers = 2,
		maxPlayers = 12,
	},
}
Config.ModeOrder = { "bedwars", "skywars", "tntrun" }

Config.Waiting = {
	Countdown = 30, -- 최소 인원이 모이면 시작하는 카운트다운
	FullCountdown = 10, -- 꽉 차면 이 값으로 줄어듦
	VoteLock = 4, -- 남은 시간이 이보다 작아지면 투표 마감
	EndDelay = 8, -- 경기가 끝나고 로비로 돌아가기까지
}

-- 스튜디오에서 혼자 테스트할 수 있도록 최소 인원을 1명으로 낮춥니다.
Config.StudioMinPlayers = 1

Config.BedWars = {
	RespawnTime = 5,
	BuildHeight = 18,
	BuildDepth = -12,
	BuildRadius = 70,
	IronInterval = 1.2,
	IronCap = 48,
	GoldInterval = 7,
	GoldCap = 12,
	DiamondIntervals = { 30, 22, 15 },
	DiamondCap = 4,
	EmeraldIntervals = { 60, 45, 30 },
	EmeraldCap = 2,
	Events = {
		{ time = 300, name = "다이아몬드 II", kind = "diamond", tier = 2 },
		{ time = 600, name = "에메랄드 II", kind = "emerald", tier = 2 },
		{ time = 900, name = "다이아몬드 III", kind = "diamond", tier = 3 },
		{ time = 1200, name = "에메랄드 III", kind = "emerald", tier = 3 },
		{ time = 1500, name = "침대 파괴", kind = "beds" },
		{ time = 2100, name = "게임 종료", kind = "end" },
	},
}

Config.SkyWars = {
	CageTime = 10,
	Refills = { 180, 360 },
	TimeLimit = 600,
}

Config.TntRun = {
	StartDelay = 5,
	RemoveDelay = 0.35,
	DoubleJumps = 3,
	DoubleJumpPower = 42,
	TimeLimit = 600,
}

Config.Sounds = {
	Hit = "rbxasset://sounds/swordslash.wav",
	Click = "rbxasset://sounds/electronicpingshort.wav",
	Tick = "rbxasset://sounds/clickfast.wav",
}

return Config
]]></string>
