		"..KK.KBK..",
		".....KBK..",
		"......KBK.",
		"......KBK.",
		".......KHK",
		"........K.",
	},
	shears = {
		".K......K.",
		".KL....LK.",
		"..KM..MK..",
		"...KMMK...",
		"....KK....",
		"...KRRK...",
		"..KR..RK..",
		".KR....RK.",
		".KR....RK.",
		"..K....K..",
	},
	bow = {
		"...KKK..S.",
		"..KBBBK.S.",
		".KBK..KKS.",
		".KB....KS.",
		"KB.....KS.",
		"KB.....KS.",
		".KB....KS.",
