      <string name="Name">SoundService</string>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="58">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">12</float>
      <token name="CameraMode">1</token>
      <float name="CharacterJumpHeight">4.4</float>
      <bool name="CharacterUseJumpPower">false</bool>
      <float name="CharacterWalkSpeed">16</float>
      <bool name="EnableMouseLockOption">false</bool>
      <bool name="LoadCharacterAppearance">false</bool>
    </Properties>
    <Item class="StarterCharacterScripts" referent="59">
      <Properties>
        <string name="Name">StarterCharacterScripts</string>
      </Properties>
      <Item class="LocalScript" referent="60">
        <Properties>
          <string name="Name">Animate</string>
          <string name="Source"><![CDATA[-- 로블록스 기본 걷기 애니메이션 스크립트를 대신합니다(비워 두면 기본 애니메이션이 꺼짐).
-- 마인크래프트처럼 팔다리를 흔드는 움직임은 클라이언트의 CharacterVisuals 모듈이 직접 만듭니다.
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="61">
        <Properties>
          <string name="Name">Health</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- 로블록스 기본 체력 회복 스크립트를 대신합니다(비워 두면 기본 회복이 꺼짐).
-- 회복은 서버의 Combat 모듈이 마인크래프트처럼 처리합니다.
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="StarterPlayerScripts" referent="62">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="63">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">BlockTextures</string>
            <string name="Source"><![CDATA[-- 블록에 픽셀 텍스처 붙이기 (클라이언트)
--  1) TextureIds 에 올린 이미지 ID 가 있으면 그걸 쓰고
--  2) 없으면 Textures 모듈이 그린 픽셀을 EditableImage 로 만들어 씁니다 (업로드 필요 없음)
--  3) 둘 다 안 되면 지금처럼 색 블록으로 보입니다.
-- 카메라 가까운 블록(약 130스터드)에만, 그리고 보이는 면에만 붙여서 가볍게 유지합니다.
local AssetService = game:GetService("AssetService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Blocks = require(Shared:WaitForChild("Blocks"))
local Textures = require(Shared:WaitForChild("Textures"))
local TextureIds = require(Shared:WaitForChild("TextureIds"))

local B = Config.BlockSize
local SCALE = 4 -- 16픽셀을 64픽셀로 키워서 덜 흐리게
local CHUNK = 8 * B
local radius = 130
local BUDGET = 260 -- 한 프레임에 처리할 블록 수

local BlockTextures = {}
BlockTextures.mode = "none"

type Source = { content: any?, id: string? }
local sources: { [string]: Source } = {}

type Chunk = { parts: { [BasePart]: boolean }, active: boolean, center: Vector3 }
local chunks: { [string]: Chunk } = {}
local partChunk: { [BasePart]: Chunk } = {}
local textured: { [BasePart]: boolean } = {}
local queue: { { BasePart | boolean } } = {}

local FACES = {
	{ Enum.NormalId.Right, 1, "side" },
	{ Enum.NormalId.Left, 2, "side" },
	{ Enum.NormalId.Top, 4, "top" },
	{ Enum.NormalId.Bottom, 8, "bottom" },
	{ Enum.NormalId.Back, 16, "side" },
	{ Enum.NormalId.Front, 32, "front" },
}

local function makeImage(name: string): any
	local pixels = Textures.get(name)
	if not pixels then
		return nil
	end
	local size = 16 * SCALE
	local image = AssetService:CreateEditableImage({ Size = Vector2.new(size, size) })
	if not image then
		return nil
	end
	local buf = buffer.create(size * size * 4)
	for y = 0, size - 1 do
		local row = (y // SCALE) * 16
		for x = 0, size - 1 do
			local src = (row + x // SCALE) * 4
			local dst = (y * size + x) * 4
			buffer.writeu8(buf, dst, pixels[src + 1])
			buffer.writeu8(buf, dst + 1, pixels[src + 2])
			buffer.writeu8(buf, dst + 2, pixels[src + 3])
			buffer.writeu8(buf, dst + 3, pixels[src + 4])
		end
	end
	image:WritePixelsBuffer(Vector2.zero, Vector2.new(size, size), buf)
	return Content.fromObject(image)
end

local function loadSources()
	for name, id in TextureIds :: { [string]: string } do
		sources[name] = { id = id }
	end
	local made = 0
	local ok, err = pcall(function()
		for _, name in Textures.names() do
			if not sources[name] then
				local content = makeImage(name)
				if content then
					sources[name] = { content = content }
					made += 1
				end
			end
		end
	end)
	if not ok then
		warn(
			"[블록 아레나] 텍스처를 만들 수 없어 색 블록으로 보입니다. 게임 설정 → 보안 → '메시/이미지 API 허용'을 켜거나 "
				.. "textures 폴더의 PNG 를 올려 TextureIds 에 적어 주세요. 이유: "
				.. tostring(err)
		)
	end
	if made > 0 then
		BlockTextures.mode = "generated"
	elseif next(sources) then
		BlockTextures.mode = "uploaded"
	end
end

local function blockDef(part: BasePart): Blocks.BlockDef?
	local id = part:GetAttribute("BlockId")
	return Blocks.get(if type(id) == "string" then id else part.Name)
end

local function untexture(part: BasePart)
	for _, child in part:GetChildren() do
		if child.Name == "BT" then
			child:Destroy()
		end
	end
	textured[part] = nil
end

local function texture(part: BasePart)
	if not part.Parent then
		return
	end
	untexture(part)
	local def = blockDef(part)
	if not def or def.tex == false then
		return
	end
	local mask = 0
	if def.shape == nil then
		local occ = part:GetAttribute("Occ")
		mask = if type(occ) == "number" then occ else 0
	end
	for _, face in FACES do
		local onlyTop = def.shape == "carpet"
		if bit32.band(mask, face[2]) == 0 and (not onlyTop or face[3] == "top") then
			local name = Blocks.faceTexture(def, face[3])
			local source = if name then sources[name] else nil
			if source then
				local t = Instance.new("Texture")
				t.Name = "BT"
				t.Face = face[1]
				t.StudsPerTileU = B
				t.StudsPerTileV = B
				if source.content then
					t.TextureContent = source.content
				elseif source.id then
					t.Texture = source.id
				end
				t.Parent = part
			end
		end
	end
	textured[part] = true
end

local function chunkFor(position: Vector3): Chunk
	local cx, cy, cz = position.X // CHUNK, position.Y // CHUNK, position.Z // CHUNK
	local k = cx .. "," .. cy .. "," .. cz
	local chunk = chunks[k]
	if not chunk then
		chunk = {
			parts = {},
			active = false,
			center = Vector3.new((cx + 0.5) * CHUNK, (cy + 0.5) * CHUNK, (cz + 0.5) * CHUNK),
		}
		chunks[k] = chunk
	end
	return chunk
end

local function track(part: Instance)
	if not part:IsA("BasePart") or partChunk[part] then
		return
	end
	-- 장식 파트(벽, 기둥 같은 큰 조각)는 수가 적어서 거리와 상관없이 항상 텍스처를 붙임
	if part.Parent and part.Parent.Name == "Decor" then
		texture(part)
		return
	end
	local chunk = chunkFor(part.Position)
	chunk.parts[part] = true
	partChunk[part] = chunk
	if chunk.active then
		table.insert(queue, { part, true })
	end
	part:GetAttributeChangedSignal("Occ"):Connect(function()
		if textured[part] then
			table.insert(queue, { part, true })
		end
	end)
end

local function untrack(part: Instance)
	if not part:IsA("BasePart") then
		return
	end
	local chunk = partChunk[part]
	if chunk then
		chunk.parts[part] = nil
	end
	partChunk[part] = nil
	textured[part] = nil
end

local function watchFolder(folder: Instance)
	for _, child in folder:GetChildren() do
		track(child)
	end
	folder.ChildAdded:Connect(track)
	folder.ChildRemoved:Connect(untrack)
end

local function watchWorld(model: Instance)
	for _, name in { "Blocks", "Decor" } do
		local folder = model:FindFirstChild(name)
		if folder then
			watchFolder(folder)
		else
			task.spawn(function()
				local f = model:WaitForChild(name, 30)
				if f then
					watchFolder(f)
				end
			end)
		end
	end
end

local loaded = false

-- 텍스처 이미지 준비 (핫바 아이콘도 이걸 씀). 여러 번 불러도 한 번만 실행
function BlockTextures.load()
	if not loaded then
		loaded = true
		loadSources()
	end
end

-- 설정: 텍스처 거리 (끄려면 음수)
function BlockTextures.setRadius(r: number)
	radius = r
end

function BlockTextures.source(name: string): Source?
	return sources[name]
end

function BlockTextures.init()
	BlockTextures.load()
	if BlockTextures.mode == "none" then
		return
	end
	for _, model in CollectionService:GetTagged("BlockWorld") do
		watchWorld(model)
	end
	CollectionService:GetInstanceAddedSignal("BlockWorld"):Connect(watchWorld)

	local timer = 0
	RunService.Heartbeat:Connect(function(dt)
		timer += dt
		if timer >= 0.3 then
			timer = 0
			local camera = workspace.CurrentCamera
			local focus = if camera then camera.CFrame.Position else Vector3.zero
			for _, chunk in chunks do
				local distance = (chunk.center - focus).Magnitude
				if not chunk.active and distance < radius then
					chunk.active = true
					for part in chunk.parts do
						table.insert(queue, { part, true })
					end
				elseif chunk.active and distance > radius + 48 then
					chunk.active = false
					for part in chunk.parts do
						table.insert(queue, { part, false })
					end
				end
			end
		end
		local done = 0
		while done < BUDGET and #queue > 0 do
			local item = table.remove(queue) :: { any }
			local part = item[1] :: BasePart
			local chunk = partChunk[part]
			if part.Parent and chunk then
				if item[2] and chunk.active then
					texture(part)
				elseif not item[2] and not chunk.active then
					untexture(part)
				end
			end
			done += 1
		end
	end)
end

return BlockTextures
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">CharacterVisuals</string>
            <string name="Source"><![CDATA[-- 캐릭터 꾸미기 (클라이언트): 픽셀 스킨 입히기, 입은 갑옷 보여 주기, 마인크래프트식 팔다리 흔들기
local AssetService = game:GetService("AssetService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Skins = require(Shared:WaitForChild("Skins"))
local CharacterRig = require(Shared:WaitForChild("CharacterRig"))
local Net = require(script.Parent.Net)

local localPlayer = Players.LocalPlayer

local CharacterVisuals = {}

local SCALE = 4
local FACES = { "Front", "Back", "Left", "Right", "Top", "Bottom" }
local NORMALS = {
	Front = Enum.NormalId.Front,
	Back = Enum.NormalId.Back,
	Left = Enum.NormalId.Left,
	Right = Enum.NormalId.Right,
	Top = Enum.NormalId.Top,
	Bottom = Enum.NormalId.Bottom,
}
local ARMOR_COLORS = {
	leather = Color3.fromRGB(150, 96, 56),
	chain = Color3.fromRGB(150, 154, 166),
	iron = Color3.fromRGB(214, 214, 220),
	diamond = Color3.fromRGB(90, 220, 214),
}

local imageCache: { [string]: any } = {}
local imagesBroken = false
local nametagsVisible = true

type Rig = {
	model: Model,
	root: BasePart,
	motors: { [string]: Motor6D },
	phase: number,
	seed: number,
	swingStart: number?,
	invisible: boolean,
	local_: boolean,
}
local rigs: { [Model]: Rig } = {}

local function pixelKey(px: { number }, w: number, h: number): string
	local hash = 7
	for i = 1, #px do
		hash = (hash * 31 + px[i]) % 2147483647
	end
	return w .. "x" .. h .. ":" .. hash
end

-- 픽셀 배열 -> 텍스처 내용 (같은 그림은 한 번만 만듦)
local function makeImage(px: { number }, w: number, h: number): any
	if imagesBroken then
		return nil
	end
	local key = pixelKey(px, w, h)
	local cached = imageCache[key]
	if cached ~= nil then
		return cached
	end
	local ok, result = pcall(function()
		local iw, ih = w * SCALE, h * SCALE
		local image = AssetService:CreateEditableImage({ Size = Vector2.new(iw, ih) })
		if not image then
			return nil
		end
		local buf = buffer.create(iw * ih * 4)
		for y = 0, ih - 1 do
			local row = (y // SCALE) * w
			for x = 0, iw - 1 do
				local src = (row + x // SCALE) * 4
				local dst = (y * iw + x) * 4
				buffer.writeu8(buf, dst, px[src + 1])
				buffer.writeu8(buf, dst + 1, px[src + 2])
				buffer.writeu8(buf, dst + 2, px[src + 3])
				buffer.writeu8(buf, dst + 3, px[src + 4])
			end
		end
		image:WritePixelsBuffer(Vector2.zero, Vector2.new(iw, ih), buf)
		return Content.fromObject(image)
	end)
	if not ok or result == nil then
		imagesBroken = true
		return nil
	end
	imageCache[key] = result
	return result
end

local function faceStuds(size: Vector3, face: string): (number, number)
	if face == "Front" or face == "Back" then
		return size.X, size.Y
	elseif face == "Left" or face == "Right" then
		return size.Z, size.Y
	end
	return size.X, size.Z
end

local function smallPart(parent: Instance, name: string, size: Vector3, color: Color3, attach: BasePart, offset: CFrame)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CFrame = attach.CFrame * offset
	local weld = Instance.new("Weld")
	weld.Part0 = attach
	weld.Part1 = p
	weld.C0 = offset
	weld.Parent = p
	p.Parent = parent
	return p
end

-- 스킨 입히기: 픽셀 텍스처가 되면 면마다 붙이고, 안 되면 색 + 눈/머리카락 조각으로 대신함
function CharacterVisuals.applySkin(model: Model, code: string)
	local skin = Skins.decode(code)
	local textured = true
	for _, name in CharacterRig.BodyParts do
		local part = model:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			part.Color = Skins.partColor(skin, name)
			for _, child in part:GetChildren() do
				if child.Name == "SK" then
					child:Destroy()
				end
			end
			for _, face in FACES do
				local px, w, h = Skins.face(skin, name, face)
				local content = makeImage(px, w, h)
				if not content then
					textured = false
					break
				end
				local t = Instance.new("Texture")
				t.Name = "SK"
				t.Face = NORMALS[face]
				local u, v = faceStuds(part.Size, face)
				t.StudsPerTileU = u
				t.StudsPerTileV = v
				t.TextureContent = content
				t.Parent = part
			end
		end
	end
	if not textured then
		-- 도중에 실패했으면 붙인 텍스처를 모두 떼고 색 방식으로
		for _, name in CharacterRig.BodyParts do
			local part = model:FindFirstChild(name)
			if part then
				for _, child in part:GetChildren() do
					if child.Name == "SK" then
						child:Destroy()
					end
				end
			end
		end
	end
	local old = model:FindFirstChild("SkinDetail")
	if old then
		old:Destroy()
	end
	local head = model:FindFirstChild("Head")
	if not textured and head and head:IsA("BasePart") then
		-- 텍스처를 못 쓰면 작은 조각으로 눈과 머리카락을 표시
		local folder = Instance.new("Folder")
		folder.Name = "SkinDetail"
		local s = head.Size
		local eye = Skins.color(skin.eyes)
		local white = Color3.fromRGB(245, 245, 245)
		local px = s.X / 8
		for _, e in { { -2.5, white }, { -1.5, eye }, { 1.5, eye }, { 2.5, white } } do
			smallPart(folder, "Eye", Vector3.new(px, px, 0.05), e[2], head, CFrame.new(e[1] * px, -0.5 * px, -s.Z / 2 - 0.02))
		end
		if skin.hairStyle ~= "bald" then
			local hairColor = if skin.hairStyle == "cap" then Skins.color(skin.shirt) else Skins.color(skin.hair)
			smallPart(folder, "Hair", Vector3.new(s.X + 0.06, px * 2 + 0.03, s.Z + 0.06), hairColor, head, CFrame.new(0, s.Y / 2 - px, 0))
			if skin.hairStyle ~= "cap" then
				local length = if skin.hairStyle == "long" then 8 else 5
				smallPart(folder, "HairBack", Vector3.new(s.X + 0.06, px * length, 0.08), hairColor, head, CFrame.new(0, s.Y / 2 - px * length / 2, s.Z / 2 + 0.02))
			end
		end
		folder.Parent = model
	end
end

-- 갑옷 겉모습 (캐릭터 속성 "Armor": "helmet=leather:ff5555;chestplate=iron")
local function overlay(folder: Instance, part: BasePart, fromTop: number, toTop: number, color: Color3, tier: string)
	local s = part.Size
	local height = s.Y * (toTop - fromTop)
	local offsetY = s.Y / 2 - (fromTop + toTop) / 2 * s.Y
	local piece = smallPart(folder, "ArmorPiece", Vector3.new(s.X + 0.14, height + 0.08, s.Z + 0.14), color, part, CFrame.new(0, offsetY, 0))
	if tier == "iron" or tier == "chain" then
		piece.Material = Enum.Material.Metal
	end
	if tier == "chain" then
		piece.Transparency = 0.25
	end
end

function CharacterVisuals.applyArmor(model: Model, key: string)
	local old = model:FindFirstChild("ArmorVisual")
	if old then
		old:Destroy()
	end
	if key == "" then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "ArmorVisual"
	local function bodyPart(name: string): BasePart?
		local p = model:FindFirstChild(name)
		return if p and p:IsA("BasePart") then p else nil
	end
	for entry in string.gmatch(key, "[^;]+") do
		local slot, tier, dye = string.match(entry, "^(%a+)=(%a+):?(%x*)$")
		if slot and tier then
			local color = if dye and #dye == 6 then Color3.fromHex(dye) else (ARMOR_COLORS[tier] or ARMOR_COLORS.iron)
			local function cover(name: string, a: number, b: number)
				local p = bodyPart(name)
				if p then
					overlay(folder, p, a, b, color, tier)
				end
			end
			if slot == "helmet" then
				cover("Head", 0, 0.55)
			elseif slot == "chestplate" then
				cover("Torso", 0, 0.8)
				cover("Left Arm", 0, 0.4)
				cover("Right Arm", 0, 0.4)
			elseif slot == "leggings" then
				cover("Torso", 0.8, 1)
				cover("Left Leg", 0, 0.7)
				cover("Right Leg", 0, 0.7)
			elseif slot == "boots" then
				cover("Left Leg", 0.7, 1)
				cover("Right Leg", 0.7, 1)
			end
		end
	end
	folder.Parent = model
end

local function isInvisible(model: Model): boolean
	local player = Players:GetPlayerFromCharacter(model)
	local ends = player and player:GetAttribute("FX_invis")
	return type(ends) == "number" and ends > workspace:GetServerTimeNow()
end

local function setNametag(model: Model)
	local head = model:FindFirstChild("Head")
	local tag = head and head:FindFirstChild("Nametag")
	if tag and tag:IsA("BillboardGui") then
		tag.Enabled = nametagsVisible and not isInvisible(model)
	end
end

-- 투명화 물약: 다른 사람 눈에는 몸, 갑옷, 손에 든 것, 이름표가 모두 안 보임
local function applyInvisible(model: Model, invisible: boolean)
	local value = if invisible then 1 else 0
	for _, d in model:GetDescendants() do
		if (d:IsA("BasePart") and d.Name ~= "HumanoidRootPart") or d:IsA("Decal") then
			(d :: any).LocalTransparencyModifier = value
		end
	end
	setNametag(model)
end

function CharacterVisuals.setNametagsVisible(visible: boolean)
	nametagsVisible = visible
	for model in rigs do
		if model ~= localPlayer.Character then
			setNametag(model)
		end
	end
end

-- 공격/설치할 때 오른팔 휘두르기
function CharacterVisuals.swing(player: Player)
	local model = player.Character
	local rig = if model then rigs[model] else nil
	if rig then
		rig.swingStart = os.clock()
	end
end

local function setup(player: Player, model: Model)
	local root = model:WaitForChild("HumanoidRootPart", 10)
	local torso = model:WaitForChild("Torso", 10)
	if not root or not torso or not root:IsA("BasePart") then
		return
	end
	local motors = {}
	for _, name in { "Right Shoulder", "Left Shoulder", "Right Hip", "Left Hip", "Neck" } do
		local m = torso:WaitForChild(name, 5)
		if m and m:IsA("Motor6D") then
			motors[name] = m
		end
	end
	rigs[model] = { model = model, root = root, motors = motors, phase = 0, seed = player.UserId % 100, invisible = false, local_ = player == localPlayer }
	model.Destroying:Connect(function()
		rigs[model] = nil
	end)

	for _, name in CharacterRig.BodyParts do
		model:WaitForChild(name, 5)
	end
	local function skin()
		local code = player:GetAttribute("Skin")
		CharacterVisuals.applySkin(model, if type(code) == "string" then code else Skins.DefaultCode)
	end
	local function armor()
		local key = model:GetAttribute("Armor")
		CharacterVisuals.applyArmor(model, if type(key) == "string" then key else "")
	end
	skin()
	armor()
	local skinConn = player:GetAttributeChangedSignal("Skin"):Connect(skin)
	model.AncestryChanged:Connect(function()
		if not model.Parent then
			skinConn:Disconnect()
		end
	end)
	model:GetAttributeChangedSignal("Armor"):Connect(armor)
	-- 이름표는 서버가 조금 늦게 붙일 수 있어서 몇 번 확인
	if player ~= localPlayer then
		task.delay(1, function()
			setNametag(model)
		end)
		task.delay(3, function()
			setNametag(model)
		end)
	end
end

local function watchPlayer(player: Player)
	if player.Character then
		task.spawn(setup, player, player.Character)
	end
	player.CharacterAdded:Connect(function(model)
		setup(player, model)
	end)
end

function CharacterVisuals.init()
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end
	Players.PlayerAdded:Connect(watchPlayer)

	Net.on("swing", function(player)
		if typeof(player) == "Instance" and player:IsA("Player") and player ~= localPlayer then
			CharacterVisuals.swing(player)
		end
	end)

	-- 투명화 확인 (0.25초마다, 새로 붙은 갑옷도 다시 숨김)
	local invisTimer = 0
	RunService.Heartbeat:Connect(function(dt)
		invisTimer += dt
		if invisTimer < 0.25 then
			return
		end
		invisTimer = 0
		for model, rig in rigs do
			if model.Parent and not rig.local_ then
				local invisible = isInvisible(model)
				if invisible or invisible ~= rig.invisible then
					rig.invisible = invisible
					applyInvisible(model, invisible)
				end
			end
		end
	end)

	-- 마인크래프트처럼 걸을 때 팔다리를 앞뒤로 흔듦
	RunService.Stepped:Connect(function(_, dt)
		local now = os.clock()
		for model, rig in rigs do
			if not model.Parent or not rig.root.Parent then
				continue
			end
			local v = rig.root.AssemblyLinearVelocity
			local speed = Vector3.new(v.X, 0, v.Z).Magnitude
			local amount = math.clamp(speed / 16, 0, 1)
			rig.phase += dt * (5 + speed * 0.35)
			local swing = math.sin(rig.phase) * 0.85 * amount
			local idle = math.sin(now * 1.7 + rig.seed) * 0.05
			local attack = 0
			if rig.swingStart then
				local t = (now - rig.swingStart) / 0.3
				if t < 1 then
					attack = math.sin(t * math.pi) * 1.4
				else
					rig.swingStart = nil
				end
			end
			local flying = model:GetAttribute("Flying") == true
			local m = rig.motors
			if flying then
				swing = math.sin(now * 3 + rig.seed) * 0.12
			end
			if m["Right Shoulder"] then
				m["Right Shoulder"].Transform = CFrame.Angles(swing + attack, 0, idle * 0.5)
			end
			if m["Left Shoulder"] then
				m["Left Shoulder"].Transform = CFrame.Angles(-swing, 0, -idle * 0.5)
			end
			if m["Right Hip"] then
				m["Right Hip"].Transform = CFrame.Angles(if flying then 0.15 else -swing, 0, 0)
			end
			if m["Left Hip"] then
				m["Left Hip"].Transform = CFrame.Angles(if flying then 0.15 else swing, 0, 0)
			end
		end
	end)
end

return CharacterVisuals
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">Controls</string>
            <string name="Source"><![CDATA[-- 조작: 조준(블록/사람/몹), 왼쪽 클릭 공격·부수기, 오른쪽 클릭 설치·사용(물약/양동이/낚싯대), 숫자키 핫바, 단축키, 모바일 버튼
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Items = require(Shared:WaitForChild("Items"))
local Rules = require(Shared:WaitForChild("Rules"))
local Net = require(script.Parent.Net)
local State = require(script.Parent.State)
local Hud = require(script.Parent.UI.Hud)
local Windows = require(script.Parent.UI.Windows)
local Theme = require(script.Parent.UI.Theme)
local CharacterVisuals = require(script.Parent.CharacterVisuals)

local player = Players.LocalPlayer

local Controls = {}
Controls.onCameraChanged = function(_thirdPerson: boolean) end

local thirdPerson = false
local attackHeld = false
local useHeld = false
local lastAttack = 0
local lastPlace = 0
local bowStart: number? = nil
local leaveArmed = 0
local breaking: { key: string, progress: number }? = nil
local breakCooldown = 0
local selection: SelectionBox

export type Target = {
	kind: string,
	player: Player?,
	mobId: number?,
	part: BasePart?,
	cell: { number }?,
	place: { number }?,
	normal: { number }?,
}
local target: Target? = nil

local function character(): (Model?, BasePart?)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return char, root
	end
	return nil, nil
end

local function blockInfo(part: BasePart): (BasePart?, number, number, number)
	local block = part
	local parent = block.Parent
	if parent and parent:IsA("BasePart") then
		block = parent
	end
	local folder = block.Parent
	local model = folder and folder.Parent
	if not folder or folder.Name ~= "Blocks" or not model or not model:HasTag("BlockWorld") then
		return nil, 0, 0, 0
	end
	local origin = model:GetAttribute("Origin")
	local size = model:GetAttribute("BlockSize") or Config.BlockSize
	if typeof(origin) ~= "Vector3" then
		return nil, 0, 0, 0
	end
	local rel = (block.Position - origin) / size
	return block, math.round(rel.X), math.round(rel.Y), math.round(rel.Z)
end

local function playerFromPart(part: BasePart): Player?
	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		if model:FindFirstChildOfClass("Humanoid") then
			return Players:GetPlayerFromCharacter(model)
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil
end

-- 물/용암처럼 통과하는 블록은 조준할 때 건너뜀 (그 너머 블록에 놓거나 부술 수 있게)
local FLUIDS = { water = true, water_source = true, lava = true, lava_flow = true }

local function mobFromPart(part: BasePart): number?
	local id = part:GetAttribute("MobId")
	return if type(id) == "number" then id else nil
end

local function aimRay(): Ray
	local camera = workspace.CurrentCamera
	local size = camera.ViewportSize
	return camera:ViewportPointToRay(size.X / 2, size.Y / 2)
end

local function updateTarget()
	target = nil
	local char, root = character()
	if not char or not root then
		return
	end
	local ray = aimRay()
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude: { Instance } = { char }
	local projectiles = workspace:FindFirstChild("Projectiles")
	if projectiles then
		table.insert(exclude, projectiles)
	end
	params.FilterDescendantsInstances = exclude
	local result = workspace:Raycast(ray.Origin, ray.Direction * 60, params)
	for _ = 1, 4 do
		if result and (FLUIDS[result.Instance.Name] or FLUIDS[result.Instance:GetAttribute("BlockId") or ""]) then
			params:AddToFilter(result.Instance)
			result = workspace:Raycast(ray.Origin, ray.Direction * 60, params)
		else
			break
		end
	end
	if not result then
		return
	end
	local head = root.Position + Vector3.new(0, 1.5, 0)
	local mobId = mobFromPart(result.Instance)
	if mobId then
		local reach = Config.Reach.Attack + (if result.Instance.Parent and result.Instance.Parent:GetAttribute("MobKind") == "dragon" then 5 else 1)
		if (result.Position - head).Magnitude <= reach then
			target = { kind = "mob", mobId = mobId }
		end
		return
	end
	local other = playerFromPart(result.Instance)
	if other and other ~= player then
		local otherRoot = other.Character and other.Character:FindFirstChild("HumanoidRootPart")
		if otherRoot and otherRoot:IsA("BasePart") and (otherRoot.Position - root.Position).Magnitude <= Config.Reach.Attack then
			target = { kind = "player", player = other }
		end
		return
	end
	if (result.Position - head).Magnitude > Config.Reach.Block then
		return
	end
	local block, x, y, z = blockInfo(result.Instance)
	if not block then
		return
	end
	local n = result.Normal
	target = {
		kind = "block",
		part = block,
		cell = { x, y, z },
		place = { x + math.round(n.X), y + math.round(n.Y), z + math.round(n.Z) },
		normal = { math.round(n.X), math.round(n.Y), math.round(n.Z) },
	}
end

local function selectSlot(index: number)
	if index < 1 or index > 9 or index == State.selected then
		return
	end
	State.selected = index
	State.emit("inv")
	Hud.showItemName()
	Net.send("select", index)
	breaking = nil
	bowStart = nil
end

local function selectedDef()
	local stack = State.selectedStack()
	return if stack then Items.get(stack.id) else nil
end

local function canAct(): boolean
	return not Windows.isOpen()
end

local function tryAttack()
	if target and target.kind == "player" and target.player and State.context.pvp then
		lastAttack = os.clock()
		CharacterVisuals.swing(player)
		Net.send("attack", target.player)
		return true
	elseif target and target.kind == "mob" and target.mobId and State.context.pvp then
		lastAttack = os.clock()
		CharacterVisuals.swing(player)
		Net.send("attackMob", target.mobId)
		return true
	end
	return false
end

-- 블록처럼 조준한 칸에 놓는 아이템 (블록, 양동이, 팝업 타워, 골렘 알)
local PLACEABLE = { block = true, bucket = true, deploy = true }

local function tryPlace()
	local def = selectedDef()
	if not def or not PLACEABLE[def.kind] or not State.context.build then
		return false
	end
	if target and target.kind == "block" and target.place then
		local p = target.place
		local n = target.normal or { 0, 1, 0 }
		CharacterVisuals.swing(player)
		Net.send("place", p[1], p[2], p[3], n[1], n[2], n[3])
		lastPlace = os.clock()
		return true
	end
	return false
end

-- 광부의 손 강화와 피로 함정을 반영한 부수기 속도
local function breakSpeed(): number
	local haste = player:GetAttribute("Haste")
	local fatigue = player:GetAttribute("FX_fatigue")
	local fatigued = type(fatigue) == "number" and fatigue > workspace:GetServerTimeNow()
	return Rules.breakSpeed(if type(haste) == "number" then haste else 0, fatigued)
end

local function useStart()
	local def = selectedDef()
	if not def then
		return
	end
	if PLACEABLE[def.kind] then
		tryPlace()
	elseif def.kind == "bow" then
		bowStart = os.clock()
	elseif def.kind == "menu" or def.kind == "food" or def.kind == "armor" or def.kind == "throwable" or def.kind == "potion" or def.kind == "rod" then
		if def.kind == "rod" or def.kind == "throwable" then
			CharacterVisuals.swing(player)
		end
		Net.send("use", workspace.CurrentCamera.CFrame.LookVector)
	end
end

local function useEnd()
	if bowStart then
		local charge = math.clamp((os.clock() - bowStart) / 1, 0.1, 1)
		bowStart = nil
		Hud.actionbar("", nil)
		Net.send("use", workspace.CurrentCamera.CFrame.LookVector, charge)
	end
end

local function toggleInventory()
	if Windows.isOpen() then
		Windows.close()
	elseif State.context.location == "match" then
		Windows.openInventory()
	end
end

local function toggleCamera()
	thirdPerson = not thirdPerson
	if thirdPerson then
		player.CameraMode = Enum.CameraMode.Classic
		player.CameraMinZoomDistance = 12
		player.CameraMaxZoomDistance = 12
	else
		player.CameraMinZoomDistance = 0.5
		player.CameraMaxZoomDistance = 0.5
		player.CameraMode = Enum.CameraMode.LockFirstPerson
	end
	Controls.onCameraChanged(thirdPerson)
end

function Controls.setThirdPerson(third: boolean)
	if third ~= thirdPerson then
		toggleCamera()
	end
end

local function leave()
	if State.context.location == "lobby" then
		return
	end
	if os.clock() - leaveArmed < 2.5 then
		Net.send("leave")
		leaveArmed = 0
		Hud.actionbar("", nil)
	else
		leaveArmed = os.clock()
		Hud.actionbar('<font color="#FFFF55">한 번 더 누르면 로비로 돌아갑니다</font>', 2.5)
	end
end

local KEY_SLOTS = {
	[Enum.KeyCode.One] = 1,
	[Enum.KeyCode.Two] = 2,
	[Enum.KeyCode.Three] = 3,
	[Enum.KeyCode.Four] = 4,
	[Enum.KeyCode.Five] = 5,
	[Enum.KeyCode.Six] = 6,
	[Enum.KeyCode.Seven] = 7,
	[Enum.KeyCode.Eight] = 8,
	[Enum.KeyCode.Nine] = 9,
}

local function mobileButtons(gui: ScreenGui)
	local holder = Theme.create("Frame", {
		Name = "MobileButtons",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -10, 1, -170),
		Size = UDim2.fromOffset(150, 240),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	local function button(text: string, x: number, y: number, onDown: () -> (), onUp: (() -> ())?)
		local b = Theme.button(text, {
			Position = UDim2.fromOffset(x, y),
			Size = UDim2.fromOffset(68, 50),
			Parent = holder,
		})
		b.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				onDown()
			end
		end)
		b.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch and onUp then
				onUp()
			end
		end)
	end
	button("공격", 0, 0, function()
		attackHeld = true
		tryAttack()
	end, function()
		attackHeld = false
	end)
	button("놓기", 76, 0, function()
		useHeld = true
		useStart()
	end, function()
		useHeld = false
		useEnd()
	end)
	button("가방", 0, 58, toggleInventory)
	button("시점", 76, 58, toggleCamera)
	button("웅크림", 0, 116, function()
		player:SetAttribute("SneakToggle", not player:GetAttribute("SneakToggle"))
	end)
	button("로비", 76, 116, leave)
	button("버리기", 0, 174, function()
		Net.send("drop")
	end)
end

function Controls.init()
	selection = Instance.new("SelectionBox")
	selection.Name = "BlockOutline"
	selection.Color3 = Color3.new(0, 0, 0)
	selection.LineThickness = 0.025
	selection.SurfaceColor3 = Color3.new(0, 0, 0)
	selection.SurfaceTransparency = 1
	selection.Transparency = 0.3
	selection.Parent = workspace.CurrentCamera

	Hud.onSlotClicked = selectSlot

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		local key = input.KeyCode
		local slot = KEY_SLOTS[key]
		if slot then
			selectSlot(slot)
			return
		end
		if key == Enum.KeyCode.E then
			toggleInventory()
		elseif key == Enum.KeyCode.V then
			toggleCamera()
		elseif key == Enum.KeyCode.L then
			leave()
		elseif key == Enum.KeyCode.Q and canAct() then
			Net.send("drop")
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 and canAct() then
			attackHeld = true
			tryAttack()
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 and canAct() then
			useHeld = true
			useStart()
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			attackHeld = false
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			useHeld = false
			useEnd()
		end
	end)
	UserInputService.InputChanged:Connect(function(input, processed)
		if processed or Windows.isOpen() then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseWheel and not thirdPerson then
			local nextSlot = State.selected - math.sign(input.Position.Z)
			if nextSlot < 1 then
				nextSlot = 9
			elseif nextSlot > 9 then
				nextSlot = 1
			end
			selectSlot(nextSlot)
		end
	end)

	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		mobileButtons(Hud.gui())
	end

	Windows.onChanged = function(open)
		if open then
			attackHeld = false
			useHeld = false
			bowStart = nil
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
	end

	toggleCamera() -- 1인칭 -> 3인칭 -> 1인칭 상태로 맞추기 위해 두 번
	toggleCamera()

	RunService.RenderStepped:Connect(function(dt)
		if thirdPerson and not Windows.isOpen() and UserInputService.KeyboardEnabled then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		end
		if Windows.isOpen() then
			target = nil
		else
			updateTarget()
		end
		Hud.setCrosshairVisible(not Windows.isOpen())

		local now = os.clock()
		-- 꾹 누르고 있으면 반복 동작 (모바일 공격, 블록 연속 설치)
		if attackHeld and target and (target.kind == "player" or target.kind == "mob") and now - lastAttack > 0.18 and not UserInputService.KeyboardEnabled then
			tryAttack()
		end
		if useHeld and now - lastPlace > 0.22 then
			local def = selectedDef()
			if def and def.kind == "block" then
				tryPlace()
			end
		end
		if bowStart then
			local charge = math.clamp((now - bowStart) / 1, 0, 1)
			local bars = math.floor(charge * 10 + 0.5)
			Hud.actionbar(string.rep("■", bars) .. '<font color="#555555">' .. string.rep("■", 10 - bars) .. "</font>", nil)
		end

		-- 블록 부수기 진행
		breakCooldown -= dt
		local outlined: BasePart? = nil
		if target and target.kind == "block" and target.part then
			outlined = target.part
		end
		if attackHeld and target and target.kind == "block" and State.context.build and breakCooldown <= 0 and target.cell and target.part then
			local c = target.cell
			local key = c[1] .. "," .. c[2] .. "," .. c[3]
			if not breaking or breaking.key ~= key then
				breaking = { key = key, progress = 0 }
				Net.send("breakStart", c[1], c[2], c[3])
			end
			local stack = State.selectedStack()
			local need = Rules.breakTime(target.part.Name, if stack then stack.id else nil, breakSpeed())
			if need and breaking then
				breaking.progress += dt / need
				if breaking.progress >= 1 then
					Net.send("break", c[1], c[2], c[3])
					breaking = nil
					breakCooldown = 0.12
				end
			end
		elseif not attackHeld then
			breaking = nil
		end
		selection.Adornee = outlined
		selection.SurfaceTransparency = if breaking then 1 - math.clamp(breaking.progress, 0, 1) * 0.65 else 1
	end)
end

return Controls
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[-- 꾸밈 효과: 생성기 블록 회전, 효과음
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(script.Parent.Net)

local Effects = {}
Effects.enabled = true

-- 효과음 이름 -> (소리, 속도)
local SOUNDS: { [string]: { string | number } } = {
	tick = { Config.Sounds.Tick, 1 },
	start = { Config.Sounds.Click, 1.2 },
	buy = { Config.Sounds.Click, 1.5 },
	deny = { Config.Sounds.Tick, 0.6 },
	pickup = { Config.Sounds.Click, 2 },
	bed = { Config.Sounds.Hit, 0.5 },
	eat = { Config.Sounds.Tick, 0.8 },
	equip = { Config.Sounds.Click, 0.9 },
	arrowHit = { Config.Sounds.Click, 1.8 },
}

local pool: { [string]: Sound } = {}

function Effects.play(name: string)
	local entry = SOUNDS[name]
	if not entry or not Effects.enabled then
		return
	end
	local sound = pool[name]
	if not sound then
		local s = Instance.new("Sound")
		s.Name = "UI_" .. name
		s.SoundId = entry[1] :: string
		s.PlaybackSpeed = entry[2] :: number
		s.Volume = 0.45
		s.Parent = SoundService
		pool[name] = s
		sound = s
	end
	SoundService:PlayLocalSound(sound)
end

function Effects.init()
	Net.on("sound", Effects.play)
	local angle = 0
	RunService.RenderStepped:Connect(function(dt)
		angle += dt * 1.6
		for _, part in CollectionService:GetTagged("Spin") do
			if part:IsA("BasePart") then
				local base = part:GetAttribute("SpinBase")
				if typeof(base) ~= "Vector3" then
					base = part.Position
					part:SetAttribute("SpinBase", base)
				end
				local bob = math.sin(angle * 1.5) * 0.25
				part.CFrame = CFrame.new((base :: Vector3) + Vector3.new(0, bob, 0)) * CFrame.Angles(0, angle, 0) * CFrame.Angles(math.rad(30), 0, math.rad(30))
			end
		end
	end)
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">Flight</string>
            <string name="Source"><![CDATA[-- VIP 로비 날기: 스페이스를 빠르게 두 번 누르면 날기 켜기/끄기.
-- 날 때: WASD 로 이동, 스페이스로 위, Shift(또는 Ctrl)로 아래. 모바일은 설정 탭의 날기 버튼과 점프 버튼.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(script.Parent.Net)
local State = require(script.Parent.State)

local player = Players.LocalPlayer

local Flight = {}

local flying = false
local lastSpace = 0
local attachment: Attachment? = nil
local velocity: LinearVelocity? = nil
local align: AlignOrientation? = nil
local controls: any = nil

Flight.onChanged = function(_flying: boolean) end

local function parts(): (Humanoid?, BasePart?)
	local char = player.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if humanoid and root and root:IsA("BasePart") then
		return humanoid, root
	end
	return nil, nil
end

function Flight.allowed(): boolean
	return player:GetAttribute("VIP") == true and State.context.location == "lobby" and State.settings.fly ~= false
end

function Flight.isFlying(): boolean
	return flying
end

function Flight.stop()
	if not flying then
		return
	end
	flying = false
	for _, thing in { velocity, align, attachment } do
		if thing then
			thing:Destroy()
		end
	end
	velocity, align, attachment = nil, nil, nil
	local humanoid = parts()
	if humanoid then
		humanoid.PlatformStand = false
	end
	Net.send("flying", false)
	Flight.onChanged(false)
end

function Flight.start()
	if flying or not Flight.allowed() then
		return
	end
	local humanoid, root = parts()
	if not humanoid or not root or humanoid.Health <= 0 then
		return
	end
	flying = true
	local a = Instance.new("Attachment")
	a.Name = "FlyAttachment"
	a.Parent = root
	local v = Instance.new("LinearVelocity")
	v.Name = "FlyVelocity"
	v.Attachment0 = a
	v.MaxForce = 1e7
	v.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	v.RelativeTo = Enum.ActuatorRelativeTo.World
	v.VectorVelocity = Vector3.zero
	v.Parent = root
	local o = Instance.new("AlignOrientation")
	o.Name = "FlyAlign"
	o.Mode = Enum.OrientationAlignmentMode.OneAttachment
	o.Attachment0 = a
	o.MaxTorque = 1e7
	o.Responsiveness = 30
	o.CFrame = CFrame.Angles(0, select(2, root.CFrame:ToEulerAnglesYXZ()), 0)
	o.Parent = root
	attachment, velocity, align = a, v, o
	humanoid.PlatformStand = true
	Net.send("flying", true)
	Flight.onChanged(true)
end

function Flight.toggle()
	if flying then
		Flight.stop()
	else
		Flight.start()
	end
end

-- 카메라 기준 이동 방향 (키보드, 패드, 모바일 조이스틱 모두)
local function moveDirection(humanoid: Humanoid): Vector3
	if controls == nil then
		local ok, result = pcall(function()
			local module = player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 5)
			return if module then (require(module :: any) :: any):GetControls() else false
		end)
		controls = if ok and result then result else false
	end
	if controls then
		local ok, mv = pcall(function()
			return controls:GetMoveVector()
		end)
		if ok and typeof(mv) == "Vector3" and mv.Magnitude > 0.01 then
			local cam = workspace.CurrentCamera.CFrame
			local look = Vector3.new(cam.LookVector.X, 0, cam.LookVector.Z)
			local right = Vector3.new(cam.RightVector.X, 0, cam.RightVector.Z)
			if look.Magnitude > 0.01 then
				look = look.Unit
			end
			if right.Magnitude > 0.01 then
				right = right.Unit
			end
			local dir = right * mv.X - look * mv.Z
			return if dir.Magnitude > 1 then dir.Unit else dir
		end
	end
	return humanoid.MoveDirection
end

function Flight.init()
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or input.KeyCode ~= Enum.KeyCode.Space then
			return
		end
		local now = os.clock()
		if now - lastSpace < 0.32 then
			lastSpace = 0
			if Flight.allowed() or flying then
				Flight.toggle()
			end
		else
			lastSpace = now
		end
	end)

	player.CharacterAdded:Connect(function()
		flying = false
		velocity, align, attachment = nil, nil, nil
		Flight.onChanged(false)
	end)

	RunService.Heartbeat:Connect(function()
		if not flying then
			return
		end
		local humanoid, root = parts()
		if not humanoid or not root or not velocity or not align or humanoid.Health <= 0 or not Flight.allowed() then
			Flight.stop()
			return
		end
		local horizontal = moveDirection(humanoid) * Config.Fly.Speed
		local up = 0
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) or humanoid.Jump then
			up += Config.Fly.Vertical
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
			up -= Config.Fly.Vertical
		end
		local ceiling = Config.LobbyOrigin.Y + Config.Fly.MaxHeight
		if root.Position.Y > ceiling and up > 0 then
			up = 0
		end
		velocity.VectorVelocity = horizontal + Vector3.new(0, up, 0)
		local cam = workspace.CurrentCamera.CFrame
		local yaw = math.atan2(-cam.LookVector.X, -cam.LookVector.Z)
		align.CFrame = CFrame.Angles(0, yaw, 0)
	end)
end

return Flight
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="69">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- 클라이언트 시작점: 화면을 만들고 서버 메시지를 화면에 연결합니다.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local TextChatService = game:GetService("TextChatService")

local Preferences = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Preferences"))

local Net = require(script.Parent.Net)
local State = require(script.Parent.State)
local Hud = require(script.Parent.UI.Hud)
local Windows = require(script.Parent.UI.Windows)
local Controls = require(script.Parent.Controls)
local Movement = require(script.Parent.Movement)
local Effects = require(script.Parent.Effects)
local BlockTextures = require(script.Parent.BlockTextures)
local CharacterVisuals = require(script.Parent.CharacterVisuals)
local Flight = require(script.Parent.Flight)

local player = Players.LocalPlayer

-- 로블록스 기본 체력바와 가방 숨기기 (마인크래프트식 화면을 대신 씀)
task.spawn(function()
	for _ = 1, 20 do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
		end)
		if ok then
			break
		end
		task.wait(0.5)
	end
end)

BlockTextures.load() -- 핫바 아이콘이 블록 텍스처를 쓰므로 화면보다 먼저
Hud.init(player:WaitForChild("PlayerGui"))
Windows.init(Hud.gui())
Controls.init()
Movement.init()
Effects.init()
task.spawn(BlockTextures.init)
CharacterVisuals.init()
Flight.init()

-- 설정: 서버에서 받은 값을 화면/조작에 적용
State.settings = Preferences.defaults()
local function applySettings()
	local s = State.settings
	Controls.setThirdPerson(s.camera == "third")
	BlockTextures.setRadius(if s.textures then Preferences.TextureRadius[s.textureDistance] or 130 else -1000)
	Effects.enabled = s.sounds ~= false
	CharacterVisuals.setNametagsVisible(s.nametags ~= false)
	Hud.setChatVisible(s.chatFeed ~= false)
	if s.fly == false then
		Flight.stop()
	end
end
applySettings()

Windows.onSetting = function(key: string, value: any)
	State.settings[key] = value
	applySettings()
	Net.send("settings", State.settings)
end
Windows.onFlyToggle = function()
	Flight.toggle()
end
Controls.onCameraChanged = function(third: boolean)
	local mode = if third then "third" else "first"
	if State.settings.camera ~= mode then
		State.settings.camera = mode
		Net.send("settings", State.settings)
		Windows.refresh()
	end
end

-- 왼쪽 위 상점/스킨/설정 버튼
Hud.onMenu = function(name: string)
	if Windows.kind() == name then
		Windows.close()
	elseif name == "store" then
		Windows.openStore()
	elseif name == "skins" then
		Windows.openSkins()
	else
		Windows.openSettings()
	end
end

-- 채팅창에서 VIP 이름 앞에 [VIP]
pcall(function()
	TextChatService.OnIncomingMessage = function(message: TextChatMessage)
		local props = Instance.new("TextChatMessageProperties")
		local source = message.TextSource
		if source then
			local speaker = Players:GetPlayerByUserId(source.UserId)
			if speaker and speaker:GetAttribute("VIP") == true then
				props.PrefixText = '<font color="#FFD24A">[VIP]</font> ' .. message.PrefixText
			end
		end
		return props
	end
end)

local HINTS = {
	lobby = "F: NPC  ·  우클릭: 아이템 사용  ·  V: 시점  ·  1~9: 핫바",
	waiting = "우클릭: 맵 선택 / 키트 고르기(스카이워즈) / 나가기  ·  L 두 번: 로비로  ·  V: 시점",
	match = "E: 가방  ·  Q: 버리기  ·  Shift: 웅크리기  ·  Ctrl: 달리기  ·  F: 상점/상자  ·  V: 시점  ·  L 두 번: 로비로",
	respawn = "곧 부활합니다...",
	spectate = "관전 중  ·  L 두 번: 로비로",
}

local function refreshHealth()
	local char = player.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	if humanoid then
		local absorption = player:GetAttribute("Absorption")
		Hud.setHealth(humanoid.Health, humanoid.MaxHealth, if type(absorption) == "number" then absorption else 0)
	end
end

local function onCharacter(char: Model)
	local humanoid = char:WaitForChild("Humanoid", 10) :: Humanoid?
	if humanoid then
		humanoid.HealthChanged:Connect(refreshHealth)
		humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(refreshHealth)
		refreshHealth()
	end
end
if player.Character then
	task.spawn(onCharacter, player.Character)
end
player.CharacterAdded:Connect(onCharacter)
player:GetAttributeChangedSignal("Absorption"):Connect(refreshHealth)

Net.on("inv", function(data)
	State.applyInventory(data)
end)

Net.on("context", function(context)
	local previous = State.context.location
	State.context = context or { location = "lobby" }
	if previous ~= State.context.location and Windows.isOpen() then
		Windows.close()
	end
	Hud.setHint(HINTS[State.context.location] or "")
	Hud.setStatusVisible(State.context.location == "match" and State.context.mode ~= "tntrun")
	State.emit("context")
end)

Net.on("sidebar", function(data)
	Hud.setSidebar(data)
end)

Net.on("title", function(title, subtitle, duration)
	Hud.title(title, subtitle, duration)
end)

Net.on("chat", function(text)
	Hud.chat(text)
end)

Net.on("vote", function(vote)
	State.vote = vote
	if Windows.kind() == "vote" then
		Windows.refresh()
	end
end)

Net.on("openVote", function()
	Windows.openVote()
end)

Net.on("lobbyInfo", function(info)
	State.lobbyInfo = info or {}
	if Windows.kind() == "games" then
		Windows.refresh()
	end
end)

Net.on("openGames", function(info)
	State.lobbyInfo = info or {}
	Windows.openGames()
end)

Net.on("openShop", function(kind, shop)
	Windows.openShop(kind, shop)
end)

Net.on("shopState", function(shop)
	Windows.updateShop(shop)
end)

Net.on("openChest", function(id, title, contents)
	Windows.openChest(id, title, contents)
end)

Net.on("chest", function(id, contents)
	Windows.updateChest(id, contents)
end)

Net.on("closeChest", function()
	if Windows.kind() == "chest" then
		Windows.close()
	end
end)

Net.on("settings", function(data)
	State.settings = Preferences.sanitize(data)
	applySettings()
	Windows.refresh()
end)

Net.on("passes", function(info)
	State.passes = if type(info) == "table" then info else {}
	Windows.refresh()
end)

Net.on("skinSaved", function(code)
	if type(code) == "string" then
		State.skinCode = code
		Windows.refresh()
	end
end)

Net.on("needVip", function()
	Windows.openStore()
end)

Net.on("openKits", function(data)
	if type(data) == "table" then
		State.kit = { kit = data.kit, perk = data.perk }
	end
	Windows.openKits()
end)

Net.on("kitState", function(data)
	if type(data) == "table" then
		State.kit = { kit = data.kit, perk = data.perk }
		Windows.updateKits()
	end
end)

Net.on("crit", function()
	Hud.actionbar('<font color="#FFAA00">치명타!</font>', 0.8)
end)

Hud.setHint(HINTS.lobby)
Hud.setStatusVisible(false)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">Movement</string>
            <string name="Source"><![CDATA[-- 움직임: 달리기(Ctrl), 웅크리기(Shift, 가장자리에서 안 떨어짐), 더블 점프(TNT 런), 낙하 피해, 넉백,
-- 물약 효과(신속/도약/느림), 사다리 타기, 물에서 헤엄치기(물에 떨어지면 낙하 피해 없음)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(script.Parent.Net)
local State = require(script.Parent.State)

local player = Players.LocalPlayer
local B = Config.BlockSize

local Movement = {}

local sprinting = false
local airborneSince: number? = nil
local doubleJumped = false
local peakY: number? = nil
local lastSafe: CFrame? = nil
local lastPosition: Vector3? = nil

local function parts(): (Humanoid?, BasePart?)
	local char = player.Character
	if not char then
		return nil, nil
	end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if humanoid and root and root:IsA("BasePart") then
		return humanoid, root
	end
	return nil, nil
end

-- 서버가 적어 둔 효과 끝나는 시각(FX_이름)이 아직 안 지났는지
local function effect(name: string): boolean
	local ends = player:GetAttribute("FX_" .. name)
	return type(ends) == "number" and ends > workspace:GetServerTimeNow()
end
Movement.effect = effect

local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Exclude

-- 몸이 닿은 블록 중 사다리/물/용암이 있는지
local function touching(root: BasePart, char: Model): (boolean, boolean, boolean)
	overlap.FilterDescendantsInstances = { char }
	local parts = workspace:GetPartBoundsInBox(root.CFrame * CFrame.new(0, -0.6, 0), Vector3.new(2.4, 4.6, 2.4), overlap)
	local ladder, water, lava = false, false, false
	for _, part in parts do
		local folder = part.Parent
		if folder and folder.Name == "Blocks" then
			local name = part.Name
			if name == "ladder" then
				ladder = true
			elseif name == "water" or name == "water_source" then
				water = true
			elseif name == "lava_flow" then
				lava = true
			end
		end
	end
	return ladder, water, lava
end

local function jumpHeld(humanoid: Humanoid): boolean
	return UserInputService:IsKeyDown(Enum.KeyCode.Space) or humanoid.Jump
end

local function sneaking(): boolean
	return UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or player:GetAttribute("SneakToggle") == true
end

local function groundBelow(position: Vector3, char: Model, depth: number): boolean
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { char }
	local result = workspace:Raycast(position, Vector3.new(0, -depth, 0), params)
	return result ~= nil and result.Instance.CanCollide
end

local function onCharacter(char: Model)
	sprinting = false
	airborneSince = nil
	doubleJumped = false
	peakY = nil
	lastSafe = nil
	local humanoid = char:WaitForChild("Humanoid", 10) :: Humanoid?
	if not humanoid then
		return
	end
	humanoid.StateChanged:Connect(function(_, new)
		local _, root = parts()
		if not root then
			return
		end
		if new == Enum.HumanoidStateType.Freefall or new == Enum.HumanoidStateType.Jumping then
			airborneSince = airborneSince or os.clock()
			peakY = math.max(peakY or root.Position.Y, root.Position.Y)
		elseif new == Enum.HumanoidStateType.Landed or new == Enum.HumanoidStateType.Running then
			if peakY then
				local fall = (peakY - root.Position.Y) / B
				if fall > Config.Combat.FallSafeBlocks and State.context.location == "match" then
					Net.send("fall", fall)
				end
			end
			peakY = nil
			airborneSince = nil
			doubleJumped = false
		end
	end)
end

function Movement.init()
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	player.CharacterAdded:Connect(onCharacter)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.LeftControl then
			sprinting = true
		end
	end)

	-- 공중에서 점프를 한 번 더 누르면 더블 점프
	UserInputService.JumpRequest:Connect(function()
		local humanoid, root = parts()
		if not humanoid or not root or not State.context.doubleJump or doubleJumped then
			return
		end
		local left = player:GetAttribute("DoubleJumps")
		if type(left) ~= "number" or left <= 0 then
			return
		end
		if humanoid.FloorMaterial ~= Enum.Material.Air or not airborneSince or os.clock() - airborneSince < 0.15 then
			return
		end
		doubleJumped = true
		local look = workspace.CurrentCamera.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		local boost = if flat.Magnitude > 0.1 then flat.Unit * 26 else Vector3.zero
		root.AssemblyLinearVelocity = Vector3.new(boost.X, Config.TntRun.DoubleJumpPower, boost.Z)
		Net.send("doubleJump")
	end)

	Net.on("kb", function(velocity: Vector3)
		local _, root = parts()
		if root and typeof(velocity) == "Vector3" then
			root.AssemblyLinearVelocity = velocity
			peakY = nil
		end
	end)

	RunService.Heartbeat:Connect(function()
		local humanoid, root = parts()
		if not humanoid or not root or humanoid.Health <= 0 then
			return
		end
		local sneak = sneaking()
		if humanoid.MoveDirection.Magnitude < 0.1 then
			sprinting = false
		end
		local speed
		if sneak then
			speed = Config.Movement.Sneak
		elseif sprinting then
			speed = Config.Movement.Sprint
		else
			speed = Config.Movement.Walk
		end
		if effect("speed") then
			speed *= Config.Effects.speed.walk
		end
		if effect("slow") then
			speed *= Config.Effects.slow.walk
		end
		local char0 = player.Character :: Model
		local onLadder, inWater, inLava = touching(root, char0)
		if inWater then
			speed *= 0.6
		elseif inLava then
			speed *= 0.5
		end
		humanoid.WalkSpeed = speed
		humanoid.JumpHeight = Config.Movement.JumpHeight * (if effect("jump") then Config.Effects.jump.jump else 1)

		-- 사다리: 앞으로 가거나 점프하면 올라가고, 웅크리면 멈춤, 가만히 있으면 천천히 내려감
		local velocity = root.AssemblyLinearVelocity
		if onLadder and State.context.location == "match" then
			local vy
			if humanoid.MoveDirection.Magnitude > 0.1 or jumpHeld(humanoid) then
				vy = 9
			elseif sneak then
				vy = 0
			else
				vy = math.max(velocity.Y, -5)
			end
			root.AssemblyLinearVelocity = Vector3.new(velocity.X, vy, velocity.Z)
			peakY = nil
		elseif inWater or inLava then
			-- 헤엄치기: 점프를 누르고 있으면 떠오르고, 아니면 천천히 가라앉음
			local vy = if jumpHeld(humanoid) then 8 else math.max(velocity.Y, -6)
			root.AssemblyLinearVelocity = Vector3.new(velocity.X, vy, velocity.Z)
			peakY = nil
		end
		-- 순간이동(진주, 서버 이동)은 낙하로 치지 않음
		if lastPosition and (root.Position - lastPosition).Magnitude > 25 then
			peakY = if peakY then root.Position.Y else nil
		end
		lastPosition = root.Position
		if peakY then
			peakY = math.max(peakY, root.Position.Y)
		end

		-- 웅크리면 블록 가장자리에서 떨어지지 않게 막기
		local char = player.Character :: Model
		local grounded = humanoid.FloorMaterial ~= Enum.Material.Air
		if sneak and State.context.location == "match" then
			local leg = if humanoid.RigType == Enum.HumanoidRigType.R6 then 2 else humanoid.HipHeight
			local depth = leg + root.Size.Y / 2 + 1.2
			if grounded and groundBelow(root.Position, char, depth) then
				lastSafe = root.CFrame
			elseif lastSafe and not grounded and root.AssemblyLinearVelocity.Y <= 0 then
				-- 방금 가장자리를 넘었으면 마지막 안전한 곳으로 되돌림
				if (lastSafe.Position - root.Position).Magnitude < 3 then
					root.CFrame = CFrame.new(lastSafe.Position) * root.CFrame.Rotation
					root.AssemblyLinearVelocity = Vector3.zero
				end
				lastSafe = nil
			end
		else
			lastSafe = nil
		end
	end)
end

return Movement
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">Net</string>
            <string name="Source"><![CDATA[-- 클라이언트 통신: 서버 메시지를 종류별로 나눠 전달하고, 요청을 보냅니다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = {}

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local action = remotes:WaitForChild("Action") :: RemoteEvent
local client = remotes:WaitForChild("Client") :: RemoteEvent

local handlers: { [string]: { (...any) -> () } } = {}

function Net.on(kind: string, handler: (...any) -> ())
	handlers[kind] = handlers[kind] or {}
	table.insert(handlers[kind], handler)
end

function Net.send(kind: string, ...: any)
	action:FireServer(kind, ...)
end

client.OnClientEvent:Connect(function(kind: string, ...: any)
	local list = handlers[kind]
	if not list then
		return
	end
	for _, handler in list do
		local ok, err = pcall(handler, ...)
		if not ok then
			warn("[블록 아레나] 클라이언트 처리 오류 (" .. kind .. "):", err)
		end
	end
end)

return Net
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[-- 클라이언트가 알고 있는 현재 상태 (가방, 어디에 있는지, 투표 정보 등)
local State = {}

export type Stack = { id: string, count: number }

State.slots = {} :: { [number]: Stack? }
State.armor = {} :: { [string]: string? }
State.selected = 1
State.cursor = nil :: Stack?
State.armorLocked = false
State.context = { location = "lobby" } :: { [string]: any }
State.vote = nil :: any
State.lobbyInfo = {} :: { [string]: { waiting: number, playing: number } }
State.shop = nil :: any
State.chest = nil :: { id: number, title: string, slots: { [number]: Stack? } }?
State.passes = {} :: { [string]: { owned: boolean, price: number, available: boolean, studioTest: boolean } }
State.settings = {} :: { [string]: any } -- Main 에서 기본값으로 채움
State.skinCode = "" -- 저장된 내 스킨
State.kit = { kit = "explorer", perk = "lifesteal" } :: { kit: string?, perk: string? } -- 스카이워즈 키트/능력

local listeners: { [string]: { () -> () } } = {}

function State.listen(kind: string, fn: () -> ())
	listeners[kind] = listeners[kind] or {}
	table.insert(listeners[kind], fn)
end

function State.emit(kind: string)
	for _, fn in listeners[kind] or {} do
		local ok, err = pcall(fn)
		if not ok then
			warn("[블록 아레나] 화면 갱신 오류 (" .. kind .. "):", err)
		end
	end
end

-- 서버가 보낸 { ["1"] = { id, count } } 꼴을 숫자 칸으로 바꿉니다.
function State.decode(raw: { [string]: { any } }?): { [number]: Stack? }
	local out = {}
	for key, value in raw or {} do
		local index = tonumber(key)
		if index then
			out[index] = { id = value[1], count = value[2] }
		end
	end
	return out
end

function State.applyInventory(data)
	State.slots = State.decode(data.slots)
	State.armor = data.armor or {}
	State.selected = data.selected or 1
	State.cursor = if data.cursor then { id = data.cursor[1], count = data.cursor[2] } else nil
	State.armorLocked = data.armorLocked == true
	State.emit("inv")
end

function State.selectedStack(): Stack?
	return State.slots[State.selected]
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="73">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[-- 게임 화면: 조준점, 핫바, 하트, 갑옷, 오른쪽 점수판, 가운데 큰 글씨, 채팅 알림, 액션바
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Items = require(Shared:WaitForChild("Items"))
local Rules = require(Shared:WaitForChild("Rules"))
local Theme = require(script.Parent.Theme)
local IconRender = require(script.Parent.IconRender)
local State = require(script.Parent.Parent.State)

local create = Theme.create
local C = Theme.Colors

local Hud = {}

local SLOT = 44
local HEART = 18

local gui: ScreenGui
local scale: UIScale
local hotbarSlots: { TextButton } = {}
local selector: Frame
local hearts: { { fill: Frame, clip: Frame } } = {}
local absorbHearts: { { fill: Frame, clip: Frame, holder: Frame } } = {}
local armorIcons: { { clip: Frame, holder: Frame } } = {}
local sidebarTitle: TextLabel
local sidebarLines: Frame
local titleGroup: CanvasGroup
local titleLabel: TextLabel
local subtitleLabel: TextLabel
local chatFrame: Frame
local actionLabel: TextLabel
local itemNameLabel: TextLabel
local hintLabel: TextLabel
local crosshair: Frame
local effectsLabel: TextLabel
local blindOverlay: Frame
local fireOverlay: Frame
local titleToken = 0
local actionToken = 0
local itemNameToken = 0

Hud.onSlotClicked = function(_index: number) end
Hud.onMenu = function(_name: string) end

local function heartWidget(parent: Instance, x: number, color: Color3, emptyColor: Color3?)
	local holder = create("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(x, 0),
		Size = UDim2.fromOffset(HEART, HEART),
		Parent = parent,
	})
	local empty = IconRender.draw("heart", emptyColor or Color3.fromRGB(45, 18, 18))
	empty.Parent = holder
	local clip = create("Frame", {
		Name = "Clip",
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Size = UDim2.fromScale(1, 1),
		Parent = holder,
	})
	local fill = IconRender.draw("heart", color)
	fill.Size = UDim2.fromOffset(HEART, HEART)
	fill.Parent = clip
	return { fill = fill, clip = clip, holder = holder }
end

local function armorWidget(parent: Instance, x: number)
	local holder = create("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(x, 0),
		Size = UDim2.fromOffset(HEART, HEART),
		Parent = parent,
	})
	local empty = IconRender.draw("chestplate", Color3.fromRGB(50, 50, 55))
	empty.Parent = holder
	local clip = create("Frame", {
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Size = UDim2.fromScale(1, 1),
		Parent = holder,
	})
	local fill = IconRender.draw("chestplate", Color3.fromRGB(220, 220, 228))
	fill.Size = UDim2.fromOffset(HEART, HEART)
	fill.Parent = clip
	return { clip = clip, holder = holder }
end

function Hud.init(playerGui: Instance)
	gui = create("ScreenGui", {
		Name = "BlockArenaHud",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 5,
		Parent = playerGui,
	})
	scale = create("UIScale", { Parent = gui })

	-- 조준점
	crosshair = create("Frame", {
		Name = "Crosshair",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(18, 18),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	for _, size in { UDim2.fromOffset(18, 2), UDim2.fromOffset(2, 18) } do
		create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = size,
			BorderSizePixel = 0,
			BackgroundColor3 = C.White,
			BackgroundTransparency = 0.15,
			Parent = crosshair,
		})
	end

	-- 핫바
	local hotbar = create("Frame", {
		Name = "Hotbar",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -8),
		Size = UDim2.fromOffset(SLOT * 9 + 4, SLOT + 4),
		BackgroundColor3 = Color3.fromRGB(20, 20, 20),
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		Parent = gui,
	})
	create("UIStroke", { Color = Color3.fromRGB(0, 0, 0), Thickness = 2, Parent = hotbar })
	for i = 1, 9 do
		local slot = Theme.slot(SLOT)
		slot.Name = "Slot" .. i
		slot.Position = UDim2.fromOffset(2 + (i - 1) * SLOT, 2)
		slot.BackgroundColor3 = Color3.fromRGB(90, 90, 90)
		slot.BackgroundTransparency = 0.25
		slot.Parent = hotbar
		slot.MouseButton1Click:Connect(function()
			Hud.onSlotClicked(i)
		end)
		hotbarSlots[i] = slot
	end
	selector = create("Frame", {
		Name = "Selector",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(SLOT + 4, SLOT + 4),
		ZIndex = 6,
		Parent = hotbar,
	})
	create("UIStroke", { Color = C.White, Thickness = 3, Parent = selector })

	-- 하트와 갑옷
	local status = create("Frame", {
		Name = "Status",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -(SLOT + 18)),
		Size = UDim2.fromOffset(SLOT * 9 + 4, HEART * 2 + 4),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	local healthRow = create("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, HEART + 4),
		Size = UDim2.fromOffset(HEART * 10, HEART),
		Parent = status,
	})
	local absorbRow = create("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.fromOffset(HEART * 10, HEART),
		Parent = status,
	})
	local armorRow = create("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, HEART + 4),
		Size = UDim2.fromOffset(HEART * 10, HEART),
		Parent = status,
	})
	for i = 1, 10 do
		hearts[i] = heartWidget(healthRow, (i - 1) * (HEART - 1), Color3.fromRGB(230, 30, 30))
		local absorb = heartWidget(absorbRow, (i - 1) * (HEART - 1), Color3.fromRGB(250, 210, 40), Color3.fromRGB(80, 70, 20))
		absorb.holder.Visible = false
		absorbHearts[i] = absorb
		armorIcons[i] = armorWidget(armorRow, (10 - i) * (HEART - 1))
	end

	-- 액션바, 아이템 이름
	actionLabel = Theme.label("", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -(SLOT + HEART * 2 + 30)),
		Size = UDim2.fromOffset(600, 22),
		Visible = false,
		Parent = gui,
	})
	itemNameLabel = Theme.label("", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -(SLOT + HEART * 2 + 56)),
		Size = UDim2.fromOffset(500, 22),
		Visible = false,
		Parent = gui,
	})

	-- 오른쪽 점수판
	local sidebar = create("Frame", {
		Name = "Sidebar",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -6, 0.5, 0),
		Size = UDim2.fromOffset(250, 40),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		Parent = gui,
	})
	create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Parent = sidebar })
	create("UIPadding", {
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
		PaddingBottom = UDim.new(0, 6),
		Parent = sidebar,
	})
	sidebarTitle = create("TextLabel", {
		Name = "Title",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 28),
		Font = Theme.Font,
		TextSize = 20,
		RichText = true,
		TextColor3 = C.Yellow,
		Text = "",
		LayoutOrder = 0,
		Parent = sidebar,
	})
	sidebarLines = create("Frame", {
		Name = "Lines",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 1,
		Parent = sidebar,
	})
	create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Parent = sidebarLines })

	-- 가운데 큰 글씨
	titleGroup = create("CanvasGroup", {
		Name = "Title",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.36),
		Size = UDim2.fromOffset(900, 130),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Parent = gui,
	})
	titleLabel = Theme.label("", {
		Size = UDim2.new(1, 0, 0, 72),
		Parent = titleGroup,
	})
	subtitleLabel = Theme.label("", {
		Position = UDim2.fromOffset(0, 82),
		Size = UDim2.new(1, 0, 0, 32),
		Parent = titleGroup,
	})

	-- 채팅 알림 (왼쪽 아래)
	chatFrame = create("Frame", {
		Name = "Chat",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 8, 1, -(SLOT + 120)),
		Size = UDim2.fromOffset(460, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = gui,
	})
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		Parent = chatFrame,
	})

	-- 왼쪽 위 키 안내
	-- 왼쪽 위 메뉴 버튼 (로블록스 기본 버튼 줄 바로 아래)
	local menu = create("Frame", {
		Name = "Menu",
		Position = UDim2.fromOffset(12, 64),
		Size = UDim2.fromOffset(300, 34),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = menu,
	})
	for i, entry in { { "store", "상점", Color3.fromRGB(200, 150, 30) }, { "skins", "스킨", Color3.fromRGB(60, 130, 190) }, { "settings", "설정", C.Button } } do
		local button = Theme.button(entry[2], {
			Name = entry[1],
			Size = UDim2.fromOffset(84, 32),
			LayoutOrder = i,
			BackgroundColor3 = entry[3],
			Parent = menu,
		})
		local base = entry[3]
		button.MouseLeave:Connect(function()
			button.BackgroundColor3 = base
		end)
		button.MouseButton1Click:Connect(function()
			Hud.onMenu(entry[1])
		end)
	end

	hintLabel = create("TextLabel", {
		Name = "Hint",
		Position = UDim2.fromOffset(12, 104),
		Size = UDim2.fromOffset(520, 18),
		BackgroundTransparency = 1,
		Font = Theme.Font,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = C.Gray,
		TextStrokeTransparency = 0.6,
		Text = "",
		Parent = gui,
	})

	-- 받고 있는 효과 목록 (물약, 함정, 불)과 어둠/불 화면 효과
	effectsLabel = create("TextLabel", {
		Name = "Effects",
		Position = UDim2.fromOffset(12, 128),
		Size = UDim2.fromOffset(220, 120),
		BackgroundTransparency = 1,
		Font = Theme.Font,
		TextSize = 15,
		RichText = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = C.White,
		TextStrokeTransparency = 0.4,
		Text = "",
		Parent = gui,
	})
	blindOverlay = create("Frame", {
		Name = "Blind",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.08,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 0,
		Parent = gui,
	})
	fireOverlay = create("Frame", {
		Name = "Fire",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 0.35),
		BackgroundColor3 = Color3.fromRGB(255, 120, 20),
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 0,
		Parent = gui,
	})
	create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }),
		Parent = fireOverlay,
	})
	local localPlayer = Players.LocalPlayer
	local effectTimer = 0
	RunService.Heartbeat:Connect(function(dt)
		effectTimer += dt
		if effectTimer < 0.25 then
			return
		end
		effectTimer = 0
		local now = workspace:GetServerTimeNow()
		local lines = {}
		local blind, fire = false, false
		for name, def in Config.Effects do
			local ends = localPlayer:GetAttribute("FX_" .. name)
			if type(ends) == "number" and ends > now then
				table.insert(lines, string.format('<font color="%s">%s</font> %d초', def.color, def.name, math.ceil(ends - now)))
				blind = blind or name == "blind"
				fire = fire or name == "fire"
			end
		end
		table.sort(lines)
		effectsLabel.Text = table.concat(lines, "\n")
		blindOverlay.Visible = blind
		fireOverlay.Visible = fire
	end)

	local camera = workspace.CurrentCamera
	local function rescale()
		local size = camera.ViewportSize
		scale.Scale = math.clamp(math.min(size.Y / 720, size.X / 1000), 0.55, 1.5)
	end
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	rescale()

	State.listen("inv", Hud.refreshInventory)
	Hud.refreshInventory()
	return gui
end

function Hud.gui(): ScreenGui
	return gui
end

function Hud.refreshInventory()
	for i = 1, 9 do
		IconRender.fill(hotbarSlots[i], State.slots[i])
	end
	selector.Position = UDim2.fromOffset((State.selected - 1) * SLOT, 0)
	local points = Rules.armorPoints(State.armor)
	for i = 1, 10 do
		local value = math.clamp(points - (i - 1) * 2, 0, 2)
		armorIcons[i].clip.Size = UDim2.fromScale(value / 2, 1)
		armorIcons[i].holder.Visible = points > 0
	end
end

function Hud.showItemName()
	local stack = State.selectedStack()
	local def = if stack then Items.get(stack.id) else nil
	itemNameToken += 1
	local token = itemNameToken
	if not def then
		itemNameLabel.Visible = false
		return
	end
	itemNameLabel.Text = def.name
	itemNameLabel.Visible = true
	task.delay(1.8, function()
		if itemNameToken == token then
			itemNameLabel.Visible = false
		end
	end)
end

function Hud.setHealth(health: number, maxHealth: number, absorption: number)
	local h = math.clamp(math.ceil(health), 0, maxHealth)
	for i = 1, 10 do
		local value = math.clamp(h - (i - 1) * 2, 0, 2)
		hearts[i].clip.Size = UDim2.fromScale(value / 2, 1)
		local a = math.clamp(math.ceil(absorption) - (i - 1) * 2, 0, 2)
		absorbHearts[i].holder.Visible = a > 0
		absorbHearts[i].clip.Size = UDim2.fromScale(a / 2, 1)
	end
end

function Hud.setStatusVisible(visible: boolean)
	local status = gui:FindFirstChild("Status")
	if status and status:IsA("GuiObject") then
		status.Visible = visible
	end
end

function Hud.setSidebar(data: { title: string, lines: { string } })
	sidebarTitle.Text = data.title or ""
	local existing = sidebarLines:GetChildren()
	local labels = {}
	for _, child in existing do
		if child:IsA("TextLabel") then
			table.insert(labels, child)
		end
	end
	table.sort(labels, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	local lines = data.lines or {}
	for i, text in lines do
		local label = labels[i]
		if not label then
			label = create("TextLabel", {
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 20),
				Font = Theme.Font,
				TextSize = 16,
				RichText = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextColor3 = C.White,
				TextStrokeTransparency = 0.7,
				LayoutOrder = i,
				Parent = sidebarLines,
			})
		end
		label.LayoutOrder = i
		label.Text = if text == "" then " " else text
	end
	for i = #lines + 1, #labels do
		labels[i]:Destroy()
	end
end

function Hud.title(title: string, subtitle: string?, duration: number?)
	titleToken += 1
	local token = titleToken
	titleLabel.Text = title
	subtitleLabel.Text = subtitle or ""
	titleGroup.GroupTransparency = 0
	task.delay(duration or 2.5, function()
		if titleToken == token then
			TweenService:Create(titleGroup, TweenInfo.new(0.4), { GroupTransparency = 1 }):Play()
		end
	end)
end

function Hud.chat(text: string)
	local line = create("TextLabel", {
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.55,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Font = Theme.Font,
		TextSize = 17,
		RichText = true,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = C.White,
		TextStrokeTransparency = 0.75,
		Text = text,
		LayoutOrder = os.clock() * 1000 // 1,
	})
	create("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4), Parent = line })
	line.Parent = chatFrame
	local lines = {}
	for _, child in chatFrame:GetChildren() do
		if child:IsA("TextLabel") then
			table.insert(lines, child)
		end
	end
	table.sort(lines, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	while #lines > 9 do
		table.remove(lines, 1):Destroy()
	end
	task.delay(10, function()
		if line.Parent then
			local tween = TweenService:Create(line, TweenInfo.new(1), { TextTransparency = 1, BackgroundTransparency = 1, TextStrokeTransparency = 1 })
			tween:Play()
			tween.Completed:Wait()
			line:Destroy()
		end
	end)
end

function Hud.actionbar(text: string, duration: number?)
	actionToken += 1
	local token = actionToken
	actionLabel.Text = text
	actionLabel.Visible = text ~= ""
	if duration then
		task.delay(duration, function()
			if actionToken == token then
				actionLabel.Visible = false
			end
		end)
	end
end

function Hud.setChatVisible(visible: boolean)
	chatFrame.Visible = visible
end

function Hud.setHint(text: string)
	hintLabel.Text = text
end

function Hud.setCrosshairVisible(visible: boolean)
	crosshair.Visible = visible
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="75">
            <Properties>
              <string name="Name">IconRender</string>
              <string name="Source"><![CDATA[-- 픽셀 아이콘 그리기: 같은 색이 이어지는 칸은 한 프레임으로 합쳐서 프레임 수를 줄입니다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Icons = require(Shared:WaitForChild("Icons"))
local Items = require(Shared:WaitForChild("Items"))
local Blocks = require(Shared:WaitForChild("Blocks"))
local BlockTextures = require(script.Parent.Parent.BlockTextures)

local IconRender = {}

local cache: { [string]: Frame } = {}

local function build(name: string, color: Color3): Frame
	local art = Icons.Art[name] or Icons.Art.question
	local size = Icons.Size
	local holder = Instance.new("Frame")
	holder.Name = "Pixels"
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.fromScale(1, 1)
	for row, line in art do
		local col = 1
		while col <= #line do
			local char = string.sub(line, col, col)
			local run = 1
			while col + run <= #line and string.sub(line, col + run, col + run) == char do
				run += 1
			end
			local pixelColor = Icons.colorFor(char, color)
			if pixelColor then
				local pixel = Instance.new("Frame")
				pixel.BorderSizePixel = 0
				pixel.BackgroundColor3 = pixelColor
				pixel.Position = UDim2.fromScale((col - 1) / size, (row - 1) / size)
				pixel.Size = UDim2.fromScale(run / size, 1 / size)
				pixel.Parent = holder
			end
			col += run
		end
	end
	return holder
end

function IconRender.draw(name: string, color: Color3): Frame
	local key = name .. "|" .. color:ToHex()
	local template = cache[key]
	if not template then
		template = build(name, color)
		cache[key] = template
	end
	return template:Clone()
end

-- 블록 아이템은 실제 블록 텍스처를 또렷하게(Pixelated) 보여 줍니다.
local function blockImage(blockId: string): GuiObject?
	local block = Blocks.get(blockId)
	if not block then
		return nil
	end
	local name = Blocks.faceTexture(block, "side")
	local source = if name then BlockTextures.source(name) else nil
	if not source then
		return nil
	end
	local image = Instance.new("ImageLabel")
	image.Name = "Pixels"
	image.BackgroundTransparency = 1
	image.Size = UDim2.fromScale(1, 1)
	image.ResampleMode = Enum.ResamplerMode.Pixelated
	image.BackgroundColor3 = block.color
	if source.content then
		image.ImageContent = source.content
	elseif source.id then
		image.Image = source.id
	end
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(20, 20, 20)
	stroke.Thickness = 1
	stroke.Parent = image
	return image
end

function IconRender.item(id: string): GuiObject
	local def = Items.get(id)
	if not def then
		return IconRender.draw("question", Color3.new(1, 1, 1))
	end
	if def.kind == "block" and def.block then
		local image = blockImage(def.block)
		if image then
			return image
		end
	end
	return IconRender.draw(def.icon, def.color)
end

-- 칸(Theme.slot)에 아이템을 표시합니다. 같은 아이템이면 다시 그리지 않습니다.
function IconRender.fill(slot: GuiObject, stack: { id: string, count: number }?)
	local iconHolder = slot:FindFirstChild("Icon")
	local count = slot:FindFirstChild("Count")
	if not iconHolder then
		return
	end
	local id = if stack then stack.id else ""
	if slot:GetAttribute("ItemId") ~= id then
		slot:SetAttribute("ItemId", id)
		iconHolder:ClearAllChildren()
		if stack then
			local pixels = IconRender.item(stack.id)
			pixels.ZIndex = 2
			for _, child in pixels:GetChildren() do
				if child:IsA("GuiObject") then
					child.ZIndex = (slot.ZIndex or 1) + 1
				end
			end
			pixels.Parent = iconHolder
		end
	end
	if count and count:IsA("TextLabel") then
		count.Text = if stack and stack.count > 1 then tostring(stack.count) else ""
	end
end

return IconRender
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[-- 마인크래프트 느낌의 화면 부품: 회색 입체 창, 움푹 들어간 칸, 그림자 글씨, 버튼
local Theme = {}

Theme.Font = Enum.Font.Arcade

Theme.Colors = {
	Panel = Color3.fromRGB(198, 198, 198),
	PanelLight = Color3.fromRGB(255, 255, 255),
	PanelDark = Color3.fromRGB(85, 85, 85),
	Outline = Color3.fromRGB(0, 0, 0),
	Slot = Color3.fromRGB(139, 139, 139),
	SlotDark = Color3.fromRGB(55, 55, 55),
	SlotLight = Color3.fromRGB(255, 255, 255),
	SlotHover = Color3.fromRGB(197, 197, 197),
	Text = Color3.fromRGB(64, 64, 64),
	White = Color3.fromRGB(255, 255, 255),
	Shadow = Color3.fromRGB(62, 62, 62),
	Yellow = Color3.fromRGB(255, 255, 85),
	Green = Color3.fromRGB(85, 255, 85),
	Red = Color3.fromRGB(255, 85, 85),
	Gray = Color3.fromRGB(170, 170, 170),
	Button = Color3.fromRGB(111, 111, 111),
	ButtonHover = Color3.fromRGB(126, 136, 191),
	Tooltip = Color3.fromRGB(16, 0, 16),
	TooltipBorder = Color3.fromRGB(40, 0, 100),
}

local C = Theme.Colors

function Theme.create(className: string, props: { [string]: any }?, children: { Instance }?): any
	local instance = Instance.new(className)
	local parent = nil
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		else
			(instance :: any)[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = instance
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

local create = Theme.create

local function strip(parent: Instance, color: Color3, position: UDim2, size: UDim2, z: number?)
	return create("Frame", {
		Name = "Bevel",
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Position = position,
		Size = size,
		ZIndex = z or 1,
		Parent = parent,
	})
end

-- 바깥 검은 테두리 + 밝은 위/왼쪽, 어두운 아래/오른쪽 테두리가 있는 회색 창
function Theme.panel(props: { [string]: any }?): Frame
	local frame = create("Frame", {
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
	})
	for key, value in props or {} do
		if key ~= "Parent" then
			(frame :: any)[key] = value
		end
	end
	create("UIStroke", { Color = C.Outline, Thickness = 2, Parent = frame })
	strip(frame, C.PanelLight, UDim2.new(0, 0, 0, 0), UDim2.new(1, -3, 0, 3))
	strip(frame, C.PanelLight, UDim2.new(0, 0, 0, 0), UDim2.new(0, 3, 1, -3))
	strip(frame, C.PanelDark, UDim2.new(0, 3, 1, -3), UDim2.new(1, -3, 0, 3))
	strip(frame, C.PanelDark, UDim2.new(1, -3, 0, 3), UDim2.new(0, 3, 1, -3))
	if props and props.Parent then
		frame.Parent = props.Parent
	end
	return frame
end

-- 아이템 칸: 위/왼쪽이 어둡고 아래/오른쪽이 밝아서 움푹 들어가 보임
function Theme.slot(size: number): TextButton
	local button = create("TextButton", {
		Name = "Slot",
		AutoButtonColor = false,
		BackgroundColor3 = C.Slot,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(size, size),
		Text = "",
	})
	strip(button, C.SlotDark, UDim2.new(0, 0, 0, 0), UDim2.new(1, -2, 0, 2))
	strip(button, C.SlotDark, UDim2.new(0, 0, 0, 0), UDim2.new(0, 2, 1, -2))
	strip(button, C.SlotLight, UDim2.new(0, 2, 1, -2), UDim2.new(1, -2, 0, 2))
	strip(button, C.SlotLight, UDim2.new(1, -2, 0, 2), UDim2.new(0, 2, 1, -2))
	create("Frame", {
		Name = "Icon",
		BackgroundTransparency = 1,
		Position = UDim2.new(0.12, 0, 0.12, 0),
		Size = UDim2.new(0.76, 0, 0.76, 0),
		ZIndex = 2,
		Parent = button,
	})
	Theme.label("", {
		Name = "Count",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -2, 1, -1),
		Size = UDim2.new(1, -2, 0.42, 0),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = C.White,
		ZIndex = 4,
		Parent = button,
	})
	button.MouseEnter:Connect(function()
		button.BackgroundColor3 = C.SlotHover
	end)
	button.MouseLeave:Connect(function()
		button.BackgroundColor3 = C.Slot
	end)
	return button
end

local function plain(text: string): string
	return (string.gsub(text, "<[^>]+>", ""))
end

-- 그림자가 있는 글씨 (마인크래프트 글씨처럼 오른쪽 아래로 어두운 그림자).
-- 바깥 TextLabel 의 글자는 투명하고, 안쪽의 Shadow/Front 두 글씨가 실제로 보입니다.
-- 바깥의 Text, TextColor3, 정렬을 바꾸면 안쪽도 같이 바뀝니다.
function Theme.label(text: string, props: { [string]: any }?): TextLabel
	local label = create("TextLabel", {
		BackgroundTransparency = 1,
		Font = Theme.Font,
		Text = text,
		TextScaled = true,
		RichText = true,
		TextColor3 = C.White,
	})
	for key, value in props or {} do
		if key ~= "Parent" then
			(label :: any)[key] = value
		end
	end
	local front: TextLabel, shadow: TextLabel
	local function make(name: string, offset: number, z: number): TextLabel
		return create("TextLabel", {
			Name = name,
			BackgroundTransparency = 1,
			Position = UDim2.new(0, offset, 0, offset),
			Size = UDim2.new(1, 0, 1, 0),
			ZIndex = z,
			Parent = label,
		})
	end
	shadow = make("Shadow", 2, 1)
	front = make("Front", 0, 2)
	local function sync()
		for _, child in { shadow, front } do
			child.Font = label.Font
			child.TextScaled = label.TextScaled
			child.TextSize = label.TextSize
			child.TextXAlignment = label.TextXAlignment
			child.TextYAlignment = label.TextYAlignment
			child.TextWrapped = label.TextWrapped
		end
		front.RichText = label.RichText
		front.Text = label.Text
		front.TextColor3 = label.TextColor3
		shadow.RichText = false
		shadow.Text = plain(label.Text)
		shadow.TextColor3 = C.Shadow
	end
	sync()
	label.TextTransparency = 1
	for _, property in { "Text", "TextColor3", "TextXAlignment", "TextYAlignment", "Font", "TextSize", "TextScaled", "TextWrapped" } do
		label:GetPropertyChangedSignal(property):Connect(sync)
	end
	if props and props.Parent then
		label.Parent = props.Parent
	end
	return label
end

-- 회색 마인크래프트 버튼
function Theme.button(text: string, props: { [string]: any }?): TextButton
	local button = create("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = C.Button,
		BorderSizePixel = 0,
		Text = "",
	})
	for key, value in props or {} do
		if key ~= "Parent" then
			(button :: any)[key] = value
		end
	end
	create("UIStroke", { Color = C.Outline, Thickness = 2, Parent = button })
	strip(button, Color3.fromRGB(170, 170, 170), UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 0, 2))
	strip(button, Color3.fromRGB(60, 60, 60), UDim2.new(0, 0, 1, -3), UDim2.new(1, 0, 0, 3))
	Theme.label(text, {
		Name = "Label",
		Position = UDim2.new(0, 6, 0.18, 0),
		Size = UDim2.new(1, -12, 0.62, 0),
		ZIndex = 3,
		Parent = button,
	})
	button.MouseEnter:Connect(function()
		button.BackgroundColor3 = C.ButtonHover
	end)
	button.MouseLeave:Connect(function()
		button.BackgroundColor3 = C.Button
	end)
	if props and props.Parent then
		button.Parent = props.Parent
	end
	return button
end

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">Windows</string>
              <string name="Source"><![CDATA[-- 마인크래프트식 창: 가방(E), 상자, 상점(빠른 구매), 팀 강화·함정, 키트, 맵 투표, 게임 선택
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Items = require(Shared:WaitForChild("Items"))
local Shop = require(Shared:WaitForChild("Shop"))
local Skins = require(Shared:WaitForChild("Skins"))
local CharacterRig = require(Shared:WaitForChild("CharacterRig"))
local Preferences = require(Shared:WaitForChild("Preferences"))
local Kits = require(Shared:WaitForChild("Kits"))
local Theme = require(script.Parent.Theme)
local IconRender = require(script.Parent.IconRender)
local State = require(script.Parent.Parent.State)
local Net = require(script.Parent.Parent.Net)
local CharacterVisuals = require(script.Parent.Parent.CharacterVisuals)

local create = Theme.create
local C = Theme.Colors

local Windows = {}

local SLOT = 40
local GAP = 2

local gui: ScreenGui
local layer: Frame
local current: Frame? = nil
local currentKind: string? = nil
local refreshers: { () -> () } = {}
local tooltip: Frame
local tooltipLabel: TextLabel
local cursorIcon: Frame
local shopCategory = 1

Windows.onChanged = function(_open: boolean) end
-- 설정 버튼을 눌렀을 때 (Main 에서 채움: 적용 + 서버에 저장)
Windows.onSetting = function(_key: string, _value: any) end
Windows.onFlyToggle = function() end

local function hex(color: Color3): string
	return "#" .. color:ToHex()
end

-- 마우스를 올리면 보이는 설명창
local function setTooltip(lines: { string }?)
	if not lines or #lines == 0 then
		tooltip.Visible = false
		return
	end
	tooltipLabel.Text = table.concat(lines, "\n")
	tooltip.Visible = true
end

local function attachTooltip(button: GuiObject, getLines: () -> { string }?)
	button.MouseEnter:Connect(function()
		setTooltip(getLines())
	end)
	button.MouseLeave:Connect(function()
		setTooltip(nil)
	end)
end

local function itemLines(id: string?): { string }?
	if not id then
		return nil
	end
	local def = Items.get(id)
	if not def then
		return nil
	end
	local lines = { def.name }
	if def.damage and (def.kind == "sword" or def.kind == "axe" or def.kind == "pickaxe") then
		table.insert(lines, string.format('<font color="#5555FF">공격력 +%d</font>', def.damage))
	end
	if def.armorPoints then
		table.insert(lines, string.format('<font color="#5555FF">방어 +%d</font>', def.armorPoints))
	end
	for _, line in def.lore or {} do
		table.insert(lines, '<font color="#AAAAAA">' .. line .. "</font>")
	end
	return lines
end

local function clickButton(input: InputObject): string
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		return "right"
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift) then
		return "shift"
	end
	return "left"
end

local function bindSlotClick(slot: GuiButton, onClick: (string) -> ())
	slot.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 then
			onClick(clickButton(input))
		elseif input.UserInputType == Enum.UserInputType.Touch then
			onClick("left")
		end
	end)
end

local function heading(parent: Instance, text: string, y: number, width: number)
	return create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, y),
		Size = UDim2.fromOffset(width - 24, 20),
		Font = Theme.Font,
		TextSize = 18,
		RichText = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = C.Text,
		Text = text,
		Parent = parent,
	})
end

local function window(title: string, width: number, height: number): Frame
	local frame = Theme.panel({
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(width, height),
		Parent = layer,
	})
	heading(frame, title, 8, width)
	-- 일인칭에서도 마우스를 쓸 수 있게 해 주는 모달 버튼
	create("TextButton", {
		Name = "Modal",
		Modal = true,
		BackgroundTransparency = 1,
		Text = "",
		Size = UDim2.fromOffset(1, 1),
		Parent = frame,
	})
	local close = Theme.button("X", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 6),
		Size = UDim2.fromOffset(26, 24),
		Parent = frame,
	})
	close.MouseButton1Click:Connect(function()
		Windows.close()
	end)
	return frame
end

-- 칸 묶음 (가로 columns 개)
local function grid(parent: Instance, x: number, y: number, count: number, columns: number, onSlot: (number, TextButton) -> ())
	for i = 1, count do
		local col = (i - 1) % columns
		local row = (i - 1) // columns
		local slot = Theme.slot(SLOT)
		slot.Position = UDim2.fromOffset(x + col * (SLOT + GAP), y + row * (SLOT + GAP))
		slot.Parent = parent
		onSlot(i, slot)
	end
end

local function playerInventory(frame: Frame, x: number, y: number)
	local slots: { [number]: TextButton } = {}
	heading(frame, "가방", y - 22, 300)
	-- 가방 27칸 (10~36), 그 아래 핫바 9칸 (1~9)
	grid(frame, x, y, 27, 9, function(i, slot)
		local index = i + 9
		slots[index] = slot
		bindSlotClick(slot, function(button)
			Net.send("invClick", "inv", index, button)
		end)
		attachTooltip(slot, function()
			local stack = State.slots[index]
			return itemLines(if stack then stack.id else nil)
		end)
	end)
	grid(frame, x, y + 3 * (SLOT + GAP) + 8, 9, 9, function(i, slot)
		slots[i] = slot
		bindSlotClick(slot, function(button)
			Net.send("invClick", "inv", i, button)
		end)
		attachTooltip(slot, function()
			local stack = State.slots[i]
			return itemLines(if stack then stack.id else nil)
		end)
	end)
	table.insert(refreshers, function()
		for index, slot in slots do
			IconRender.fill(slot, State.slots[index])
		end
	end)
end

local GRID_WIDTH = 9 * (SLOT + GAP) - GAP

function Windows.close()
	if current then
		current:Destroy()
	end
	if currentKind == "inventory" or currentKind == "chest" then
		Net.send("closeContainer")
	end
	current = nil
	currentKind = nil
	table.clear(refreshers)
	setTooltip(nil)
	Windows.onChanged(false)
end

function Windows.isOpen(): boolean
	return current ~= nil
end

function Windows.kind(): string?
	return currentKind
end

local function open(kind: string, frame: Frame)
	if current then
		current:Destroy()
		table.clear(refreshers)
	end
	current = frame
	currentKind = kind
	Windows.onChanged(true)
end

function Windows.refresh()
	for _, fn in refreshers do
		fn()
	end
end

function Windows.openInventory()
	local width = GRID_WIDTH + 24
	local frame = window("가방", width, 420)
	-- 갑옷 칸
	local armorSlots = {}
	for i, slotName in Items.ArmorSlots do
		local slot = Theme.slot(SLOT)
		slot.Position = UDim2.fromOffset(12, 34 + (i - 1) * (SLOT + GAP))
		slot.Parent = frame
		armorSlots[slotName] = slot
		bindSlotClick(slot, function()
			Net.send("invClick", "armor", slotName)
		end)
		attachTooltip(slot, function()
			local id = State.armor[slotName]
			local lines = itemLines(id)
			if not lines then
				local names = { helmet = "투구", chestplate = "흉갑", leggings = "레깅스", boots = "부츠" }
				return { '<font color="#AAAAAA">' .. names[slotName] .. " 칸</font>" }
			end
			return lines
		end)
	end
	create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12 + SLOT + 12, 40),
		Size = UDim2.fromOffset(GRID_WIDTH - SLOT - 12, 120),
		Font = Theme.Font,
		TextSize = 15,
		TextWrapped = true,
		RichText = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = C.Text,
		Text = "왼쪽 클릭: 집기/놓기\n오른쪽 클릭: 반만 집기, 하나 놓기\nShift + 클릭: 빠르게 옮기기\n갑옷을 왼쪽 칸에 넣으면 착용",
		Parent = frame,
	})
	table.insert(refreshers, function()
		for slotName, slot in armorSlots do
			local id = State.armor[slotName]
			IconRender.fill(slot, if id then { id = id, count = 1 } else nil)
		end
	end)
	playerInventory(frame, 12, 34 + 4 * (SLOT + GAP) + 28)
	open("inventory", frame)
	Windows.refresh()
end

function Windows.openChest(id: number, title: string, contents)
	State.chest = { id = id, title = title, slots = State.decode(contents) }
	local width = GRID_WIDTH + 24
	local frame = window(title, width, 390)
	local chestSlots = {}
	grid(frame, 12, 34, 27, 9, function(i, slot)
		chestSlots[i] = slot
		bindSlotClick(slot, function(button)
			Net.send("invClick", "chest", i, button)
		end)
		attachTooltip(slot, function()
			local stack = State.chest and State.chest.slots[i]
			return itemLines(if stack then stack.id else nil)
		end)
	end)
	table.insert(refreshers, function()
		local chest = State.chest
		for i, slot in chestSlots do
			IconRender.fill(slot, chest and chest.slots[i])
		end
	end)
	playerInventory(frame, 12, 34 + 3 * (SLOT + GAP) + 30)
	open("chest", frame)
	Windows.refresh()
end

function Windows.updateChest(id: number, contents)
	if State.chest and State.chest.id == id then
		State.chest.slots = State.decode(contents)
		Windows.refresh()
	end
end

local function costText(cost: Shop.Cost?): string
	if not cost then
		return ""
	end
	local def = Items.get(cost.item)
	local color = if def then hex(def.color) else "#FFFFFF"
	local have = 0
	for _, stack in State.slots do
		if stack and stack.id == cost.item then
			have += stack.count
		end
	end
	local name = if def then def.name else cost.item
	local mark = if have >= cost.amount then '<font color="#55FF55">살 수 있음</font>' else '<font color="#FF5555">부족함</font>'
	return string.format('가격: <font color="%s">%s %d개</font> (%s)', color, name, cost.amount, mark)
end

local function shopEntry(item: Shop.ShopItem, shop): (string, number, Shop.Cost?, { string })
	local team = shop.team or "red"
	local lore = {}
	if item.tiers and item.toolKind then
		local level = shop[item.toolKind] or 0
		local nextTier = item.tiers[level + 1]
		if not nextTier then
			local top = item.tiers[#item.tiers]
			return top.give, 1, nil, { '<font color="#55FF55">최고 단계입니다</font>' }
		end
		for _, line in item.lore or {} do
			table.insert(lore, line)
		end
		return nextTier.give, 1, nextTier.cost, lore
	end
	if item.armor then
		local order = { leather = 1, chain = 2, iron = 3, diamond = 4 }
		if order[item.armor] <= order[shop.armor or "leather"] then
			table.insert(lore, '<font color="#55FF55">이미 가지고 있음</font>')
		end
	end
	if item.permanent and shop.shears then
		table.insert(lore, '<font color="#55FF55">이미 가지고 있음</font>')
	end
	for _, line in item.lore or {} do
		table.insert(lore, line)
	end
	local id = item.icon or Shop.resolve(item.give or "", team)
	return Shop.resolve(id, team), item.count or 1, item.cost, lore
end

local function smallLabel(parent: Instance, x: number, y: number, w: number, text: string): TextLabel
	return create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, 16),
		Font = Theme.Font,
		TextSize = 13,
		RichText = true,
		TextColor3 = C.Text,
		Text = text,
		Parent = parent,
	}) :: TextLabel
end

local ROMAN = { "I", "II", "III", "IV", "V" }

-- 팀 강화(위 줄 6개) + 함정(아래 줄 4개) + 함정 줄(오른쪽 3칸)
local function openUpgrades(width: number)
	local frame = window("팀 강화와 함정 (다이아몬드)", width, 262)
	local BIG = SLOT + 8
	local STEP = BIG + 8
	local upgradeSlots, levelLabels = {}, {}
	heading(frame, '<font color="#555555">팀 강화</font>', 30, width)
	for i, upgrade in Shop.Upgrades do
		local slot = Theme.slot(BIG)
		slot.Position = UDim2.fromOffset(12 + (i - 1) * STEP, 52)
		slot.Parent = frame
		upgradeSlots[i] = slot
		levelLabels[i] = smallLabel(frame, 12 + (i - 1) * STEP, 52 + BIG + 2, BIG, "")
		slot.MouseButton1Click:Connect(function()
			Net.send("upgrade", upgrade.key)
		end)
		attachTooltip(slot, function()
			local s = State.shop or {}
			local level = (s.upgrades or {})[upgrade.key] or 0
			local lines = { string.format("%s (%d/%d단계)", upgrade.name, level, #upgrade.costs) }
			for n, line in upgrade.levels do
				local color = if n <= level then "#55FF55" elseif n == level + 1 then "#FFFFFF" else "#777777"
				local prefix = if #upgrade.levels > 1 then (ROMAN[n] or tostring(n)) .. "단계: " else ""
				table.insert(lines, string.format('<font color="%s">%s%s (다이아 %d)</font>', color, prefix, line, upgrade.costs[n] or 0))
			end
			local cost = upgrade.costs[level + 1]
			if cost then
				table.insert(lines, costText({ item = "diamond", amount = cost }))
				table.insert(lines, '<font color="#FFFF55">클릭해서 구매</font>')
			else
				table.insert(lines, '<font color="#55FF55">최고 단계입니다</font>')
			end
			return lines
		end)
	end

	local trapY = 52 + BIG + 26
	heading(frame, '<font color="#555555">함정 (적이 기지에 들어오면 하나씩 발동)</font>', trapY, width)
	local trapSlots = {}
	for i, trap in Shop.Traps do
		local slot = Theme.slot(BIG)
		slot.Position = UDim2.fromOffset(12 + (i - 1) * STEP, trapY + 22)
		slot.Parent = frame
		trapSlots[i] = slot
		slot.MouseButton1Click:Connect(function()
			Net.send("trap", trap.key)
		end)
		attachTooltip(slot, function()
			local s = State.shop or {}
			local queued = #(s.traps or {})
			local lines = { trap.name }
			for _, line in trap.lore do
				table.insert(lines, '<font color="#AAAAAA">' .. line .. "</font>")
			end
			local cost = Shop.trapCost(queued)
			if cost and queued < Shop.MaxTraps then
				table.insert(lines, costText({ item = "diamond", amount = cost }))
				table.insert(lines, '<font color="#AAAAAA">함정이 많을수록 다음 함정이 비싸져요 (1 → 2 → 4)</font>')
				table.insert(lines, '<font color="#FFFF55">클릭해서 줄에 넣기</font>')
			else
				table.insert(lines, '<font color="#FF5555">함정 줄이 가득 찼습니다</font>')
			end
			return lines
		end)
	end
	local queueX = 12 + #Shop.Traps * STEP + 12
	smallLabel(frame, queueX, trapY + 22 - 2, 3 * (SLOT + GAP), '<font color="#555555">함정 줄</font>').TextXAlignment = Enum.TextXAlignment.Left
	local queueSlots = {}
	for i = 1, Shop.MaxTraps do
		local slot = Theme.slot(SLOT)
		slot.Position = UDim2.fromOffset(queueX + (i - 1) * (SLOT + GAP), trapY + 22 + 14)
		slot.Parent = frame
		queueSlots[i] = slot
		attachTooltip(slot, function()
			local key = ((State.shop or {}).traps or {})[i]
			local trap = if key then Shop.getTrap(key) else nil
			if not trap then
				return { '<font color="#AAAAAA">빈 자리</font>' }
			end
			return { string.format("%d번째: %s", i, trap.name) }
		end)
	end
	heading(frame, '<font color="#555555">다이아몬드는 다이아몬드 섬 생성기에서 모아요.</font>', trapY + 22 + BIG + 10, width)

	table.insert(refreshers, function()
		local s = State.shop or {}
		for i, upgrade in Shop.Upgrades do
			IconRender.fill(upgradeSlots[i], { id = upgrade.icon, count = 1 })
			local level = (s.upgrades or {})[upgrade.key] or 0
			local maxed = level >= #upgrade.costs
			levelLabels[i].Text = string.format('<font color="%s">%d/%d</font>', if maxed then "#55FF55" else "#FFFFFF", level, #upgrade.costs)
			upgradeSlots[i].BackgroundColor3 = if maxed then C.SlotHover else C.Slot
		end
		for i, trap in Shop.Traps do
			IconRender.fill(trapSlots[i], { id = trap.icon, count = 1 })
		end
		for i, slot in queueSlots do
			local key = (s.traps or {})[i]
			local trap = if key then Shop.getTrap(key) else nil
			IconRender.fill(slot, if trap then { id = trap.icon, count = 1 } else nil)
		end
	end)
	open("upgrades", frame)
	Windows.refresh()
end

local SHOP_ROWS = 2

function Windows.openShop(kind: string, shop)
	State.shop = shop
	local width = GRID_WIDTH + 24
	if kind == "upgrades" then
		openUpgrades(width)
		return
	end

	local itemsY = 34 + SLOT + 28
	local frame = window("아이템 상점", width, itemsY + SHOP_ROWS * (SLOT + GAP) + 44)
	local tabs = {}
	for i, category in Shop.Categories do
		local tab = Theme.slot(SLOT)
		tab.Position = UDim2.fromOffset(12 + (i - 1) * (SLOT + GAP), 34)
		tab.Parent = frame
		tabs[i] = tab
		tab.MouseButton1Click:Connect(function()
			shopCategory = i
			Windows.refresh()
		end)
		attachTooltip(tab, function()
			return { category.name }
		end)
	end
	local itemSlots = {}
	for i = 1, 9 * SHOP_ROWS do
		local slot = Theme.slot(SLOT)
		local row = (i - 1) // 9
		local col = (i - 1) % 9
		slot.Position = UDim2.fromOffset(12 + col * (SLOT + GAP), itemsY + row * (SLOT + GAP))
		slot.Parent = frame
		itemSlots[i] = slot
		slot.MouseButton1Click:Connect(function()
			local category = Shop.Categories[shopCategory]
			local item = category and category.items[i]
			if item then
				Net.send("buy", item.key)
			end
		end)
		attachTooltip(slot, function()
			local category = Shop.Categories[shopCategory]
			local item = category and category.items[i]
			if not item then
				return nil
			end
			local id, count, cost, lore = shopEntry(item :: any, State.shop or {})
			local def = Items.get(id)
			local name = item.name or (if def then def.name else id)
			local lines = { if count > 1 then string.format("%s x%d", name, count) else name }
			for _, line in lore do
				table.insert(lines, '<font color="#AAAAAA">' .. line .. "</font>")
			end
			if not item.lore and def then
				for _, line in def.lore or {} do
					table.insert(lines, '<font color="#AAAAAA">' .. line .. "</font>")
				end
			end
			if cost then
				table.insert(lines, costText(cost))
				table.insert(lines, '<font color="#FFFF55">클릭해서 구매</font>')
			end
			return lines
		end)
	end
	local categoryLabel = heading(frame, "", 34 + SLOT + 6, width)
	heading(frame, '<font color="#555555">철·금은 우리 섬, 다이아·에메랄드는 생성기 섬에서 모아요.</font>', itemsY + SHOP_ROWS * (SLOT + GAP) + 10, width)
	table.insert(refreshers, function()
		local s = State.shop or {}
		for i, category in Shop.Categories do
			IconRender.fill(tabs[i], { id = Shop.resolve(category.icon, s.team), count = 1 })
			tabs[i].BackgroundColor3 = if i == shopCategory then C.SlotHover else C.Slot
		end
		local category = Shop.Categories[shopCategory]
		categoryLabel.Text = category.name
		for i, slot in itemSlots do
			local item = category.items[i]
			if item then
				local id, count = shopEntry(item :: any, s)
				IconRender.fill(slot, { id = id, count = count })
				slot.Visible = true
			else
				slot.Visible = false
			end
		end
	end)
	open("shop", frame)
	Windows.refresh()
end

-- 스카이워즈 키트/능력 고르기 (대기실에서 상자 아이템 우클릭)
function Windows.openKits()
	local width = GRID_WIDTH + 24
	local BIG = SLOT + 8
	local STEP = BIG + 8
	local perRow = 6
	local kitRows = math.ceil(#Kits.List / perRow)
	local perkY = 52 + kitRows * (BIG + 22) + 6
	local frame = window("키트와 능력 고르기", width, perkY + 22 + BIG + 52)
	heading(frame, '<font color="#555555">키트: 유리관이 열릴 때 받는 시작 장비</font>', 30, width)
	local kitSlots, perkSlots = {}, {}
	for i, kit in Kits.List do
		local row = (i - 1) // perRow
		local col = (i - 1) % perRow
		local slot = Theme.slot(BIG)
		slot.Position = UDim2.fromOffset(12 + col * STEP, 52 + row * (BIG + 22))
		slot.Parent = frame
		kitSlots[i] = slot
		smallLabel(frame, 12 + col * STEP - 4, 52 + row * (BIG + 22) + BIG + 2, BIG + 8, kit.name)
		slot.MouseButton1Click:Connect(function()
			Net.send("kit", kit.id, nil)
		end)
		attachTooltip(slot, function()
			local lines = { kit.name }
			for _, line in kit.lore do
				table.insert(lines, '<font color="#AAAAAA">' .. line .. "</font>")
			end
			table.insert(lines, if State.kit.kit == kit.id then '<font color="#55FF55">선택됨</font>' else '<font color="#FFFF55">클릭해서 고르기</font>')
			return lines
		end)
	end
	heading(frame, '<font color="#555555">능력: 게임 내내 붙는 효과 (하나만)</font>', perkY, width)
	for i, perk in Kits.Perks do
		local slot = Theme.slot(BIG)
		slot.Position = UDim2.fromOffset(12 + (i - 1) * STEP, perkY + 22)
		slot.Parent = frame
		perkSlots[i] = slot
		slot.MouseButton1Click:Connect(function()
			Net.send("kit", nil, perk.id)
		end)
		attachTooltip(slot, function()
			local lines = { perk.name }
			for _, line in perk.lore do
				table.insert(lines, '<font color="#AAAAAA">' .. line .. "</font>")
			end
			table.insert(lines, if State.kit.perk == perk.id then '<font color="#55FF55">선택됨</font>' else '<font color="#FFFF55">클릭해서 고르기</font>')
			return lines
		end)
	end
	local summary = heading(frame, "", perkY + 22 + BIG + 12, width)
	table.insert(refreshers, function()
		for i, kit in Kits.List do
			IconRender.fill(kitSlots[i], { id = kit.icon, count = 1 })
			kitSlots[i].BackgroundColor3 = if State.kit.kit == kit.id then C.SlotHover else C.Slot
		end
		for i, perk in Kits.Perks do
			IconRender.fill(perkSlots[i], { id = perk.icon, count = 1 })
			perkSlots[i].BackgroundColor3 = if State.kit.perk == perk.id then C.SlotHover else C.Slot
		end
		local kit = Kits.get(State.kit.kit)
		local perk = Kits.getPerk(State.kit.perk)
		summary.Text = string.format(
			'고른 키트: <font color="#00AA00">%s</font>  ·  능력: <font color="#0088AA">%s</font>',
			if kit then kit.name else "-",
			if perk then perk.name else "-"
		)
	end)
	open("kits", frame)
	Windows.refresh()
end

function Windows.updateKits()
	if currentKind == "kits" then
		Windows.refresh()
	end
end

function Windows.updateShop(shop)
	State.shop = shop
	if currentKind == "shop" or currentKind == "upgrades" then
		Windows.refresh()
	end
end

function Windows.openVote()
	local vote = State.vote
	if not vote then
		return
	end
	local count = #vote.maps
	local width = 420
	local frame = window("맵 선택 (VIP)", width, 70 + count * 58 + 70)
	local buttons = {}
	for i, map in vote.maps do
		local button = Theme.button("", {
			Position = UDim2.fromOffset(16, 40 + (i - 1) * 58),
			Size = UDim2.fromOffset(width - 32, 50),
			Parent = frame,
		})
		buttons[i] = button
		button.MouseButton1Click:Connect(function()
			Net.send("vote", map.id)
		end)
	end
	local footer = heading(frame, "", 44 + count * 58, width)
	local vipButton = Theme.button("VIP 패키지 보기", {
		Position = UDim2.fromOffset(16, 70 + count * 58),
		Size = UDim2.fromOffset(width - 32, 36),
		BackgroundColor3 = Color3.fromRGB(200, 150, 30),
		Parent = frame,
	})
	vipButton.MouseButton1Click:Connect(function()
		Windows.openStore()
	end)
	table.insert(refreshers, function()
		local v = State.vote
		if not v then
			return
		end
		vipButton.Visible = not v.canVote and not v.locked
		for i, map in v.maps do
			local button = buttons[i]
			if button then
				local label = button:FindFirstChild("Label") :: TextLabel?
				local mark = if v.mine == map.id then '<font color="#55FF55">▶ </font>' else ""
				local chosen = if v.chosen == map.id then ' <font color="#FFFF55">[선택됨]</font>' else ""
				if label then
					label.Text = string.format("%s%s  <font color=\"#FFFF55\">%d표</font>%s", mark, map.name, map.votes, chosen)
				end
			end
		end
		if v.locked then
			footer.Text = '<font color="#AA0000">맵이 정해졌습니다</font>'
		elseif v.canVote then
			footer.Text = '<font color="#555555">VIP 가 고른 맵에서 게임을 합니다 (아무도 안 고르면 무작위)</font>'
		else
			footer.Text = '<font color="#AA6600">맵은 무작위로 정해집니다. VIP 는 원하는 맵을 고를 수 있어요.</font>'
		end
	end)
	open("vote", frame)
	Windows.refresh()
end

function Windows.openGames()
	local width = 3 * 140 + 40
	local frame = window("미니게임 선택", width, 250)
	local labels = {}
	for i, modeId in Config.ModeOrder do
		local mode = Config.Modes[modeId]
		local x = 16 + (i - 1) * 140
		local slot = Theme.slot(64)
		slot.Position = UDim2.fromOffset(x + 34, 40)
		slot.Parent = frame
		IconRender.fill(slot, { id = if modeId == "bedwars" then "leave_bed" elseif modeId == "skywars" then "iron_sword" else "tnt", count = 1 })
		slot.MouseButton1Click:Connect(function()
			Net.send("join", modeId)
			Windows.close()
		end)
		attachTooltip(slot, function()
			return { mode.name, '<font color="#AAAAAA">' .. mode.description .. "</font>", '<font color="#FFFF55">클릭해서 참가</font>' }
		end)
		create("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(x, 110),
			Size = UDim2.fromOffset(132, 22),
			Font = Theme.Font,
			TextSize = 18,
			TextColor3 = C.Text,
			Text = mode.name,
			Parent = frame,
		})
		labels[modeId] = create("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(x, 134),
			Size = UDim2.fromOffset(132, 40),
			Font = Theme.Font,
			TextSize = 14,
			TextWrapped = true,
			TextColor3 = C.Text,
			Text = "",
			Parent = frame,
		})
		local join = Theme.button("참가", {
			Position = UDim2.fromOffset(x + 16, 182),
			Size = UDim2.fromOffset(100, 34),
			Parent = frame,
		})
		join.MouseButton1Click:Connect(function()
			Net.send("join", modeId)
			Windows.close()
		end)
	end
	table.insert(refreshers, function()
		for modeId, label in labels do
			local info = State.lobbyInfo[modeId]
			label.Text = if info then string.format("대기 %d명\n게임 중 %d명", info.waiting, info.playing) else ""
		end
	end)
	open("games", frame)
	Windows.refresh()
end

----------------------------------------------------------------------------
-- 상점 (게임패스)
----------------------------------------------------------------------------
local function card(parent: Instance, x: number, y: number, w: number, h: number): Frame
	local f = create("Frame", {
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = Color3.fromRGB(170, 170, 170),
		BorderSizePixel = 0,
		Parent = parent,
	})
	create("UIStroke", { Color = Color3.fromRGB(85, 85, 85), Thickness = 2, Parent = f })
	return f
end

local function text(parent: Instance, value: string, x: number, y: number, w: number, h: number, size: number, color: Color3?)
	return create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, h),
		Font = Theme.Font,
		TextSize = size,
		TextWrapped = true,
		RichText = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = color or C.Text,
		Text = value,
		Parent = parent,
	})
end

function Windows.openStore()
	local width = 16 + #Config.PassOrder * 272
	local frame = window("상점", width, 340)
	local buttons = {}
	local prices = {}
	for i, key in Config.PassOrder do
		local pass = Config.Passes[key]
		local c = card(frame, 16 + (i - 1) * 272, 40, 256, 284)
		local slot = Theme.slot(56)
		slot.Position = UDim2.fromOffset(10, 10)
		slot.Parent = c
		local icon = IconRender.draw(pass.icon, pass.color)
		icon.Parent = slot:FindFirstChild("Icon")
		text(c, pass.name, 76, 12, 170, 24, 20, C.Text)
		prices[key] = text(c, "", 76, 38, 170, 22, 18, Color3.fromRGB(30, 120, 30))
		for j, perk in pass.perks do
			text(c, "· " .. perk, 12, 76 + (j - 1) * 40, 236, 38, 16, C.Text)
		end
		local button = Theme.button("", {
			Position = UDim2.fromOffset(12, 232),
			Size = UDim2.fromOffset(232, 40),
			BackgroundColor3 = Color3.fromRGB(60, 140, 60),
			Parent = c,
		})
		buttons[key] = button
		button.MouseButton1Click:Connect(function()
			local info = State.passes[key]
			if info and info.owned then
				if key == "skin" then
					Windows.openSkins()
				end
			else
				Net.send("buyPass", key)
			end
		end)
	end
	table.insert(refreshers, function()
		for _, key in Config.PassOrder do
			local info = State.passes[key]
			local pass = Config.Passes[key]
			local price = if info then info.price else pass.price
			prices[key].Text = string.format("R$ %d", price)
			local label = buttons[key]:FindFirstChild("Label") :: TextLabel?
			local value
			if info and info.owned then
				value = if key == "skin" then "스킨 꾸미기" else '<font color="#FFFF55">보유 중</font>'
			elseif info and not info.available then
				value = "준비 중"
			elseif info and info.studioTest then
				value = "구매 (스튜디오 시험)"
			else
				value = string.format("구매  R$ %d", price)
			end
			if label then
				label.Text = value
			end
		end
	end)
	open("store", frame)
	Net.send("passes")
	Windows.refresh()
end

----------------------------------------------------------------------------
-- 스킨 꾸미기
----------------------------------------------------------------------------
function Windows.openSkins()
	local width, height = 640, 430
	local frame = window("스킨 꾸미기", width, height)
	local draft = Skins.decode(if State.skinCode ~= "" then State.skinCode else Skins.DefaultCode)

	-- 미리보기 인형 (천천히 돌아감)
	local viewport = create("ViewportFrame", {
		Position = UDim2.fromOffset(16, 40),
		Size = UDim2.fromOffset(200, 300),
		BackgroundColor3 = Color3.fromRGB(130, 178, 230),
		Ambient = Color3.fromRGB(170, 170, 170),
		LightColor = Color3.new(1, 1, 1),
		LightDirection = Vector3.new(-1, -1, 1),
		Parent = frame,
	})
	create("UIStroke", { Color = C.SlotDark, Thickness = 2, Parent = viewport })
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	camera.CFrame = CFrame.lookAt(Vector3.new(0, 3.2, -12), Vector3.new(0, 2.6, 0))
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	local doll = CharacterRig.build(CFrame.new(0, 3, 0), false)
	doll.Parent = viewport
	local angle = 0
	local spin
	spin = RunService.RenderStepped:Connect(function(dt)
		if not frame.Parent then
			spin:Disconnect()
			return
		end
		angle += dt * 0.8
		doll:PivotTo(CFrame.new(0, 3, 0) * CFrame.Angles(0, math.sin(angle) * 0.9, 0))
	end)

	local swatches: { [string]: { [string]: GuiObject } } = {}
	local styleButtons: { [string]: { [string]: TextButton } } = {}
	local status = text(frame, "", 232, 350, 392, 22, 16, C.Text)
	local save = Theme.button("", {
		Position = UDim2.fromOffset(232, 380),
		Size = UDim2.fromOffset(250, 36),
		BackgroundColor3 = Color3.fromRGB(60, 140, 60),
		Parent = frame,
	})
	local reset = Theme.button("기본으로", {
		Position = UDim2.fromOffset(492, 380),
		Size = UDim2.fromOffset(132, 36),
		Parent = frame,
	})

	local function owned(): boolean
		local info = State.passes.skin
		return info ~= nil and info.owned
	end

	local function render()
		local code = Skins.encode(draft)
		CharacterVisuals.applySkin(doll, code)
		for key, list in swatches do
			for hex, swatch in list do
				local stroke = swatch:FindFirstChildOfClass("UIStroke")
				if stroke then
					local selected = (draft :: any)[key] == hex
					stroke.Color = if selected then Color3.new(1, 1, 1) else Color3.fromRGB(40, 40, 40)
					stroke.Thickness = if selected then 3 else 1
				end
			end
		end
		for key, list in styleButtons do
			for value, button in list do
				button.BackgroundColor3 = if (draft :: any)[key] == value then Color3.fromRGB(60, 120, 60) else C.Button
			end
		end
		local saveLabel = save:FindFirstChild("Label") :: TextLabel?
		local isDefault = code == Skins.DefaultCode
		if saveLabel then
			if owned() or isDefault then
				saveLabel.Text = if code == State.skinCode then "저장됨" else "저장하기"
			else
				local info = State.passes.skin
				saveLabel.Text = string.format("구매하고 저장 (R$ %d)", if info then info.price else Config.Passes.skin.price)
			end
		end
		status.Text = if owned()
			then '<font color="#1E7A1E">커스텀 스킨 패스 보유 중</font>'
			else '<font color="#8A5A00">입어 보기는 무료! 저장하려면 커스텀 스킨 패스가 필요해요.</font>'
	end

	-- 색 고르기 줄
	for row, key in Skins.ColorOrder do
		local y = 40 + (row - 1) * 30
		text(frame, Skins.ColorNames[key], 232, y + 3, 64, 22, 16, C.Text)
		swatches[key] = {}
		for i, hex in Skins.Palettes[key] do
			local swatch = create("TextButton", {
				AutoButtonColor = false,
				Text = "",
				BackgroundColor3 = Color3.fromHex(hex),
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(300 + (i - 1) * 27, y),
				Size = UDim2.fromOffset(24, 24),
				Parent = frame,
			})
			create("UIStroke", { Color = Color3.fromRGB(40, 40, 40), Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = swatch })
			swatches[key][hex] = swatch
			swatch.MouseButton1Click:Connect(function()
				(draft :: any)[key] = hex
				render()
			end)
		end
	end
	-- 모양 고르기 줄
	local styleRows = {
		{ key = "hairStyle", label = "머리", values = Skins.HairStyles, names = Skins.HairStyleNames },
		{ key = "shirtStyle", label = "옷 모양", values = Skins.ShirtStyles, names = Skins.ShirtStyleNames },
	}
	for row, info in styleRows do
		local y = 222 + (row - 1) * 36
		text(frame, info.label, 232, y + 6, 64, 22, 16, C.Text)
		styleButtons[info.key] = {}
		for i, value in info.values do
			local button = Theme.button(info.names[value], {
				Position = UDim2.fromOffset(300 + (i - 1) * 82, y),
				Size = UDim2.fromOffset(78, 30),
				Parent = frame,
			})
			styleButtons[info.key][value] = button
			button.MouseLeave:Connect(function()
				render()
			end)
			button.MouseButton1Click:Connect(function()
				(draft :: any)[info.key] = value
				render()
			end)
		end
	end
	-- 프리셋
	text(frame, "프리셋", 232, 300, 64, 22, 16, C.Text)
	for i, preset in Skins.Presets do
		local button = Theme.button(preset.name, {
			Position = UDim2.fromOffset(300 + (i - 1) * 66, 296),
			Size = UDim2.fromOffset(62, 30),
			Parent = frame,
		})
		button.MouseButton1Click:Connect(function()
			draft = Skins.sanitize(preset.skin :: any)
			render()
		end)
	end

	save.MouseButton1Click:Connect(function()
		local code = Skins.encode(draft)
		if owned() or code == Skins.DefaultCode then
			Net.send("setSkin", code)
		else
			Net.send("buyPass", "skin")
		end
	end)
	reset.MouseButton1Click:Connect(function()
		draft = Skins.decode(Skins.DefaultCode)
		render()
	end)

	table.insert(refreshers, render)
	open("skins", frame)
	Net.send("passes")
	render()
end

----------------------------------------------------------------------------
-- 설정
----------------------------------------------------------------------------
function Windows.openSettings()
	local items = Preferences.Items
	local width = 460
	local frame = window("설정", width, 50 + #items * 40 + 56)
	local buttons = {}
	for i, item in items do
		local y = 40 + (i - 1) * 40
		text(frame, item.name, 18, y + 6, 220, 24, 18, C.Text)
		local button = Theme.button("", {
			Position = UDim2.fromOffset(240, y),
			Size = UDim2.fromOffset(200, 34),
			Parent = frame,
		})
		buttons[item.key] = button
		button.MouseButton1Click:Connect(function()
			if item.vip and not (State.passes.vip and State.passes.vip.owned) then
				Windows.openStore()
				return
			end
			local current = State.settings[item.key]
			local index = table.find(item.choices, current) or 1
			local nextValue = item.choices[index % #item.choices + 1]
			Windows.onSetting(item.key, nextValue)
			Windows.refresh()
		end)
	end
	local flyButton = Theme.button("지금 날기 / 내려오기", {
		Position = UDim2.fromOffset(18, 50 + #items * 40),
		Size = UDim2.fromOffset(width - 36, 36),
		BackgroundColor3 = Color3.fromRGB(200, 150, 30),
		Parent = frame,
	})
	flyButton.MouseButton1Click:Connect(function()
		Windows.onFlyToggle()
	end)
	table.insert(refreshers, function()
		local vip = State.passes.vip and State.passes.vip.owned
		for _, item in items do
			local label = buttons[item.key]:FindFirstChild("Label") :: TextLabel?
			if label then
				if item.vip and not vip then
					label.Text = '<font color="#FFD24A">VIP 전용</font>'
				else
					label.Text = tostring(item.labels[State.settings[item.key]] or State.settings[item.key])
				end
			end
		end
		flyButton.Visible = vip == true and State.context.location == "lobby" and State.settings.fly ~= false
	end)
	open("settings", frame)
	Windows.refresh()
end

function Windows.init(parent: ScreenGui)
	gui = parent
	layer = create("Frame", {
		Name = "Windows",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 10,
		Parent = gui,
	})
	tooltip = create("Frame", {
		Name = "Tooltip",
		BackgroundColor3 = C.Tooltip,
		BackgroundTransparency = 0.05,
		BorderSizePixel = 0,
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.fromOffset(0, 0),
		Visible = false,
		ZIndex = 40,
		Parent = gui,
	})
	create("UIStroke", { Color = C.TooltipBorder, Thickness = 2, Parent = tooltip })
	create("UIPadding", {
		PaddingLeft = UDim.new(0, 6),
		PaddingRight = UDim.new(0, 6),
		PaddingTop = UDim.new(0, 4),
		PaddingBottom = UDim.new(0, 4),
		Parent = tooltip,
	})
	tooltipLabel = create("TextLabel", {
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.fromOffset(0, 0),
		Font = Theme.Font,
		TextSize = 16,
		RichText = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = C.White,
		Text = "",
		ZIndex = 41,
		Parent = tooltip,
	})
	cursorIcon = create("Frame", {
		Name = "Cursor",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(SLOT, SLOT),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Visible = false,
		ZIndex = 45,
		Parent = gui,
	})
	create("Frame", { Name = "Icon", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = cursorIcon })
	Theme.label("", {
		Name = "Count",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -2, 1, -1),
		Size = UDim2.new(1, -2, 0.42, 0),
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = cursorIcon,
	})

	RunService.RenderStepped:Connect(function()
		local mouse = UserInputService:GetMouseLocation()
		local uiScale = gui:FindFirstChildOfClass("UIScale")
		local s = if uiScale then uiScale.Scale else 1
		local pos = UDim2.fromOffset(mouse.X / s, mouse.Y / s)
		tooltip.Position = pos + UDim2.fromOffset(16, 8)
		cursorIcon.Position = pos
		cursorIcon.Visible = current ~= nil and State.cursor ~= nil
	end)
	State.listen("inv", function()
		IconRender.fill(cursorIcon, State.cursor)
		Windows.refresh()
	end)
end

return Windows
