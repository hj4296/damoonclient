	Refills = { 180, 360 },
	TimeLimit = 600,
	LuckyChance = 0.6, -- 섬마다 럭키 블록이 놓일 확률(맵 표시 자리마다)
}

Config.TntRun = {
	StartDelay = 5,
	RemoveDelay = 0.35,
	DoubleJumps = 3,
	DoubleJumpPower = 42,
	TimeLimit = 600,
}

-- 게임패스: 크리에이터 대시보드(create.roblox.com) → 내 게임 → 수익 창출 → 패스 에서 만들고,
-- 받은 숫자 ID 를 id 에 적으세요. 실제 가격은 대시보드에서 정한 값이 쓰이고, price 는 ID 가 없을 때 보여 줄 값입니다.
