})

-- 양털 (팀 색 + 장식 색), 테라코타, 콘크리트(색 블록), 카펫
local DYES: { [string]: Color3 } = {
	white = rgb(234, 236, 236),
	black = rgb(30, 30, 36),
	gray = rgb(80, 84, 88),
	brown = rgb(116, 74, 42),
	red = rgb(176, 46, 38),
	orange = rgb(236, 120, 24),
	yellow = rgb(246, 196, 40),
	lime = rgb(110, 184, 26),
	green = rgb(84, 110, 28),
	cyan = rgb(22, 144, 152),
	blue = rgb(52, 56, 168),
	purple = rgb(122, 44, 170),
	pink = rgb(236, 140, 172),
}
Blocks.Dyes = DYES
for name, color in DYES do
	add("wool_" .. name, { name = "양털", color = color, hardness = 0.7, tool = "shears", tex = "wool_" .. name })
	add("terracotta_" .. name, { name = "테라코타", color = color:Lerp(rgb(150, 95, 70), 0.45), hardness = 1.4, tool = "pickaxe", tex = "terracotta_" .. name })
	add("carpet_" .. name, { name = "카펫", color = color, hardness = 0.1, shape = "carpet", canCollide = false, tex = "wool_" .. name })
end
add("petals", { name = "꽃잎", color = rgb(244, 178, 210), hardness = 0.05, shape = "carpet", canCollide = false, noItem = true, tex = "petals" })

-- 팀 블록: 양털은 Config 팀 색을 따르고, 점토와 침대도 팀마다
for _, team in Config.Teams do
	local wool = defs["wool_" .. team.id]
	if wool then
		wool.name = team.name .. " 양털"
		wool.team = team.id
		wool.color = team.color
	else
		add("wool_" .. team.id, { name = team.name .. " 양털", color = team.color, hardness = 0.7, tool = "shears", team = team.id })
	end
	add("clay_" .. team.id, {
		name = team.name .. " 단단한 점토",
		color = team.color:Lerp(rgb(150, 95, 70), 0.35),
		hardness = 1.6,
		tool = "pickaxe",
		team = team.id,
		tex = "terracotta_" .. team.id,
	})
	add("bed_" .. team.id, {
		name = team.name .. " 침대",
		color = team.color,
		hardness = 0.4,
		bed = true,
		team = team.id,
		noItem = true,
		blastProof = true,
		shape = "bed",
		tex = { top = "wool_" .. team.id, side = "bed_side", bottom = "planks" },
	})
end
Blocks.TeamTextureColors = {}
for _, team in Config.Teams do
	Blocks.TeamTextureColors[team.id] = team.color
end

-- TNT 런 바닥 색 블록
local COLORS = {
	{ "white", "흰색", rgb(232, 234, 235) },
	{ "black", "검은색", rgb(30, 32, 38) },
	{ "red", "빨간색", rgb(196, 40, 40) },
	{ "orange", "주황색", rgb(236, 120, 20) },
	{ "yellow", "노란색", rgb(242, 196, 30) },
	{ "lime", "연두색", rgb(110, 186, 30) },
	{ "cyan", "청록색", rgb(22, 140, 150) },
	{ "blue", "파란색", rgb(46, 52, 160) },
	{ "purple", "보라색", rgb(112, 36, 160) },
	{ "pink", "분홍색", rgb(220, 112, 150) },
}
Blocks.ColorNames = {}
Blocks.ColorValues = {}
for _, entry in COLORS do
	add("color_" .. entry[1], { name = entry[2] .. " 콘크리트", color = entry[3], hardness = 0.6, tex = "concrete_" .. entry[1] })
	table.insert(Blocks.ColorNames, entry[1])
	Blocks.ColorValues[entry[1]] = entry[3]
end

-- 반 블록 (아래/위)
for _, base in { "planks", "dark_planks", "birch_planks", "cherry_planks", "stone_bricks", "polished_stone", "sandstone", "smooth_sandstone", "red_sandstone", "quartz", "bricks", "cobble", "dark_bricks", "basalt" } do
	local d = defs[base]
	for _, variant in { "slab", "slab_top" } do
		add(base .. "_" .. variant, {
			name = d.name .. " 반 블록",
			color = d.color,
			hardness = d.hardness,
			tool = d.tool,
			shape = variant,
			tex = d.tex,
			noItem = variant == "slab_top",
		})
	end
end

-- 울타리, 담장
add("fence", { name = "울타리", color = rgb(162, 130, 80), hardness = 1, tool = "axe", shape = "fence", tex = "planks" })
add("dark_fence", { name = "짙은 울타리", color = rgb(88, 62, 38), hardness = 1, tool = "axe", shape = "fence", tex = "dark_planks" })
add("cobble_wall", { name = "조약돌 담장", color = rgb(115, 115, 115), hardness = 2, tool = "pickaxe", shape = "wall", tex = "cobble" })
add("sandstone_wall", { name = "사암 담장", color = rgb(214, 198, 144), hardness = 1.2, tool = "pickaxe", shape = "wall", tex = "sandstone_top" })
add("quartz_wall", { name = "석영 담장", color = rgb(234, 228, 220), hardness = 1.2, tool = "pickaxe", shape = "wall", tex = "quartz" })

-- 조명
add("lantern", { name = "랜턴", color = rgb(255, 196, 110), hardness = 0.3, shape = "lantern", canCollide = false, light = 14, lightColor = rgb(255, 190, 120), material = M.Neon, tex = false, noItem = true })
add("soul_lantern", { name = "푸른 랜턴", color = rgb(120, 220, 230), hardness = 0.3, shape = "lantern", canCollide = false, light = 12, lightColor = rgb(120, 220, 240), material = M.Neon, tex = false, noItem = true })
add("torch", { name = "횃불", color = rgb(120, 86, 50), hardness = 0.05, shape = "torch", canCollide = false, light = 12, lightColor = rgb(255, 170, 80), tex = false, noItem = true })

-- 꽃과 풀 (작은 장식, 통과 가능)
local FLOWERS = {
	flower_red = rgb(220, 40, 40),
	flower_yellow = rgb(250, 220, 50),
	flower_blue = rgb(70, 110, 230),
	flower_white = rgb(245, 245, 245),
	flower_pink = rgb(245, 150, 200),
	flower_purple = rgb(160, 80, 220),
}
for id, color in FLOWERS do
	add(id, { name = "꽃", color = rgb(60, 140, 40), bloom = color, hardness = 0.02, shape = "plant", canCollide = false, tex = false, noItem = true })
end
add("tall_grass", { name = "풀", color = rgb(84, 150, 52), hardness = 0.02, shape = "grass", canCollide = false, tex = false, noItem = true })
add("dead_bush", { name = "마른 덤불", color = rgb(140, 100, 52), hardness = 0.02, shape = "grass", canCollide = false, tex = false, noItem = true })
add("fern", { name = "고사리", color = rgb(60, 120, 50), hardness = 0.02, shape = "grass", canCollide = false, tex = false, noItem = true })
add("small_mushroom", { name = "작은 버섯", color = rgb(220, 210, 190), bloom = rgb(200, 40, 40), hardness = 0.02, shape = "plant", canCollide = false, tex = false, noItem = true })

-- 팀 색 양털/침대 등은 위에서 만들었고, 그 밖의 팀 이름(red 등)은 DYES 와 겹칩니다.

function Blocks.get(id: string): BlockDef?
	return defs[id]
end

function Blocks.exists(id: string): boolean
	return defs[id] ~= nil
end

-- 면 이름(top/bottom/side/front)에 맞는 텍스처 이름
function Blocks.faceTexture(def: BlockDef, face: string): string?
	local tex = def.tex
	if tex == false or tex == nil then
		return nil
	end
	if type(tex) == "string" then
		return tex
	end
	if face == "front" then
		return tex.front or tex.side
	end
	return tex[face] or tex.side
end

-- 블록 위치마다 색을 살짝 다르게 해서 텍스처가 없을 때도 픽셀 블록 느낌을 냅니다.
function Blocks.shade(def: BlockDef, x: number, y: number, z: number): Color3
	local h = (x * 73856093 + y * 19349663 + z * 83492791) % 1000
	local t = h / 1000
	local color = def.color
	if t < 0.5 then
		return color:Lerp(Color3.new(0, 0, 0), (0.5 - t) * 0.14)
	end
	return color:Lerp(Color3.new(1, 1, 1), (t - 0.5) * 0.1)
end

return Blocks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">CharacterRig</string>
          <string name="Source"><![CDATA[-- 블록 캐릭터 몸 (R6 방식 관절). 머리 정육면체, 얇은 몸통, 네모난 팔다리.
-- 서버는 이걸 StarterPlayer.StarterCharacter 로 넣어 모든 플레이어가 이 몸으로 태어나게 하고,
-- 클라이언트는 스킨 미리보기 인형으로도 씁니다. 다리 2스터드 + 몸통 2스터드라 일반 R6 와 서 있는 높이가 같습니다.
local Skins = require(script.Parent.Skins)

local CharacterRig = {}

local P = Skins.PixelStuds

local function size(partName: string): Vector3
	local d = Skins.Parts[partName]
	return Vector3.new(d[1] * P, d[2] * P, d[3] * P)
end

CharacterRig.Sizes = {
	Head = size("Head"),
	Torso = size("Torso"),
	Arm = size("Left Arm"),
	Leg = size("Left Leg"),
}

local function part(model: Model, name: string, partSize: Vector3, cframe: CFrame, collide: boolean): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = partSize
	p.CFrame = cframe
	p.CanCollide = collide
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Color = Color3.fromRGB(200, 200, 200)
	p.Parent = model
	return p
end

local function motor(name: string, parent: BasePart, part0: BasePart, part1: BasePart, c0: CFrame, c1: CFrame): Motor6D
	local m = Instance.new("Motor6D")
	m.Name = name
	m.Part0 = part0
	m.Part1 = part1
	m.C0 = c0
	m.C1 = c1
	m.Parent = parent
	return m
end

-- origin: HumanoidRootPart 위치 (발바닥에서 3스터드 위)
function CharacterRig.build(origin: CFrame?, withHumanoid: boolean?): Model
	local base = origin or CFrame.new(0, 3, 0)
	local S = CharacterRig.Sizes
	local model = Instance.new("Model")
	model.Name = "StarterCharacter"

	local root = part(model, "HumanoidRootPart", S.Torso, base, false)
	root.Transparency = 1
	local torso = part(model, "Torso", S.Torso, base, true)
	local head = part(model, "Head", S.Head, base * CFrame.new(0, S.Torso.Y / 2 + S.Head.Y / 2, 0), true)
	local armX = S.Torso.X / 2 + S.Arm.X / 2
	local rightArm = part(model, "Right Arm", S.Arm, base * CFrame.new(armX, 0, 0), false)
	local leftArm = part(model, "Left Arm", S.Arm, base * CFrame.new(-armX, 0, 0), false)
	local legX = S.Leg.X / 2
	local legY = -S.Torso.Y / 2 - S.Leg.Y / 2
	local rightLeg = part(model, "Right Leg", S.Leg, base * CFrame.new(legX, legY, 0), false)
	local leftLeg = part(model, "Left Leg", S.Leg, base * CFrame.new(-legX, legY, 0), false)

	motor("RootJoint", root, root, torso, CFrame.identity, CFrame.identity)
	motor("Neck", torso, torso, head, CFrame.new(0, S.Torso.Y / 2, 0), CFrame.new(0, -S.Head.Y / 2, 0))
	local shoulderY = S.Torso.Y / 2 - S.Arm.X / 2
	local armPivot = S.Arm.Y / 2 - S.Arm.X / 2
	motor("Right Shoulder", torso, torso, rightArm, CFrame.new(armX, shoulderY, 0), CFrame.new(0, armPivot, 0))
	motor("Left Shoulder", torso, torso, leftArm, CFrame.new(-armX, shoulderY, 0), CFrame.new(0, armPivot, 0))
	motor("Right Hip", torso, torso, rightLeg, CFrame.new(legX, -S.Torso.Y / 2, 0), CFrame.new(0, S.Leg.Y / 2, 0))
	motor("Left Hip", torso, torso, leftLeg, CFrame.new(-legX, -S.Torso.Y / 2, 0), CFrame.new(0, S.Leg.Y / 2, 0))

	if withHumanoid ~= false then
		local humanoid = Instance.new("Humanoid")
		humanoid.RigType = Enum.HumanoidRigType.R6
		humanoid.HipHeight = 0
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.Parent = model
	end
	model.PrimaryPart = root
	model:SetAttribute("BlockRig", true)
	return model
end

CharacterRig.BodyParts = { "Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg" }

return CharacterRig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- 게임 전체 설정. 숫자를 바꾸면 바로 게임 밸런스가 바뀝니다.
local Config = {}

Config.GameName = "블록 아레나"
Config.Version = "1.1.0"

-- 블록 한 칸의 크기(스터드). 캐릭터 키(약 5스터드)와 비교해 마인크래프트 비율에 맞춘 값입니다.
Config.BlockSize = 3

-- 로비와 경기장 위치. 경기장은 동시에 여러 개가 열릴 수 있어서 X축으로 띄워 놓습니다.
Config.LobbyOrigin = Vector3.new(0, 60, 0)
Config.ArenaBase = Vector3.new(2400, 160, 0)
Config.ArenaSpacing = 1200
Config.MaxArenas = 10

Config.DataStoreName = "BlockArena_v1"

Config.Movement = {
	Walk = 16,
	Sprint = 21,
	Sneak = 5,
	JumpHeight = 4.4, -- 1칸은 올라가고 2칸은 못 올라가는 높이
	Gravity = 130,
}

Config.Reach = {
	Attack = 10.5, -- 클라이언트가 공격을 시도하는 거리
	AttackServer = 14, -- 서버가 허용하는 거리(지연 보정 포함)
	Block = 15,
	BlockServer = 20,
}

Config.Combat = {
	HurtTime = 0.45, -- 맞은 뒤 무적 시간
	KnockbackH = 28,
	KnockbackV = 20,
	CritMultiplier = 1.5,
	RegenInterval = 2.5,
	RegenDelay = 4,
	KillCredit = 10, -- 이 시간 안에 때린 사람이 처치 기록을 가져감
	FallSafeBlocks = 3.5,
}

Config.Teams = {
	{ id = "red", name = "빨강", letter = "R", color = Color3.fromRGB(235, 64, 52), hex = "#FF5555" },
	{ id = "blue", name = "파랑", letter = "B", color = Color3.fromRGB(52, 101, 235), hex = "#5577FF" },
	{ id = "green", name = "초록", letter = "G", color = Color3.fromRGB(70, 200, 60), hex = "#55FF55" },
	{ id = "yellow", name = "노랑", letter = "Y", color = Color3.fromRGB(245, 210, 50), hex = "#FFFF55" },
}

Config.Modes = {
	bedwars = {
		id = "bedwars",
		name = "베드워즈",
		icon = "bed",
		color = Color3.fromRGB(235, 64, 52),
		description = "침대를 지키고 상대 침대를 부수세요. 침대가 남아 있으면 다시 살아납니다.",
		minPlayers = 2,
		maxPlayers = 8,
		teamCount = 4,
		teamSize = 2,
	},
	skywars = {
		id = "skywars",
		name = "스카이워즈",
		icon = "sword",
		color = Color3.fromRGB(90, 200, 255),
		description = "하늘섬의 상자에서 장비를 모아 마지막까지 살아남으세요.",
		minPlayers = 2,
		maxPlayers = 8,
	},
	tntrun = {
		id = "tntrun",
		name = "TNT 런",
		icon = "tnt",
		color = Color3.fromRGB(250, 170, 40),
		description = "밟은 블록은 곧 사라집니다. 멈추지 말고 끝까지 버티세요.",
		minPlayers = 2,
		maxPlayers = 12,
	},
}
Config.ModeOrder = { "bedwars", "skywars", "tntrun" }

Config.Waiting = {
	Countdown = 30, -- 최소 인원이 모이면 시작하는 카운트다운
	FullCountdown = 10, -- 꽉 차면 이 값으로 줄어듦
	VoteLock = 4, -- 남은 시간이 이보다 작아지면 투표 마감
	EndDelay = 8, -- 경기가 끝나고 로비로 돌아가기까지
}

-- 스튜디오에서 혼자 테스트할 수 있도록 최소 인원을 1명으로 낮춥니다.
