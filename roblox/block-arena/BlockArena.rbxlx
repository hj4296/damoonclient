      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Icons</string>
          <string name="Source"><![CDATA[-- 직접 그린 10x10 픽셀 아이콘.
-- 글자 뜻: . 투명, K 테두리, M 아이템 색, L 밝은 색, D 어두운 색, W 흰색, B 나무 손잡이, H 짙은 손잡이,
--         R 빨강, G 초록, Y 노랑, S 회색, O 주황
local Icons = {}

Icons.Size = 10

Icons.Fixed = {
	K = Color3.fromRGB(28, 28, 32),
	W = Color3.fromRGB(250, 250, 250),
	B = Color3.fromRGB(128, 88, 48),
	H = Color3.fromRGB(84, 56, 30),
	R = Color3.fromRGB(220, 48, 44),
	G = Color3.fromRGB(70, 170, 50),
	Y = Color3.fromRGB(250, 220, 70),
