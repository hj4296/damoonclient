		"....KBK.K.",
		"...KBK....",
		"..KBK.....",
		"KKBK......",
		"KWKK......",
		"KWWK......",
		".KK.......",
	},
	apple = {
		".....G....",
		"....GG....",
		"..KKKKKK..",
		".KMMMMWMK.",
		".KMMMMMWK.",
		".KMMMMMMK.",
		".KLMMMMMK.",
		".KDMMMMDK.",
		"..KDMMDK..",
		"...KKKK...",
	},
	pearl = {
		"..........",
		"...KKKK...",
		"..KLMMMK..",
		".KLWMMMDK.",
		".KMMMMMDK.",
		".KMMMMDDK.",
		".KMMDDDDK.",
		"..KDDDDK..",
		"...KKKK...",
		"..........",
	},
	fireball = {
		"...O..O...",
		"..O.OO.O..",
		"..KKKKKK..",
		".KYYOOOOK.",
		".KYOOROOK.",
		".KOORRROK.",
		".KOORROOK.",
		".KOOOOOOK.",
