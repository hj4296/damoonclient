function Icons.colorFor(char: string, base: Color3): Color3?
	if char == "." or char == " " then
		return nil
	elseif char == "M" then
		return base
	elseif char == "L" then
		return base:Lerp(Color3.new(1, 1, 1), 0.35)
	elseif char == "D" then
		return base:Lerp(Color3.new(0, 0, 0), 0.35)
	end
	return Icons.Fixed[char]
end

return Icons
